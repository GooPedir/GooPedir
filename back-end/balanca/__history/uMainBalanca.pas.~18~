function TfrmMainBalanca.FormatarValorParaBR(valor: Double): string;
begin
  Result := FormatFloat('#,##0.00', valor);
end;

procedure TfrmMainBalanca.FormCreate(Sender: TObject);
begin
  statusAPI := False;
  statusBalanca := False;
  CarregaParam;
end;

procedure TfrmMainBalanca.IniciarSimulacaoBalança;
begin
  Randomize;

  TimerBalança := TTimer.Create(nil);
  TimerBalança.Interval := 5000; // 15 segundos
  TimerBalança.OnTimer := AtualizarPeso;
  TimerBalança.Enabled := True;

  // Chamar uma vez inicialmente
  AtualizarPeso(nil);
end;

function TfrmMainBalanca.MontarJsonBalanca(codigo: Integer;
  modelo, descricao, protocolo, porta, tara: string): string;
var
  BodyJson, CampoItem: TJSONObject;
  CamposArray: TJSONArray;
  TaraFloat: Double;
begin
  // Converte a tara para Double, tratando máscaras
  tara := StringReplace(tara, '.', '', [rfReplaceAll]);
  tara := StringReplace(tara, ',', '.', [rfReplaceAll]);
  TaraFloat := StrToFloatDef(tara, 0);

  BodyJson := TJSONObject.Create;
  CamposArray := TJSONArray.Create;
  try
    // Campos principais
    BodyJson.AddPair('tabela', 'balanca');
    BodyJson.AddPair('campo', 'id');
    BodyJson.AddPair('valor', TJSONNumber.Create(codigo));

    // Adiciona os campos
    CampoItem := TJSONObject.Create;
    CampoItem.AddPair('campo', 'modelo');
    CampoItem.AddPair('valor', modelo);
    CamposArray.Add(CampoItem);

    CampoItem := TJSONObject.Create;
    CampoItem.AddPair('campo', 'descricao');
    CampoItem.AddPair('valor', descricao);
    CamposArray.Add(CampoItem);

    CampoItem := TJSONObject.Create;
    CampoItem.AddPair('campo', 'protocolo');
    CampoItem.AddPair('valor', protocolo);
    CamposArray.Add(CampoItem);

    CampoItem := TJSONObject.Create;
    CampoItem.AddPair('campo', 'porta');
    CampoItem.AddPair('valor', porta);
    CamposArray.Add(CampoItem);

    CampoItem := TJSONObject.Create;
    CampoItem.AddPair('campo', 'tara');
    CampoItem.AddPair('valor', TJSONNumber.Create(TaraFloat));
    CamposArray.Add(CampoItem);

    // Junta no objeto principal
    BodyJson.AddPair('campos', CamposArray);

    // Retorna o JSON formatado
    Result := BodyJson.ToJSON;
  finally
    BodyJson.Free;
    // Libera (campos internos também são liberados automaticamente)
  end;
end;

procedure TfrmMainBalanca.SetBaseUrl(const Value: String);
begin
  FBaseUrl := Value;
  edtUrl.Text := Value;
  request.BaseUrl := Value;
  iAtualiza.BaseUrl := Value;
  BuscaDadosAPI;
end;

procedure TfrmMainBalanca.SetDescricao(const Value: String);
begin
  FDescricao := Value;
  edtDescricao.Text := Value;
end;

procedure TfrmMainBalanca.SetID(const Value: Integer);
begin
  FID := Value;
  BuscaDadosAPI;
end;

procedure TfrmMainBalanca.SetModelo(const Value: String);
begin
  FModelo := Value;
end;

procedure TfrmMainBalanca.SetPeso(const Value: Real);
begin
  FPeso := Value;
  edtPeso.Text := FormatarValorParaBR(Value);
end;

procedure TfrmMainBalanca.SetPorta(const Value: String);
begin
  FPorta := Value;
  edtPortaCom.Text := Value;
end;

procedure TfrmMainBalanca.SetProtocolo(const Value: String);

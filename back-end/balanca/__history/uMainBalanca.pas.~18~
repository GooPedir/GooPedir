  frmMainBalanca: TfrmMainBalanca;
  TimerBalança: TTimer;
  PesoAtualSimulado: Double;
  Ini: TIniFile;

implementation

{$R *.dfm}

procedure TfrmMainBalanca.ACBrBAL1LePeso(Peso: Double; Resposta: AnsiString);
begin
  edtPeso.Text := Peso.ToString;
  PesoApi := Peso;
end;

procedure TfrmMainBalanca.AtualizarPeso(Sender: TObject);
begin
  PesoAtualSimulado := Random(1000) / 1000;
  if cSimula.Checked then
    PesoApi := PesoAtualSimulado;
end;

procedure TfrmMainBalanca.btnSalvarClick(Sender: TObject);
var
  JSON: String;
begin
  JSON := MontarJsonBalanca(ID, modelo, descricao, protocolo, porta,
    FloatToStr(tara));

  iAtualiza.URL := 'v2/cadastro/geral';
  iAtualiza.Metodo := mPost;
  iAtualiza.BODY(JSON);

  try
    iAtualiza.Execute;
    // showmessage('Balança alterada com sucesso!');
  except
    on e: Exception do
    begin
      // showmessage('erro: ' + e.Message);
    end;

  end;

end;

procedure TfrmMainBalanca.BuscaDadosAPI;
begin
  request.URL := '/v1/consulta/generica/balanca/*/id=' + ID.ToString + '/*';
  request.MemTable2 := DADOS;
  try
    request.Execute;
    statusAPI := True;
    if DADOS.RecordCount > 0 then
    begin
      descricao := DADOS.FieldByName('descricao').AsString;
      modelo := DADOS.FieldByName('modelo').AsString;
      porta := DADOS.FieldByName('porta').AsString;
      tara := DADOS.FieldByName('tara').AsFloat;
      protocolo := DADOS.FieldByName('protocolo').AsString;
      // Salvar no ini

      // ReadString('balanca', 'baseurl', '');
      IniciarSimulacaoBalança;
      ConfigurarBAL;
    end
    else
    begin
      mLogEnvio.Lines.Add('Erro: Nenhuma balança localizada com o ID ' +
        ID.ToString);
    end;
    Ini.WriteString('balanca', 'baseurl', BaseUrl);
    tEnviaPeso.Enabled := True;
  except
    on e: Exception do
    begin
      mLogEnvio.Lines.Add('Erro: ' + e.Message);
      statusAPI := False;
    end;

  end;
end;

procedure TfrmMainBalanca.CarregaParam;
var

  Arquivo: string;
begin
  Arquivo := ExtractFilePath(ParamStr(0)) + 'balanca.ini';
  // Caminho do .ini no mesmo local do .exe

  if not FileExists(Arquivo) then
    raise Exception.Create('Arquivo balanca.ini não encontrado!');

  Ini := TIniFile.Create(Arquivo);
  try

    BaseUrl := Ini.ReadString('balanca', 'baseurl', '');
    porta := Ini.ReadString('balanca', 'porta', '');
    protocolo := Ini.ReadString('balanca', 'protocolo', '');
    ID := Ini.ReadInteger('balanca', 'id', 0);
  finally

  end;
end;

procedure TfrmMainBalanca.ConfiguraPrixFit3;
begin
    ACBrBAL1.Modelo := balToledo;
    ACBrBAL1.Device.Baud := 9600;
    ACBrBAL1.Ativar;
    ACBrBAL1.Desativar;
    ACBrBAL1.Device.Baud := 4800;
    ACBrBAL1.Ativar;
end;

procedure TfrmMainBalanca.ConfigurarBAL;
begin
  ACBrBAL1.Desativar;
  try
    ACBrBAL1.porta := edtPortaCom.Text;
    if (modelo='prix-3-fit') then
    ConfiguraPrixFit3;

    if (modelo='urano-us-31-2-pop-5') then
    ConfiguraUranoPop;

    ACBrBAL1.MonitorarBalanca := True;
    mLogEnvio.Lines.Add('Conexão OK!');
    statusBalanca := True;
  except
    on e: Exception do
    begin
      mLogEnvio.Lines.Add('Erro ao conectar: ' + e.Message);
      statusBalanca := False;
    end;
  end;
end;

procedure TfrmMainBalanca.ConfiguraUranoPop;
begin
    ACBrBAL1.Modelo := balUranoPOP;
    ACBrBAL1.Device.Baud := 9600;
    ACBrBAL1.Ativar;
end;

function TfrmMainBalanca.ConverterValorParaDouble(valorStr: string): Double;
var
  CleanStr: string;
begin
  // Remove o ponto de milhar e troca a vírgula por ponto
  CleanStr := StringReplace(valorStr, '.', '', [rfReplaceAll]);
  // CleanStr := StringReplace(CleanStr, ',', '.', [rfReplaceAll]);

  Result := StrToFloat(CleanStr);
end;

procedure TfrmMainBalanca.cSimulaClick(Sender: TObject);
begin
  AtualizarPeso(nil);
end;


unit Controller;

interface

uses
  System.JSON, System.Classes, ProcessarPedido, Consulta, URL,
  System.Generics.Collections, EnviarPedidoServidor, Vcl.Forms, Vcl.StdCtrls,Windows;

type
  TBuscarPedidos = class(TThread)
  private
    FtimeInterval: Integer;
    FClientId: String;
    FClientSecurity: String;
    FToken: String;
    PedidoIDList: TList<Integer>;
    FBuscarPedidos: Boolean;
    FForm: TForm;
    FLabelConexaoGoopedir: TLabel;
    FLabelConexaoInternet: TLabel;
    procedure SettimeInterval(const Value: Integer);
    procedure SetClientId(const Value: String);
    procedure SetClientSecurity(const Value: String);
    procedure SetToken(const Value: String);
    procedure SetBuscarPedidos(const Value: Boolean);
    procedure SetForm(const Value: TForm);
    procedure SetLabelConexaoGoopedir(const Value: TLabel);
    procedure SetLabelConexaoInternet(const Value: TLabel);

    { Private declarations }
  protected
    procedure Execute; override;
  public
    constructor Create(CreateSuspended: Boolean);
    property timeInterval: Integer read FtimeInterval write SettimeInterval;
    property ClientId: String read FClientId write SetClientId;
    property ClientSecurity: String read FClientSecurity
      write SetClientSecurity;
    property Token: String read FToken write SetToken;
    property BuscarPedidos: Boolean read FBuscarPedidos write SetBuscarPedidos;
    property Form: TForm read FForm write SetForm;
    property LabelConexaoGoopedir: TLabel read FLabelConexaoGoopedir
      write SetLabelConexaoGoopedir;
    property LabelConexaoInternet :TLabel read FLabelConexaoInternet write SetLabelConexaoInternet;
    procedure ExecuteThread;
  end;

  TController = class
  private
    BuscarPedidos: TBuscarPedidos;
    FClientId: String;
    FToken: String;
    FClienteSecurity: String;
    FUserId: Integer;
    FEmpresa: String;
    FTokenNotFound: Boolean;
    FMensagemErro: String;
    FForm: TForm;
    FLabelConexaoGoopedir: TLabel;
    FLabelConexaoAPI: TLabel;

    procedure SetClientId(const Value: String);
    procedure SetClienteSecurity(const Value: String);
    procedure SetToken(const Value: String);

    function GerarToken: String;
    procedure SetEmpresa(const Value: String);
    procedure SetUserId(const Value: Integer);
    procedure SetTokenNotFound(const Value: Boolean);
    procedure SetMensagemErro(const Value: String);
    procedure SetForm(const Value: TForm);
    procedure SetLabelConexaoAPI(const Value: TLabel);
    procedure SetLabelConexaoGoopedir(const Value: TLabel);


  public
    constructor Create; // Adicionando o método Create
    destructor Destroy; override; // Adicionando o destrutor

    property ClientId: String read FClientId write SetClientId;
    property ClienteSecurity: String read FClienteSecurity
      write SetClienteSecurity;
    property Token: String read FToken write SetToken;

    property UserId: Integer read FUserId write SetUserId;
    property Empresa: String read FEmpresa write SetEmpresa;
    property TokenNotFound: Boolean read FTokenNotFound write SetTokenNotFound;
    property MensagemErro: String read FMensagemErro write SetMensagemErro;
    property Form: TForm read FForm write SetForm;
    property LabelConexaoGoopedir: TLabel read FLabelConexaoGoopedir
      write SetLabelConexaoGoopedir;
    property LabelConexaoAPI: TLabel read FLabelConexaoAPI
      write SetLabelConexaoAPI;

    procedure Iniciar;

  end;

procedure AlteraStatusLabel(AlterarLabel:TLabel;Status :Boolean);

implementation

uses
  System.IniFiles, uRequisicao, System.SysUtils, Vcl.Dialogs, Vcl.Graphics;

{ TController }

constructor TController.Create;
var
  IniFile: TIniFile;
begin
  IniFile := TIniFile.Create('./goopedir.ini');
  ClientId := IniFile.ReadString('site', 'clientId', '');
  ClienteSecurity := IniFile.ReadString('site', 'clientSecurity', '');
  Token := IniFile.ReadString('site', 'token', '');
  IniFile.Free;

end;

destructor TController.Destroy;
begin
  if (Assigned(BuscarPedidos)) then
  begin
    FreeAndNil(BuscarPedidos);
  end;

  inherited;
end;

function TController.GerarToken: String;
var
  Req: iRequisicao;
  JsonObject: TjsonObject;
begin
  Req := iRequisicao.Create(nil);
  Req.BaseURL := UrlGoopedir;
  Req.URL := 'api/goopedir/token';
  Req.TempoExpiracao := 5 * 1000;
  Req.AddHEader('client-id', ClientId);
  Req.AddHEader('client-security', ClienteSecurity);
  Req.Token(Token);
  Req.Metodo := mPost;

  try
    Req.Execute;
    JsonObject := JsonObject.ParseJSONValue(Req.Retorno) as TjsonObject;

    UserId := JsonObject.GetValue('user').ToJSON.ToInteger;
    Empresa := StringReplace(JsonObject.GetValue('name').ToString, '"', '',
      [rfReplaceAll]);
    Token := StringReplace(JsonObject.GetValue('token').ToString, '"', '',
      [rfReplaceAll]);
    TokenNotFound := False;
    Result := Req.Retorno;
    AlteraStatusLabel(LabelConexaoGoopedir,true);
  except
    on E: Exception do
    begin
      if Req.Status = 0 then
      begin
        MensagemErro := 'Sem conexão com a API!';

        AlteraStatusLabel(LabelConexaoGoopedir,false);
      end;
      Result := '[]';
      TokenNotFound := True;
      exit;
    end;
  end;

  Req.Free;

end;

procedure TController.Iniciar;
begin
  if Token = '' then
  begin
    GerarToken;
  end;
end;



procedure TController.SetClienteSecurity(const Value: String);
begin
  FClienteSecurity := Value;
end;

procedure TController.SetClientId(const Value: String);
begin
  FClientId := Value;
end;

procedure TController.SetEmpresa(const Value: String);
begin
  FEmpresa := Value;
end;

procedure TController.SetForm(const Value: TForm);
begin
  FForm := Value;
end;

procedure TController.SetLabelConexaoAPI(const Value: TLabel);
begin
  FLabelConexaoAPI := Value;
end;

procedure TController.SetLabelConexaoGoopedir(const Value: TLabel);
begin
  FLabelConexaoGoopedir := Value;
end;

procedure TController.SetMensagemErro(const Value: String);
begin
  FMensagemErro := Value;
end;

procedure TController.SetToken(const Value: String);
begin
  FToken := Value;
end;

procedure TController.SetTokenNotFound(const Value: Boolean);
begin
  FTokenNotFound := Value;
end;

procedure TController.SetUserId(const Value: Integer);
begin
  FUserId := Value;
end;

{ TBuscarPedidos }

constructor TBuscarPedidos.Create(CreateSuspended: Boolean);
begin
  inherited Create(False);
  timeInterval := 15 * 1000; // 15s
  PedidoIDList := TList<Integer>.Create;
  BuscarPedidos := False;
end;

procedure TBuscarPedidos.Execute;
var
  Importando: Boolean;
begin

  while not Terminated do
  begin

    if BuscarPedidos then
    begin
      if not Importando then
      begin
        Importando := True;

        if StatusAPI then
        begin
          ProcessarPedidos(ExecutaConsulta('api/goopedir/pedidos', ClientId,ClientSecurity, Token), Token, PedidoIDList, Form);
          AlteraStatusLabel(LabelConexaoGoopedir,true);
        end
        else
        begin
          Form.Caption := 'Sem conexão com a API local!';
          AlteraStatusLabel(LabelConexaoGoopedir,false);

        end;

        Importando := False;
      end;
    end;

    Sleep(timeInterval);
  end;

end;

procedure TBuscarPedidos.ExecuteThread;
begin
  BuscarPedidos := True;
end;

procedure TBuscarPedidos.SetBuscarPedidos(const Value: Boolean);
begin
  FBuscarPedidos := Value;
end;

procedure TBuscarPedidos.SetClientId(const Value: String);
begin
  FClientId := Value;
end;

procedure TBuscarPedidos.SetClientSecurity(const Value: String);
begin
  FClientSecurity := Value;
end;

procedure TBuscarPedidos.SetForm(const Value: TForm);
begin
  FForm := Value;
end;

procedure TBuscarPedidos.SetLabelConexaoGoopedir(const Value: TLabel);
begin
  FLabelConexaoGoopedir := Value;
end;

procedure TBuscarPedidos.SetLabelConexaoInternet(const Value: TLabel);
begin
  FLabelConexaoInternet := Value;
end;

procedure TBuscarPedidos.SettimeInterval(const Value: Integer);
begin
  FtimeInterval := Value;
end;

procedure TBuscarPedidos.SetToken(const Value: String);
begin
  FToken := Value;
end;

procedure AlteraStatusLabel(AlterarLabel:TLabel;Status :Boolean);
begin

if Status then
begin
  AlterarLabel.Caption := 'On';
  AlterarLabel.Font.Color := clGreen;

end else begin
  AlterarLabel.Caption := 'Off';
  AlterarLabel.Font.Color := clRed;
end;

end;

end.

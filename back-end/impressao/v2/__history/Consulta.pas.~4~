unit Consulta;

interface

uses
  uRequisicao, System.SysUtils;



implementation

function Consulta(URL, ClientID, ClienteSecurity, Token: String): String;
var
  Req: iRequisicao;
begin
  Req := iRequisicao.Create(nil);
  Req.BaseURL := 'http://localhost:3000/';
  Req.URL := URL;
  Req.TempoExpiracao := 30 * 1000;
  Req.AddHEader('client-id', ClientID);
  Req.AddHEader('client-security', ClienteSecurity);
  Req.Token(Token);

  try
    Req.Execute;
    Result := Req.Retorno;
    // ShowMessage(Result)
  except
    on E: Exception do
    begin
      Result := '[]';
      // ShowMessage(e.Message)
    end;
  end;

  Req.Free;

end;

end.

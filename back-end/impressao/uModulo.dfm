  object qryMesas: TFDQuery
    Connection = BANCO
    SQL.Strings = (
      'select *, concat('
      '(select lower(url_site) from dados_whatsapp limit 1)'
      
        ',TO_BASE64(TO_BASE64(TO_BASE64(concat('#39'goopedir|'#39',mesa_tipo.desc' +
        'ricao, '#39'|'#39', mesa.nr_mesa))))) as link from mesa'
      'join mesa_tipo on mesa_tipo.id_mesa_tipo = mesa.fk_tipo_mesa'
      '')
    Left = 552
    Top = 387
  end

procedure TfrmMain.FormCreate(Sender: TObject);
var
  Thread: TImpressaoPedidos;
  // TCozinha : TImprimirCozinha;
  IniFile: TIniFile;
  myThread: TThread;
  Param: string;
  Cozinha: boolean;
  Comanda: boolean;
  Outros: boolean;
  Descricao: String;
  Resultado: boolean;
begin

  IniFile := TIniFile.Create('./goopedir.ini');
  UrlServidor := IniFile.ReadString('server', 'baseurl',
    'http://localhost:2121/');
  Tipo := IniFile.ReadString('impressao', 'tipo', '0');
  IniFile.WriteString('impressao', 'tipo', Tipo);
  TempoRestartServer := IniFile.ReadInteger('impressao', 'tempo', 5);
  AtivarLog := IniFile.ReadBool('impressao', 'log', false);
  IniFile.WriteInteger('impressao', 'tempo', TempoRestartServer);
  IniFile.WriteBool('impressao', 'log', AtivarLog);
  IniFile.Free;

  DataHora := Now;
  Prioridade := priNull;
  TrayIcon1.Hint := TimeToStr(Now);

  // ShowMessage(ParamCount.ToString);

  if ParamCount > 0 then
  begin
    // Pega o primeiro parâmetro (índice 1)
    Param := ParamStr(1);
    // Exibe o parâmetro no Label
    // Label1.Caption := 'Parâmetro passado: ' + Param;

    if Param = '1' then
    begin
      Descricao := 'Cozinha';
      Cozinha := True;
    end;

    if Param = '2' then
    begin
      Descricao := 'Comanda';
      Comanda := True;
    end;

    if Param = '3' then
    begin
      Descricao := 'Outros';
      Outros := True;
    end;

    TipoImpressao := Param;

    TrayIcon1.Hint := Descricao + ' - ' + TimeToStr(Now);

  end
  else
  begin
    // Label1.Caption := 'Nenhum parâmetro passado.';
    Impressoras;
    Descricao := 'Geral';
    if Tipo = '0' then
    begin
      Cozinha := True;
      Comanda := True;
      Outros := True;
    end
    else
    begin
      // Verificar se ja tem aberto
      Resultado := VerificaExe(Application.ExeName);
      if (Resultado) then
      begin

        TrayIcon1.Visible := false;
        ShellExecute(0, 'open', PChar('ImpressaoGooPedir.exe'), PChar('1'), nil,
          SW_SHOWNORMAL);
        ShellExecute(0, 'open', PChar('ImpressaoGooPedir.exe'), PChar('2'), nil,
          SW_SHOWNORMAL);
        ShellExecute(0, 'open', PChar('ImpressaoGooPedir.exe'), PChar('3'), nil,
          SW_SHOWNORMAL);
      end;
      tCloseO.Enabled := True;
      exit;
    end;

  end;

  myThread := TThread.CreateAnonymousThread(
    procedure
    var
      Retorno: String;
      Terminate: boolean;

      ThreadComanda: TImpressaoPedidos;
      ThreadCozinha: TImpressaoPedidos;
      ThreadOutros: TImpressaoPedidos;

      qtdComanda: Integer;
      qtdCozinha: Integer;
      qtdOutros: Integer;

    begin
      while not Terminate do
      begin
        Retorno := dmImpressaoV2.Consulta('v1/versao/app');

        if (Retorno = '[]') then
        begin
          frmMain.Caption := ' Impressão GooPedir - Ofline (' + Descricao + ')';
          if (Assigned(ThreadComanda)) then
          begin

            try
              FreeAndNil(ThreadComanda);
            except

            end;
          end;

          if (Assigned(ThreadCozinha)) then
          begin
            try
              FreeAndNil(ThreadCozinha);
            except

            end;

          end;

          if (Assigned(ThreadOutros)) then
          begin
            try
              FreeAndNil(ThreadOutros);
            except

            end;

          end;

        end
        else
        begin
          frmMain.Caption := ' Impressão GooPedir - Online (' + Descricao + ')';

          if Comanda then
          begin
            if (not Assigned(ThreadComanda)) then
            begin
              ThreadComanda := TImpressaoPedidos.Create;
              ThreadComanda.Tipo := tComanda;
              ThreadComanda.Start;
            end
            else
            begin
              if qtdComanda = ThreadComanda.Totalizador then
              begin
                qtdComanda := 0;
                try
                  FreeAndNil(ThreadCozinha);
                except

                end;
              end
              else
              begin
                qtdComanda := ThreadComanda.Totalizador;
              end;

            end;
          end;

          if Cozinha then
          begin

            if (not Assigned(ThreadCozinha)) then
            begin
              ThreadCozinha := TImpressaoPedidos.Create;
              ThreadCozinha.Tipo := tCozinha;
              ThreadCozinha.Start;
            end
            else
            begin
              if qtdCozinha = ThreadCozinha.Totalizador then
              begin
                qtdCozinha := 0;
                try
                  FreeAndNil(ThreadCozinha);
                except

                end;
              end
              else
              begin
                qtdCozinha := ThreadCozinha.Totalizador;
              end;

            end;
          end;

          if Outros then
          begin

            if (not Assigned(ThreadOutros)) then
            begin
              ThreadOutros := TImpressaoPedidos.Create;
              ThreadOutros.Tipo := tOutro;
              ThreadOutros.Start;
            end
            else
            begin
              if qtdOutros = ThreadOutros.Totalizador then
              begin
                qtdOutros := 0;
                try
                  FreeAndNil(ThreadOutros);
                except

                end;
              end
              else
              begin
                qtdOutros := ThreadOutros.Totalizador;
              end;

            end;

          end;
        end;
        sleep(5 * 1000);
      end;

    end);

  myThread.Start();

  Codigo := 0;

end;


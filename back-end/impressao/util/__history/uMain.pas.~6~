unit uMain;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,
  System.ImageList, Vcl.ImgList, Vcl.AppEvnts, ppReport;

type
  TStatusApp = (sVisivel, sOcuto);

  TfrmMain = class(TForm)
    memLog: TMemo;
    ImageList1: TImageList;
    TrayIcon1: TTrayIcon;
    tMinimiza: TTimer;
    procedure FormCreate(Sender: TObject);
    procedure tMinimizaTimer(Sender: TObject);
    procedure TrayIcon1Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    procedure AddImpressao(Tipo:String;Relatorio: TppReport;Codigo,Status:Integer;Descricao,Observacao:String);
  end;

var
  frmMain: TfrmMain;
  StatusForm: TStatusApp;
  Codigo : Integer;

implementation

{$R *.dfm}

uses uModuloImpressao;

procedure TfrmMain.AddImpressao(Tipo: String; Relatorio: TppReport; Codigo,
  Status: Integer; Descricao,Observacao: String);
begin
dmImpressaoV2.IMPRESSAO.Insert;
dmImpressaoV2.IMPRESSAO.FieldByName('TIPO').AsInteger := TIPO;
dmImpressaoV2.IMPRESSAO.FieldByName('RELATORIO').AsString := Relatorio.Name;
dmImpressaoV2.IMPRESSAO.FieldByName('STATUS').AsInteger := Status;
dmImpressaoV2.IMPRESSAO.FieldByName('DESCRICAO').AsString := Descricao;
dmImpressaoV2.IMPRESSAO.FieldByName('OBSERVACAO').AsString := Observacao;
dmImpressaoV2.IMPRESSAO.FieldByName('CODIGO').AsInteger := Codigo;
dmImpressaoV2.IMPRESSAO.Post;
end;

procedure TfrmMain.FormCreate(Sender: TObject);
var
  Thread: TImpressaoPedidos;
begin
  memLog.Lines.Clear;
  Thread := TImpressaoPedidos.Create;
  Thread.Start;
  Codigo := 0;
end;

procedure TfrmMain.tMinimizaTimer(Sender: TObject);
begin
  tMinimiza.Enabled := False;
  Self.Hide();
  Self.WindowState := wsMinimized;
  StatusForm := sOcuto;
end;

procedure TfrmMain.TrayIcon1Click(Sender: TObject);
begin
  case StatusForm of
    sVisivel:
      begin
        StatusForm := sOcuto;
        Self.WindowState := wsMinimized;
        Self.Hide();
      end
  else
    begin
      StatusForm := sVisivel;
      Self.WindowState := wsMaximized;
      Self.Show();
    end;
  end;
end;

end.

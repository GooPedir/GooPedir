    // infIntermed.CNPJ := '';
    // infIntermed.idCadIntTran := '';

    InfAdic.infCpl := '';
    InfAdic.infAdFisco := '';

    // with InfAdic.obsCont.New do
    // begin
    // xCampo := 'ObsCont';
    // xTexto := 'Texto';
    // end;
    //

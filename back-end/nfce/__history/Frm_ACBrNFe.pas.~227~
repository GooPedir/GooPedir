        VlrTotalNF := VlrTotalNF + (Prod.vProd - Prod.vDesc + Prod.vOutro);
        VlrTotalDesconto := VlrTotalDesconto + Prod.vDesc;
        VlrTotalOutros := VlrTotalOutros + Prod.vOutro;


procedure TfrmACBrNFe.AlimentarNFCe(NumDFe: String);
var
  Ok: Boolean;
  BaseCalculo, ValorICMS: Double;
  Requisicao, iReq: iRequisicao;
  MemoryPagamento: TFDMemTable;
  Memory: TFDMemTable;
  MemoryOutros: TFDMemTable;
  MemoryConfiguracao: TFDMemTable;
  SeqProduto: Integer;
  ValorTotal: Real;
  TotalPagamento: Real;
  NumeroNota: Integer;
  Serie: Integer;

  mID_CST_PIS: Integer;
  mID_CST_COFINS: Integer;
  mIDSTOrigem: Integer;
  mID_ST_ICMS: Integer;
  mID_OrigemPro: Integer;
  mID_CSOSN_ICMS: Integer;
  mInd_Escala: Integer;
  mCodANP: String;
  mIDTransp: Integer;
  mQTDE: Real;
  mValorUnit: Real;
  mVlrTotal: Real;
  nSequencia: Integer;
  ConverteOk: Boolean;
  mVrLParcelas: Double;

  VlrProdutos, VlrTotalDesconto, VlrTotalOutros, VlrTotalNF, VlrBaseICMS,
    VlrICMS, VlrPis, VlrCofins: Double;
  vlrTribFederal, vlrTribEstadual, VlrTotalPago: Double;
  vlrTTTotTrib, vlrTTTribFederal, vlrTTTribEstadual, vTotTrib: Double;

  LOKResp: Boolean;

  TaxaEntrega: Real;
  TaxaDesconto: Real;
  Ambiente: TpcnTipoAmbiente;
  TotalPago: Real;
  ValorDiferenca1: Real;
  DiferencaCentavos: Real;
  TotalNota: Real;

begin
  MemoryPagamento := TFDMemTable.Create(nil);
  Memory := TFDMemTable.Create(nil);
  MemoryOutros := TFDMemTable.Create(nil);
  MemoryConfiguracao := TFDMemTable.Create(nil);

  Requisicao := iRequisicao.Create(self);
  Requisicao.TempoExpiracao := 30 * 1000;
  Requisicao.BaseUrl := BaseUrl;

  Requisicao.URL := '/v1/consulta/generica/dados_whatsapp/*/*/*';
  Requisicao.MemTable2 := MemoryConfiguracao;
  Requisicao.Metodo := mGet;
  Requisicao.Execute;

  Requisicao.URL := 'nfce/pedido/pagamento/' + NumDFe;
  Requisicao.MemTable2 := MemoryPagamento;
  Requisicao.Metodo := mGet;
  Requisicao.Execute;

  Requisicao.URL := 'nfce/pedido/produtos/' + NumDFe;
  Requisicao.MemTable2 := Memory;
  Requisicao.Metodo := mGet;
  Requisicao.Execute;

  Requisicao.URL := 'nfce/pedido/outras/' + NumDFe;
  Requisicao.MemTable2 := MemoryOutros;
  Requisicao.Metodo := mGet;
  Requisicao.Execute;
  TaxaDesconto := 0;
  VlrProdutos := 0;
  if Memory.RecordCount > 0 then
  begin
    while not Memory.Eof do
    begin

      VlrProdutos := VlrProdutos + (Memory.FieldByName('value').AsFloat *
        Memory.FieldByName('quanty').AsFloat);
      Memory.Next;
    end;
  end
  else
  begin
    // Não emitir
    iReq := iRequisicao.Create(nil);
    iReq.BaseUrl := BaseUrl;
    iReq.URL := 'nfce/emissao/' + NumDFe + '/' + IntToStr(0) + '/' +
      'SEM PRODUTO' + '/' + 'SEM PRODUTO' + '/' + '0';
    iReq.Metodo := mPost;
    iReq.Execute;
    iReq.Free;
    exit;

  end;
  TotalPago := 0;
  while not MemoryPagamento.Eof do
  begin
    TotalPago := TotalPago + RoundTo(MemoryPagamento.FieldByName('valor')
      .AsFloat, -2);
    MemoryPagamento.Next;
  end;

  MemoryPagamento.First;
  Memory.First;

  if MemoryOutros.RecordCount > 0 then
  begin
    if MemoryOutros.FieldByName('discont').AsFloat > 0 then
    begin
      TaxaDesconto := (MemoryOutros.FieldByName('discont').AsFloat);
    end;
    if MemoryOutros.FieldByName('entrega').AsFloat > 0 then
    begin
      TaxaEntrega := (MemoryOutros.FieldByName('entrega').AsFloat);
    end;
    if MemoryOutros.FieldByName('servico').AsFloat > 0 then
    begin
      TaxaEntrega := (TaxaEntrega + MemoryOutros.FieldByName('servico')
        .AsFloat);
    end;
    // ValorDiferenca1 := TaxaEntrega; // Valor inicial
    // TaxaEntrega := RoundTo(TaxaEntrega / Memory.RecordCount, -6); // Distribuir proporcionalmente
    //
    /// / Corrigir a diferença acumulada
    // ValorDiferenca1 := (TaxaEntrega * Memory.RecordCount);
    // ValorDiferenca1 := RoundTo(ValorDiferenca1, -2) - RoundTo(TaxaEntrega * Memory.RecordCount, -2);

  end;

  // Seus valores aqui devem ser convertidos ou atribuídos corretamente ao tipo Currency
  VlrProdutos := (VlrProdutos); // Arredonda para 2 casas decimais
  TotalPago := (TotalPago); // Arredonda para 2 casas decimais
  // if VlrProdutos > TotalPago then
  // begin
  // TaxaDesconto := VlrProdutos - TotalPago;
  // end;
  DiferencaCentavos := ((VlrProdutos + TaxaEntrega) - TaxaDesconto) - TotalPago;
  TotalNota := VlrProdutos + TaxaEntrega;

  MemoResp.Lines.Add('Produto: ' + FloatToStr((VlrProdutos + TaxaEntrega) -
    TaxaDesconto) + ' Pago: ' + FloatToStr(TotalPago) + ' Diferença: ' +
    FloatToStr(DiferencaCentavos));

  VlrProdutos := 0;

  ACBrNFe1.Configuracoes.Certificados.NumeroSerie :=
    MemoryConfiguracao.FieldByName('certificado').AsString;
  ACBrNFe1.Configuracoes.Geral.IdCSC := MemoryConfiguracao.FieldByName
    ('id_token_scs').AsString;
  ACBrNFe1.Configuracoes.Geral.CSC := MemoryConfiguracao.FieldByName
    ('token_scs').AsString;

  // IdCSC := edtIdToken.Text;
  // CSC := edtToken.Text;





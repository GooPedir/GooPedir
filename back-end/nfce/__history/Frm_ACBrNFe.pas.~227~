        // vlrTribFederal := RoundABNT(QryVendaItem.FieldByName('IN_VL_FEDERAL').AsCurrency, 2);
        // vlrTribEstadual := RoundABNT(QryVendaItem.FieldByName('IN_VL_ESTADUAL').AsCurrency, 2);


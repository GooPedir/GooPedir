              iReq := iRequisicao.Create(nil);
              iReq.BaseUrl := BaseUrl;
              iReq.URL := 'nfce/emissao/' + dadosEmissao.FieldByName('codigo')
                .AsString + '/' +
                IntToStr(ACBrNFe1.NotasFiscais.Items[0].NFe.Ide.cNF) + '/' +
                Chave + '/' + Protocolo + '/' + Ambiente;
              iReq.Metodo := mPost;

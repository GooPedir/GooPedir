procedure TfrmACBrNFe.ProcessaNFCe(EMAIL, CNPJ, NOME, Data: String);
var
  Caminho: String;
  CaminhoSalvo: String;
  req: iRequisicao;
  Dados: TFDMemTable;

  ZipFile: TZipFile;
  FilePath: string;
begin
  MemoResp.Lines.Add('Processando Email');
  req := iRequisicao.Create(nil);

  req.BaseUrl := BaseUrl;
  Caminho := edtPathNFe.Text + '\' + CNPJ + '\NFCe\' + Data + '\';
  ForceDirectories(edtPathNFe.Text + '\Email\');
  CaminhoSalvo := edtPathNFe.Text + '\Email\(' + CNPJ + ') ' + Data + '.zip';

  if not DirectoryExists(Caminho) then
  begin
    MemoResp.Lines.Add('Diretorio Não Existe!');
    req.URL := 'nfce/contabilidade/2/Diretorio não existe';
    req.Metodo := mPost;
    req.Execute;
    req.Free;
    exit
  end;

  Dados := TFDMemTable.Create(nil);
  try

    req.URL := 'nfce/contabilidade/notas/' + Data;
    req.Metodo := mGet;
    req.MemTable2 := Dados;
    req.Execute;

  except
    on E: Exception do
    begin
      MemoResp.Lines.Add('Erro ao buscar as notas !');
      MemoResp.Lines.Add(E.Message);
      req.BaseUrl := BaseUrl;
      req.URL := 'nfce/contabilidade/2/Erro ao buscar as notas';
      req.Metodo := mPost;
      req.Execute;
      req.Free;
      exit
    end;

  end;

  ZipFile := TZipFile.Create;
  try
    ZipFile.Open(CaminhoSalvo, zmWrite);
    while not Dados.Eof do
    begin
      FilePath := Caminho + Dados.FieldByName('chave').AsString + '-nfe.xml';
      if FileExists(FilePath) then
        ZipFile.Add(FilePath, ExtractFileName(FilePath));

      Dados.Next;
    end;
  finally
    ZipFile.Close;
    ZipFile.Free;
  end;

  // ZipFolder(Caminho, CaminhoSalvo);

  ACBrMail1.From := 'contabilidade@goopedir.com';
  ACBrMail1.FromName := 'GooPedir Contabil';
  ACBrMail1.Host := 'smtp.hostinger.com'; // troque pelo seu servidor smtp
  ACBrMail1.Username := 'contabilidade@goopedir.com';
  ACBrMail1.Password := 'MinhaContabilidade@2023';
  ACBrMail1.Port := '465'; // troque pela porta do seu servidor smtp
  ACBrMail1.SetTLS := True;
  ACBrMail1.SetSSL := True; // Verifique se o seu servidor necessita SSL
  ACBrMail1.AddAddress('allan@goopedir.com', 'Allan');
  ACBrMail1.AddAddress('contabilidade@goopedir.com', 'Allan');
  ACBrMail1.AddAddress(EMAIL, 'Contabilidade');
  ACBrMail1.Subject := '(' + CNPJ + ') - ' + NOME + ' / ' + Data;
  ACBrMail1.AltBody.Text := 'Segue anexo XML das NFC-e emitidas no periodo ' +
    Data + #13 + #13 + '(' + CNPJ + ') - ' + NOME;

  ACBrMail1.AddAttachment(CaminhoSalvo, 'XML NFC-e', adAttachment);
  try
    ACBrMail1.Send;
  except
    on E: Exception do
    begin

      MemoResp.Lines.Add(E.Message);
      exit
    end;

  end;
  try
    MemoResp.Lines.Add(BaseUrl + '/nfce/contabilidade/1/Sucesso');
    req.BaseUrl := BaseUrl;
    req.TempoExpiracao := 60 * 1000;
    req.URL := '/nfce/contabilidade/1/Sucesso';
    req.Metodo := mPost;
    req.Execute;
    req.Free;

    MemoResp.Lines.Add('Email Enviado!');
  except
    on E: Exception do
    begin
      req.BaseUrl := 'nfce/contabilidade/2/' + E.Message;
      req.Metodo := mPost;
      req.Execute;
      req.Free;

      MemoResp.Lines.Add(E.Message);
    end;

  end;


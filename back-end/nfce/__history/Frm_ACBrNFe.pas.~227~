procedure TfrmACBrNFe.FormCreate(Sender: TObject);
var
  T: TSSLLib;
  i: TpcnTipoEmissao;
  J: TpcnModeloDF;
  K: TpcnVersaoDF;
  U: TSSLCryptLib;
  V: TSSLHttpLib;
  X: TSSLXmlSignLib;
  Y: TSSLType;
  N: TACBrPosPrinterModelo;
  O: TACBrPosPaginaCodigo;
  IniFile: TIniFile;
  URL: String;
begin

  IniFile := TIniFile.Create('./goopedir.ini');
  BaseUrl := IniFile.ReadString('server', 'baseurl', 'http://localhost:2121/');
  IniFile.Free;

  iEmissao.BaseUrl := BaseUrl;
  iCode.BaseUrl := BaseUrl;
  iContabilidade.BaseUrl := BaseUrl;

  cbSSLLib.Items.Clear;
  for T := Low(TSSLLib) to High(TSSLLib) do
    cbSSLLib.Items.Add(GetEnumName(TypeInfo(TSSLLib), Integer(T)));
  cbSSLLib.ItemIndex := 4;

  cbCryptLib.Items.Clear;

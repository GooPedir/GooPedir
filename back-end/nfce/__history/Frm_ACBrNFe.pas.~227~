        Prod.qCom := mQTDE;
        Prod.qTrib := mQTDE;
        Prod.vUnCom := mValorUnit;
        Prod.vUnTrib := mValorUnit;
        Prod.vProd := mVlrTotal;

        Prod.vOutro := RoundTo(((Prod.vProd) / TotalNota) * TaxaEntrega, -2);

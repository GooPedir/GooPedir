procedure TfrmPrincipal.BuscaAlteracaoSite;
var
  requisicao: TRequest;
  Insert: TInsertUpdate;
  SQL: String;
  codigo: Integer;
  Dados: TFDMemTable;

  categoria: String;
  produto: String;
  adicionais: String;
  extra: String;
  sabores: String;
  Body: String;

  X: ISuperObject;

  CadastraAlteraCategoria: TCadastraAlteraSite;
begin
  requisicao := TRequest.Create;
  requisicao.BASEURL := URL_V2;
  requisicao.URLI := 'registros/' + Usuario.ToString + '/a';

  Insert := TInsertUpdate.Create;
  Dados := TFDMemTable.Create(nil);

  SQL := 'SELECT group_concat(id_site) as id, 0 as zero FROM tipo_produto';
  Dados.LoadFromJSON(Insert.ConsultaSQL(SQL));
  categoria := Dados.FieldByName('id').AsString;
  Dados.Close;

  SQL := 'SELECT group_concat(id_site) as id, 0 as zero FROM produto';
  Dados.LoadFromJSON(Insert.ConsultaSQL(SQL));
  produto := Dados.FieldByName('id').AsString;
  Dados.Close;

  SQL := 'SELECT group_concat(id_site) as id, 0 as zero FROM pro_adi_personalizado';
  Dados.LoadFromJSON(Insert.ConsultaSQL(SQL));
  adicionais := Dados.FieldByName('id').AsString;
  Dados.Close;

  SQL := 'SELECT group_concat(id_site) as id, 0 as zero FROM pro_adi_personalizado_sabores';
  Dados.LoadFromJSON(Insert.ConsultaSQL(SQL));
  extra := Dados.FieldByName('id').AsString;
  Dados.Close;

  SQL := 'SELECT group_concat(id_site) as id, 0 as zero FROM sabores_completo';
  Dados.LoadFromJSON(Insert.ConsultaSQL(SQL));
  sabores := Dados.FieldByName('id').AsString;
  Dados.Close;

  Body := '{"user":' + Usuario.ToString + ',';
  Body := Body + '"taxa":"",';
  Body := Body + '"pagamento":"",';
  Body := Body + '"categoria":"' + categoria + '",';
  Body := Body + '"produto":"' + produto + '",';
  Body := Body + '"adicionais":"' + adicionais + '",';
  Body := Body + '"extra":"' + extra + '",';
  Body := Body + '"sabores":"' + sabores + '"}';
  requisicao.Body(Body);

  mLogBusca.Lines.Add(Body);
  mLogBusca.Lines.Add('');

  requisicao.Post;
  X := TSuperObject.Create(requisicao.Retorno);

  mLogBusca.Lines.Add(requisicao.Retorno);
  mLogBusca.Lines.Add('');

  CadastraAlteraCategoria := TCadastraAlteraSite.Create;
  CadastraAlteraCategoria.Tabela_Site := 'ws_cat';
  CadastraAlteraCategoria.Tabela_Local := 'tipo_produto';
  CadastraAlteraCategoria.Campo_Descricao_Local := 'descricao';
  CadastraAlteraCategoria.Campo_Descricao_Site := 'nomecat';

  CadastraAlteraCategoria.Usuario := Usuario.ToString;

  CadastraAlteraCategoria.Campo_ID_Site := 'id';
  CadastraAlteraCategoria.Campo_ID_Local := 'codigo';
  CadastraAlteraCategoria.Insert := Insert;
  CadastraAlteraCategoria.requisicao := requisicao;
  CadastraAlteraCategoria.codigo := X['categoria_alterado'].ToString;
  CadastraAlteraCategoria.codigos := X['categoria_codigos'].ToString;

  if length(CadastraAlteraCategoria.codigo) > 0 then
    CadastraAlteraCategoria.codigo := CadastraAlteraCategoria.codigo + ',' +
      X['categoria_nao_vinculada_codigos'].ToString
  else
    CadastraAlteraCategoria.codigo :=
      X['categoria_nao_vinculada_codigos'].ToString;

  CadastraAlteraCategoria.SelectConsultaPorCodigo := 'select * from ' +
    CadastraAlteraCategoria.Tabela_Local + ' where id_site in (' +
    CadastraAlteraCategoria.codigo + ')';
  CadastraAlteraCategoria.CampoAlteradoLocal(['codigo', 'descricao',
    'visivel_vem_buscar', 'visivel_delivery', 'id_site', 'modificado_site']);
  CadastraAlteraCategoria.CampoAlteradoSite(['codigo', 'nomecat', '1', '1',
    'id', '0']);
  CadastraAlteraCategoria.Update_Local :=
    'update tipo_produto set visivel_vem_buscar = 0, visivel_delivery = 0 where id_site not in ('
    + CadastraAlteraCategoria.codigos + ')';
  CadastraAlteraCategoria.Execute;

  CadastraAlteraCategoria.Free;

  CadastraAlteraCategoria := TCadastraAlteraSite.Create;
  CadastraAlteraCategoria.Tabela_Site := 'ws_itens';
  CadastraAlteraCategoria.Tabela_Local := 'produto';
  CadastraAlteraCategoria.Campo_Descricao_Local := 'nome_produto';
  CadastraAlteraCategoria.Campo_Descricao_Site := 'nomeitem';

  CadastraAlteraCategoria.Usuario := Usuario.ToString;

  CadastraAlteraCategoria.Campo_ID_Site := 'id';
  CadastraAlteraCategoria.Campo_ID_Local := 'codigo';
  CadastraAlteraCategoria.Insert := Insert;
  CadastraAlteraCategoria.requisicao := requisicao;
  CadastraAlteraCategoria.codigo := X['produto_alterado'].ToString;

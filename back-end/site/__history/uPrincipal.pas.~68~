procedure TfrmPrincipal.ReceberProduto;
var
  requisicao: TRequest;
  Memory: TFDMemTable;
  Insert: TInsertUpdate;
  Site: TInsertUpdateSite;
  X: ISuperArray;
  I: Integer;

  // CÛdigo Interno
  CodigoProduto: Integer;
  CodigoCategoria: Integer;
  CodigoExtraCategoria: Integer;
  CodigoExtraDescricao: Integer;
  CodigoSabor: Integer;
  CodigoTipoSabor: Integer;
  // Codigo Site
  produto: Integer;
  DadosProdutos: TFDMemTable;
  categoria: Integer;
  DadosCategoria: TFDMemTable;
  DadosSabores: TFDMemTable;

  ExtraCategoria: Integer;
  DadosExtraCategoria: TFDMemTable;
  ExtraCategoriaItem: Integer;
  DadosExtraCategoriaItem: TFDMemTable;
  Sabor: Integer;
  Qtd: Integer;
begin
  try
    Memory := TFDMemTable.Create(nil);
    Insert := TInsertUpdate.Create;
    Site := TInsertUpdateSite.Create;

    requisicao := TRequest.Create;
    requisicao.BASEURL := URL_SITE;
    requisicao.URLI := 'lista/' + BuscaPedidoThread.UserID.ToString + '/a';
    requisicao.MemoryTable := Memory;
    requisicao.Get;
    // requisicao.Retorno
    // ShowMessage(UTF8Encode(requisicao.Retorno));
    X := TSuperArray.Create(requisicao.Retorno);


    // ShowMessage(Memory.RecordCount.ToString);

    // SQL de consulta de tipo de produto
    // SELECT * FROM tipo_produto where (id_site = 818 or upper(descricao) = 'LANCHES')
    Qtd := 0;
    categoria := 0;
    lTotal.Caption := Qtd.ToString;
    lQuantidade.Caption := Memory.RecordCount.ToString;
    lRestante.Caption := (Memory.RecordCount - Qtd).ToString;
    while not Memory.Eof do
    begin

      Memory.Edit;
      if Memory.FieldByName('codigosabor').IsNull then
        Memory.FieldByName('codigosabor').AsInteger := 0;

      if categoria <> Memory.FieldByName('codigocategoria').AsInteger then
      begin
        categoria := Memory.FieldByName('codigocategoria').AsInteger;
        DadosCategoria := TFDMemTable.Create(self);
        DadosCategoria.LoadFromJSON
          (Insert.ConsultaSQL('SELECT * FROM tipo_produto where (id_site = ' +
          categoria.ToString + ' or upper(descricao) = ' +
          QuotedStr(Memory.FieldByName('nomecategoria').AsString) + ')'));
        CodigoCategoria := 0;
        if DadosCategoria.RecordCount > 0 then
        begin
          CodigoCategoria := DadosCategoria.FieldByName('codigo').AsInteger;
        end;

        CodigoCategoria := Insert.InserirUpdate('tipo_produto',
          ['codigo', 'descricao', 'impressora', 'pizza', 'visivel_vem_buscar',
          'visivel_delivery', 'id_site', 'ordem', 'modificado_site'],
          [CodigoCategoria.ToString,
          RemoveAcento(Memory.FieldByName('nomecategoria').AsString), '0', '0',
          '1', '1', categoria.ToString, '0', '1']);

        if cSincroniza.Checked then
          Site.InserirUpdate('ws_cat', BuscaPedidoThread.UserID.ToString,
            ['id', 'alterado'], [categoria.ToString, '0']);

        if Assigned(DadosCategoria) then
          DadosCategoria.Free;

        inc(Qtd);
        lTotal.Caption := Qtd.ToString;
        lQuantidade.Caption := Memory.RecordCount.ToString;
        lRestante.Caption := (Memory.RecordCount - Qtd).ToString;
      end;

      if produto <> Memory.FieldByName('codigoproduto').AsInteger then
      begin
        produto := Memory.FieldByName('codigoproduto').AsInteger;
        DadosProdutos := TFDMemTable.Create(self);
        DadosProdutos.LoadFromJSON
          (Insert.ConsultaSQL('select * from produto where (id_site = ' +
          Memory.FieldByName('codigoproduto').AsString +
          ' or upper(nome_produto) = ' +
          QuotedStr(RemoveAcento(Memory.FieldByName('nomeproduto')
          .AsString)) + ')'));
        CodigoProduto := 0;
        if DadosProdutos.RecordCount > 0 then
        begin
          CodigoProduto := DadosProdutos.FieldByName('codigo').AsInteger;
        end;
        //
        CodigoProduto := Insert.InserirUpdate('produto',
          ['codigo', 'codigo_interno', 'data_cadastro', 'nome_produto',
          'descricao', 'codigo_grupo', 'valor_venda', 'ativo', 'observacao',
          'id_site', 'valor_embalagem_delivery', 'usa_tabela_preco',
          'atualizado', 'modificado_site'], [CodigoProduto.ToString,
          FormatFloat('0000000', Memory.FieldByName('codigoproduto').AsInteger),
          FormatDateTime('YYYY-MM-DD', now),
          RemoveAcento(Memory.FieldByName('nomeproduto').AsString),
          RemoveAcento(Memory.FieldByName('descricaoproduto').AsString),
          CodigoCategoria.ToString, Memory.FieldByName('valorproduto').AsString,
          Memory.FieldByName('ativo').AsString, '1',
          Memory.FieldByName('codigoproduto').AsString,
          Memory.FieldByName('valorprodutoembalagem').AsString, '0',
          ' 1', '1']);

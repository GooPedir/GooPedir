                  // .AsFloat + ValorDelivery), ',', '.', [rfReplaceAll]) +
                  // ' where codigo = ' + CodigoNovoPeiddo.ToString;
                  // Insert.ExecutaSQL(SQL);

                  // CodigoMesa
                  SQL := 'update mesa set selecionada = ' +
                    CodigoNovoPeiddo.ToString + ' where id_mesa = ' +
                    CodigoMesa.ToString;
                  Insert.ExecutaSQL(SQL);

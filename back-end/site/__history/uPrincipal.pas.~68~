function TBuscaPedidos.QtdSabores(Valor: String): Integer;
var
  I: Integer;

begin
  Result := 0;
  for I := 1 to length(Valor) do
  begin
    if Valor[I] = '/' then
    begin
      try
        Valor := Copy(Valor, I - 1, 1);
        Result := StrToInt(Valor);
      except
        Result := 0;
      end;
    end;
  end;
end;


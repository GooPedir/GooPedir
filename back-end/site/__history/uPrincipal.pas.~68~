                  end;

                  FRequest.URLI := 'comp/' + MemoryTablePedidos.FieldByName
                    ('id').AsString + '/a';
                  try
                    FRequest.Get;
                    MemoryTablePedidos.FieldByName('complemento').AsString :=
                      FRequest.Retorno;
                  except

                  end;

                  MemoryTablePedidos.Post;
                end;

                CodigoNovoPeiddo := Insert.InserirUpdate('pedido',

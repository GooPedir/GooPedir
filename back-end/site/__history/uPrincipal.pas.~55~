procedure TCadastraAlteraSite.Execute;
var
  Body: String;
  Dados: TFDMemTable;
  InsertSite: TInsertUpdateSite;
  DadosSQL: TFDMemTable;
  CodigoADD: Integer;
  ArrayValores: Array of String;
  ArrayCampos: Array of String;
  I: Integer;
begin

  if length(codigo) = 0 then
    exit;

  Dados := TFDMemTable.Create(nil);
  InsertSite := TInsertUpdateSite.Create;

  // CÛdigo È os registros que foram alterados
  codigo := StringReplace(codigo, '"', '', [rfReplaceAll]);
  Body := '{"tabela":"' + Tabela_Site + '","condicao":" and ' + Campo_ID_Site +
    ' in (' + codigo + ')"}';
  requisicao.Body(Body);
  requisicao.Get;
  Dados.LoadFromJSON(requisicao.Retorno);

  while not Dados.Eof do
  begin
    CodigoADD := 0;
    DadosSQL := TFDMemTable.Create(nil);

    DadosSQL.LoadFromJSON(Insert.ConsultaSQL('select * from ' + Tabela_Local +
      ' where id_site not in (' + codigos + ') and ' + Campo_Descricao_Local +
      ' = ' + QuotedStr(Dados.FieldByName(Campo_Descricao_Site).AsString)));

    if DadosSQL.RecordCount > 0 then
    begin
      CodigoADD := DadosSQL.FieldByName(Campo_ID_Local).AsInteger;
    end
    else
    begin
      DadosSQL.LoadFromJSON(Insert.ConsultaSQL(SelectConsultaPorCodigo));
      if DadosSQL.RecordCount > 0 then
      begin
        CodigoADD := DadosSQL.FieldByName(Campo_ID_Local).AsInteger;
      end;
    end;

    SetLength(ArrayValores, length(Campo_Alterado_Local));
    for I := 0 to length(ArrayValores) - 1 do
    begin
      Campo_Alterado_Site[I] := StringReplace(Campo_Alterado_Site[I], '_', '',
        [rfReplaceAll]);
      if Assigned(Dados.FindField(Campo_Alterado_Site[I])) then
      begin
        ArrayValores[I] := Dados.FieldByName(Campo_Alterado_Site[I]).AsString;
        if Campo_ID_Local = Campo_Alterado_Site[I] then
          ArrayValores[I] := CodigoADD.ToString;
      end
      else
      begin
        ArrayValores[I] := Campo_Alterado_Site[I];
        if Campo_ID_Local = Campo_Alterado_Site[I] then
          ArrayValores[I] := CodigoADD.ToString;
      end;
      ArrayValores[I] := StringReplace(ArrayValores[I], '.', ',',
        [rfReplaceAll]);
    end;

    SetLength(ArrayCampos, length(Campo_Alterado_Local));
    for I := 0 to length(Campo_Alterado_Local) - 1 do
    begin
      ArrayCampos[I] := Campo_Alterado_Local[I];
    end;

    Insert.InserirUpdate(Tabela_Local, ArrayCampos, ArrayValores);

    InsertSite.InserirUpdate(Tabela_Site, Usuario, [Campo_ID_Site, 'alterado'],
      [Dados.FieldByName(Campo_ID_Site).AsString, '0']);

    DadosSQL.Free;
    Dados.next;
  end;

  if length(Update_Local) > 0 then
    Insert.ExecutaSQL(Update_Local);

  if Assigned(Dados) then
    Dados.Free;

  if Assigned(InsertSite) then
    InsertSite.Free;

  if Assigned(DadosSQL) then
    DadosSQL.Free;




  // CÛdigos È os registros que ja tem no sistema

end;


        try
        StrToFloat(ArrayValores[IndexArray]);
        ArrayValores[IndexArray] := StringReplace(ArrayValores[IndexArray],
        ',', '.', [rfReplaceAll]);
        except

        end;

        inc(IndexArray);
        end;

        InsertSite.InserirUpdate('ws_pedidos_itens', Usuario.ToString,

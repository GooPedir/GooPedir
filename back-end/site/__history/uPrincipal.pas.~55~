        Dados.FieldByName('id_sistema').AsString;
        SQL := SQL + ' group by pps.codigo_pedido_produto';
        DadosItens.LoadFromJSON(Insert.ConsultaSQL(SQL));
        while not DadosItens.Eof do
        begin
        SetLength(ArrayCampos, DadosItens.FieldCount + 4);
        SetLength(ArrayValores, DadosItens.FieldCount + 4);

        ArrayCampos[0] := 'ID_TABELA';
        ArrayCampos[1] := 'ID_WS_PEDIDO';
        ArrayCampos[2] := 'USER_ID';
        ArrayCampos[3] := 'CODIGO_PEDIDO';
        ArrayValores[0] := '0';
        ArrayValores[1] := codigo.ToString;
        ArrayValores[2] := Usuario.ToString;
        ArrayValores[3] := '';
        IndexArray := 4;
        for I := 0 to DadosItens.FieldCount - 1 do
        begin
        ArrayCampos[IndexArray] := DadosItens.Fields[I].FieldName;
        if not DadosItens.FieldByName(DadosItens.Fields[I].FieldName).IsNull
        then

        ArrayValores[IndexArray] :=

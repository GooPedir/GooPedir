              ['0', Memory.FieldByName('tiposabor').AsString, '1']);
          end
          else
          begin
            CodigoTipoSabor := DadosSabores.FieldByName('id').AsInteger;
          end;
          DadosSabores.Free;

          CodigoSabor := 0;
          DadosSabores := TFDMemTable.Create(self);
          DadosSabores.LoadFromJSON
            (Insert.ConsultaSQL
            ('select * from sabores_completo where id_produto = ' +
            CodigoProduto.ToString + ' and (id_site = ' +
            CodigoTipoSabor.ToString + ' or nome = ' +
            QuotedStr(Memory.FieldByName('sabor').AsString) + ')'));


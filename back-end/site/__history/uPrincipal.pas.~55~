          if Assigned(DadosExtraCategoriaItem) then
            DadosExtraCategoriaItem.Free;
          inc(Qtd);
          lTotal.Caption := Qtd.ToString;
          lQuantidade.Caption := Memory.RecordCount.ToString;
          lRestante.Caption := (Memory.RecordCount - Qtd).ToString;
        end;
      end;
      if Sabor <> Memory.FieldByName('codigosabor').AsInteger then
      begin
        Sabor := Memory.FieldByName('codigosabor').AsInteger;
        if Sabor > 0 then
        begin
          // Primeiro verifico a existencia se o produto È uma pizza
          // Obrigatorio
          DadosSabores := TFDMemTable.Create(self);
          DadosSabores.LoadFromJSON

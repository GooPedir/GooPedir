    X := TSuperObject.Create(FRequest.Retorno);

    if FRequest.Status = 200 then
    begin
      try
        FUserID := X['user'].AsInteger;
        frmPrincipal.NomeRestaurante := X['nome'].AsString;
        frmPrincipal.Token := X['token'].AsString;
        // nome_empresa_link
        frmPrincipal.codigo := X['user'].AsInteger;
        frmPrincipal.Empresa := X['nome_empresa_link'].AsString;
        frmPrincipal.Logo := X['logo'].AsString;
        frmPrincipal.CorFundo := X['cor_topo'].AsString;
        frmPrincipal.COrLetra := X['cor_titulo_produtos'].AsString;
        frmPrincipal.lLinkLoja.Caption := X['link'].AsString;
        frmPrincipal.Tray.Hint := frmPrincipal.NomeRestaurante;
      except
        FUserID := -1;
      end;
      if FUserID = 0 then
        FUserID := -1;

      SQL := 'update ws_empresa set versao = ' +
        QuotedStr(frmPrincipal.GetVersaoSQL);

      // SQL := SQL + ',mensagem = ' + QuotedStr(frmPrincipal.GetMensagem);
      // SQL := SQL + ',localizacao_gp = ' + QuotedStr(frmPrincipal.GetGrupo);

      for I := 0 to 6 do
      begin
        // DadosVersao := frmPrincipal.GetDadosConf(ArrayDias[I]);
        // if DadosVersao = '1' then
        // DadosVersao := 'true'
        // else
        // DadosVersao := 'false';

        DadosVersao := frmPrincipal.GetHorarioAtendimento(ArrayDias[I]);

        SQL := SQL + ',config_' + ArrayDias[I] + ' = ' + QuotedStr(DadosVersao);

        case I of
          5:
            begin
              SQL := SQL + ',config_' + ArrayDias[I] + 'o = ' +
                QuotedStr('false');

            end;
          6:
            begin
              SQL := SQL + ',config_' + ArrayDias[I] + 'o = ' +
                QuotedStr('false');

            end
        else
          begin
            SQL := SQL + ',config_' + ArrayDias[I] + 'a = ' +
              QuotedStr('false');

          end;
        end;

        DadosVersao := '';

        SQL := SQL + ',' + ArrayDias[I] + '_manha_de = ' +
          QuotedStr(frmPrincipal.GetHorarioAbertura(ArrayDias[I]));

        SQL := SQL + ',' + ArrayDias[I] + '_manha_ate = ' +
          QuotedStr(frmPrincipal.GetHorarioFechamento(ArrayDias[I]));

        SQL := SQL + ',' + ArrayDias[I] + '_tarde_de = ' +
          QuotedStr(frmPrincipal.GetHorarioAbertura(ArrayDias[I]));

        SQL := SQL + ',' + ArrayDias[I] + '_tarde_ate = ' +
          QuotedStr(frmPrincipal.GetHorarioFechamento(ArrayDias[I]));

      end;

      SQL := SQL + ',minimo_delivery = ' + frmPrincipal.GetMinimoDelivery;

      SQL := SQL + ',msg_tempo_delivery = ' +
        QuotedStr(frmPrincipal.GetTempoDelivery);
      // BuscaPedidoThread.ExecutaSQLSite(SQL);

      SQL := SQL + ',msg_tempo_buscar = ' +
        QuotedStr(frmPrincipal.GetTempoVemBuscar);

      SQL := SQL + ' where user_id = ' + FUserID.ToString;
      // ShowMessage(sql);
      BuscaPedidoThread.ExecutaSQLSite(SQL);
    end
    else
    begin
      FUserID := -1;
      // Clientid Errado
    end;
  end;
  Result := FUserID;
  // Enviar pro site
  frmPrincipal.Usuario := FUserID;

end;


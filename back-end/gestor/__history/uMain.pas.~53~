    btnSelecionar: TButton;
    memInstancia: TFDMemTable;
    memInstanciacaminho: TStringField;
    memInstanciaurl: TStringField;
    memInstanciasite: TStringField;
    memInstanciaimpressao: TStringField;
    memInstancianome_site: TStringField;
    memInstanciastatus: TStringField;
    memInstanciastatus_error: TIntegerField;
    Dialog: TOpenDialog;
    memInstanciareload: TStringField;
    FDStanStorageJSONLink1: TFDStanStorageJSONLink;
    Data: TDataSource;
    Requisicao: iRequisicao;
    btnExcluir: TButton;
    cReload: TCheckBox;
    cMonitoramento: TCheckBox;
    cUltimaAtualizacao: TLabel;
    Button1: TButton;
    PageControl1: TPageControl;
    TabSheet1: TTabSheet;
    TabSheet2: TTabSheet;
    DBGrid1: TDBGrid;

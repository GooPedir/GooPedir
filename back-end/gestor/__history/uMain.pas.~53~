var
  frmMain: TfrmMain;

implementation

{$R *.dfm}

procedure TfrmMain.AbrirExe(Nome: String);
var
  ExecInfo: TShellExecuteInfo;
  Diretorio: String;
begin
  if Length(Trim(Nome)) = 0 then
    Exit;

  ZeroMemory(@ExecInfo, SizeOf(ExecInfo));
  ExecInfo.cbSize := SizeOf(TShellExecuteInfo);
  ExecInfo.fMask := SEE_MASK_NOCLOSEPROCESS;
  ExecInfo.Wnd := Handle;
  ExecInfo.lpVerb := 'open';
  ExecInfo.lpFile := PChar(Nome);

  // Extrai o diretório do nome do executável
  Diretorio := ExtractFilePath(Nome);
  ExecInfo.lpDirectory := PChar(Diretorio);

  ExecInfo.nShow := SW_SHOWNORMAL;

  if ShellExecuteEx(@ExecInfo) then
  begin
    // Aqui você pode adicionar o código que precisa executar depois de iniciar o exe
  end
  else
  begin
    ShowMessage('Erro ao abrir o executável.');
  end;
end;

procedure TfrmMain.btnSelecionarClick(Sender: TObject);
var
  Path: String;
begin

  if Dialog.Execute then
  begin

    if not memInstancia.Locate('caminho', UpperCase(Dialog.FileName)) then
    begin
      memInstancia.Insert;
      memInstancia.FieldByName('caminho').AsString :=
        UpperCase(Dialog.FileName);
      InformacoesPadrao;
      InformacoesIni(Dialog.FileName);
      memInstancia.Post;

    end;

    memInstancia.SaveToFile('instancias.json');

  end;

end;

procedure TfrmMain.Button1Click(Sender: TObject);
var
  NovoExe: String;
  BaseCaminho: String;
begin
  cMonitoramento.Enabled := false;

  // AtualizaExe(Novo,Atual);
  with TOpenDialog.Create(nil) do
    try
      Filter := 'Executáveis|*.exe';
      if Execute then
        NovoExe := FileName;
    finally
      Free;
    end;

  if NovoExe.IsEmpty then
    Exit; // Se não selecionou um exe, sai do procedimento

  memLog.Lines.Add('Atualizando');
  memLog.Lines.Add('Data/Hora: ' + FormatDateTime('hh:nn:ss', now));

  while not memInstancia.Eof do
  begin
    memLog.Lines.Add('');

    BaseCaminho := TPath.GetDirectoryName(memInstancia.FieldByName('caminho')
      .AsString) + '/';

    memLog.Lines.Add('Caminho: ' + BaseCaminho);
    if (UpperCase(TPath.GetFileName(NovoExe)) = 'SERVIDORGOOPEDIR.EXE') then
    begin
      AtualizaExe(NovoExe, memInstancia.FieldByName('caminho').AsString);
    end
    else if (UpperCase(TPath.GetFileName(NovoExe)) = 'SITEGOOPEDIR.EXE') then
    begin
      AtualizaExe(NovoExe, BaseCaminho + memInstancia.FieldByName('nome_site')
        .AsString);
    end
    else if (UpperCase(TPath.GetFileName(NovoExe)) = 'NFCE.EXE') then
    begin
      AtualizaExe(NovoExe, BaseCaminho + 'NFCE.exe');
    end
    else
    begin
      memLog.Lines.Add('Executavel não suportado!');
    end;
    memInstancia.Next;
  end;
  memLog.Lines.Add('');
  memLog.Lines.Add('Concluido');
  memLog.Lines.Add('Data/Hora: ' + FormatDateTime('hh:nn:ss', now));

  cMonitoramento.Enabled := true;
end;

procedure TfrmMain.AtualizaExe(Novo, Atual: String);
var
  PastaBackup, NomeBackup: string;
  DataHora: string;
begin
  PastaBackup := TPath.Combine(TPath.GetDirectoryName(Atual), 'bkp');

  if not TDirectory.Exists(PastaBackup) then
    TDirectory.CreateDirectory(PastaBackup);

  DataHora := FormatDateTime('yyyy_mm_dd_hh_nn_ss', now);

  NomeBackup := TPath.Combine(PastaBackup,
    ChangeFileExt(TPath.GetFileName(Atual), '_bkp_' + DataHora + '.exe'));
  TFile.Move(Atual, NomeBackup);
  TFile.Copy(Novo, Atual);

end;

procedure TfrmMain.btnExcluirClick(Sender: TObject);
begin
  memInstancia.Delete;
  memInstancia.SaveToFile('instancias.json');
end;

procedure TfrmMain.FecharExe(ExeFileName: String);
const
  PROCESS_TERMINATE = $0001;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  ExeFileName := ExtractFileName(ExeFileName);

  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
  while Integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile))
      = UpperCase(ExeFileName)) or (UpperCase(FProcessEntry32.szExeFile)
      = UpperCase(ExeFileName))) then
      TerminateProcess(OpenProcess(PROCESS_TERMINATE, BOOL(0),
        FProcessEntry32.th32ProcessID), 0);
    ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

procedure TfrmMain.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  ResetInfo;
  memInstancia.SaveToFile('instancias.json');
end;

procedure TfrmMain.FormCreate(Sender: TObject);
begin
  memInstancia.Open;
  try
    memInstancia.LoadFromFile('instancias.json');
  except
    memInstancia.Open;
  end;

  ResetInfo;
  TGestaoInstancias.Create(30000,
    procedure
    begin
      TThread.Synchronize(nil,
        procedure
        begin
          if cMonitoramento.Checked then
          begin
            PercorreInstancia;
          end;
          // Se você quiser exibir mensagens ou fazer outras atualizações de UI, garanta que esteja dentro deste bloco sincronizado
          // ShowMessage('Executando a cada 3 segundos');
        end);
    end);

end;

procedure TfrmMain.InformacoesIni(Path: String);
var
  IniFiles: TIniFile;
begin
  IniFiles := TIniFile.Create(ExtractFilePath(Path) + 'goopedir.ini');
  memInstancia.FieldByName('nome_site').AsString :=
    IniFiles.ReadString('server', 'name', 'SiteGoopedir') + '.exe';
  memInstancia.FieldByName('url').AsString := IniFiles.ReadString('server',
    'baseurl', '');
  memInstancia.FieldByName('reload').AsString := IniFiles.ReadString('server',
    'restart', '');

end;

procedure TfrmMain.InformacoesPadrao;
begin
  memInstancia.FieldByName('status').AsString := 'Pendente';
  memInstancia.FieldByName('site').AsString := 'Pendente';
  memInstancia.FieldByName('impressao').AsString := 'Pendente';
  memInstancia.FieldByName('status_error').AsInteger := 0;
end;

procedure TfrmMain.ParseJsonResponse(const JsonResponse: string);
var
  JSONObject: TJSONObject;
  SiteObject, ImpressoraObject: TJSONObject;
  HoraServidor, Difference, Verificacao: string;
  ImpressoraStatus: Boolean;
begin
  // Converte a string JSON para um objeto JSON
  JSONObject := TJSONObject.ParseJSONValue(JsonResponse) as TJSONObject;
  try
    // Extrai o objeto 'site' do JSON
    SiteObject := JSONObject.GetValue<TJSONObject>('site');
    if Assigned(SiteObject) then
    begin
      // Lê os campos 'hora_servidor' e 'difference'
      HoraServidor := SiteObject.GetValue<string>('hora_servidor');
      Difference := SiteObject.GetValue<string>('difference');
      Verificacao := SiteObject.GetValue<string>('verificacao');
      // ShowMessage('Hora Servidor: ' + HoraServidor);
      // ShowMessage('Difference: ' + Difference);

      if StrToInt(Verificacao) = 0 then
      begin
        memInstancia.FieldByName('site').AsString := 'Fechado';
      end
      else
      begin
        memInstancia.FieldByName('site').AsString := 'Aberto';
      end;
    end;

    // Extrai o objeto 'impressora' do JSON
    ImpressoraObject := JSONObject.GetValue<TJSONObject>('impressora');
    if Assigned(ImpressoraObject) then
    begin
      // Lê o campo 'status' da impressora
      ImpressoraStatus := ImpressoraObject.GetValue<Boolean>('status');
      if ImpressoraStatus then
      begin
        memInstancia.FieldByName('impressao').AsString := 'Conectado';
      end
      else
      begin
        memInstancia.FieldByName('impressao').AsString := 'Sem Conexão';
      end;

    end;
  finally
    JSONObject.Free; // Libera o objeto JSON
  end;
end;

procedure TfrmMain.PercorreInstancia;
begin
  memInstancia.DisableControls;
  memInstancia.First;
  btnSelecionar.Enabled := false;
  btnExcluir.Enabled := false;

  while not memInstancia.Eof do
  begin
    memInstancia.Edit;
    Requisicao.BaseURL := memInstancia.FieldByName('url').AsString;
    Requisicao.TempoExpiracao := 5 * 1000;
    try
      Requisicao.Execute;
      memInstancia.FieldByName('status_error').AsInteger := 0;
      memInstancia.FieldByName('status').AsString := 'Conectado';
      ParseJsonResponse(Requisicao.Retorno);

    except
      on E: Exception do
      begin
        memInstancia.FieldByName('status_error').AsInteger :=
          memInstancia.FieldByName('status_error').AsInteger + 1;
        memInstancia.FieldByName('status').AsString := 'Sem Conexão';
        memLog.Lines.Add('');
        memLog.Lines.Add('URL: ' + Requisicao.BaseURL);
        memLog.Lines.Add(E.Message);
        ShowMessage(E.Message);
      end;
    end;
    if (memInstancia.FieldByName('status_error').AsInteger = 3) and
      (cReload.Checked) then
    begin
      FecharExe(ExtractFileDir(memInstancia.FieldByName('caminho').AsString) +
        '\' + memInstancia.FieldByName('nome_site').AsString);

      ReiniciarServidor(memInstancia.FieldByName('caminho').AsString);
    end;
    memInstancia.Post;
    memInstancia.Next;
  end;
  memInstancia.EnableControls;

  cUltimaAtualizacao.Caption := 'Atualizado: ' +
    FormatDateTime('hh:nn:ss', now);

  btnSelecionar.Enabled := true;
  btnExcluir.Enabled := true;

end;

procedure TfrmMain.ReiniciarServidor(Nome: String);
begin
  FecharExe(Nome);
  AbrirExe(Nome);
end;

procedure TfrmMain.ResetInfo;
begin
  if memInstancia.RecordCount > 0 then
  begin
    memInstancia.DisableControls;
    while not memInstancia.Eof do
    begin
      memInstancia.Edit;
      InformacoesPadrao;
      InformacoesIni(memInstancia.FieldByName('caminho').AsString);
      memInstancia.Next;
    end;
    memInstancia.EnableControls;
  end;
end;

function TfrmMain.VerificaExe(Nome: String): Boolean;
var
  ContinueLoop: BOOL;
  FSnapshotHandle: THandle;
  FProcessEntry32: TProcessEntry32;
begin
  Nome := ExtractFileName(Nome);
  FSnapshotHandle := CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
  FProcessEntry32.dwSize := SizeOf(FProcessEntry32);
  ContinueLoop := Process32First(FSnapshotHandle, FProcessEntry32);
  Result := false;
  while Integer(ContinueLoop) <> 0 do
  begin
    if ((UpperCase(ExtractFileName(FProcessEntry32.szExeFile)) = UpperCase(Nome)
      ) or (UpperCase(FProcessEntry32.szExeFile) = UpperCase(Nome))) then
    begin
      Result := true;
    end;
    ContinueLoop := Process32Next(FSnapshotHandle, FProcessEntry32);
  end;
  CloseHandle(FSnapshotHandle);
end;

{ TGestaoInstancias }

constructor TGestaoInstancias.Create(Intervalo: Integer; Proc: TProc);
begin
  inherited Create(false); // Cria a thread e já a inicia
  FIntervalo := Intervalo;
  FProcedure := Proc;
  FreeOnTerminate := true; // A thread se auto-destrói quando termina
end;

procedure TGestaoInstancias.Execute;
begin
  inherited;
  while not Terminated do
  begin
    if Assigned(FProcedure) then
      FProcedure(); // Executa a procedure

    Sleep(FIntervalo); // Aguarda o intervalo especificado
  end;
end;

end.

function TfrmMain.ImageToBase64(const AImage: TImage): string;
var
  Input: TBytesStream;
  Output: TStringStream;
  Encoder: TIdEncoderMIME;

begin
  Input := TBytesStream.Create;
  try

    try
      AImage.Picture.SaveToStream(Input);
      Input.Position := 0;

      Output := TStringStream.Create('', TEncoding.ASCII);
      try
        Encoder := TIdEncoderMIME.Create(nil);
        try
          Encoder.Encode(Input, Output);
          Result := Output.DataString;
        finally
          Encoder.Free;
        end;
      finally
        Output.Free;
      end;
    finally

    end;
  finally
    Input.Free;
  end;
end;


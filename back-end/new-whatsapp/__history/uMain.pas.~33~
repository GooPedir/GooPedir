function TfrmMain.NonoDigito(telefone: string): string;
begin

  if Length(telefone) = 10 then
    Result := copy(telefone, 1, 2) + '9' + copy(telefone, 3, 10)
  else
    Result := telefone;
end;

function TfrmMain.RemoveNonoDigito(telefone: string): string;
begin
  if Length(telefone) = 11 then
    Result := copy(telefone, 1, 2) + copy(telefone, 4, 10)
  else
    Result := telefone;
end;

end.

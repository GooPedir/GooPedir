function TfrmMain.ConverterHora(Hora: String): TDateTime;
begin
  try
    if pos('T', Hora) > 0 then
      Result := StrToTime(copy(Hora, 12, 8))
    else
      Result := StrToTime(copy(Hora, 0, 8));
  except
    Result := StrToTime(copy(Hora, 11, 8));
  end;
end;


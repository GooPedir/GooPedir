function RemoverNonoDigito(const Celular: string): string;
begin
  Result := Celular;
  // Verifica se o número tem 11 dígitos e se o nono dígito é '9'
  if (Length(Result) = 11) and (Result[3] = '9') then
    Result := Copy(Result, 1, 2) + Copy(Result, 4, 8); // Remove o nono dígito
end;


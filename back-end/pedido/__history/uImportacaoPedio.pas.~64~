procedure getPedidos;
var

  JSONArray: TJSONArray;
  JSONValue: TJSONValue;
  JSONObject: TJSONObject;
  I: Integer;
  Req: iRequisicao;
begin
  Req := iRequisicao.Create(nil);
  Req.BaseURL := 'https://ws.goopedir.com/v2/pedidos.php?';
  try
    Req.Execute;

    JSONArray := TJSONObject.ParseJSONValue(Req.Retorno) as TJSONArray;

    try
      // Verifica se o JSONArray não é nulo
      if Assigned(JSONArray) then
      begin
        // Itera sobre cada item do array
        for I := 0 to JSONArray.Count - 1 do
        begin
          // Obtém o objeto JSON atual
          JSONValue := JSONArray.Items[I];
          if JSONValue is TJSONObject then
          begin
            JSONObject := JSONValue as TJSONObject;

            // Acessa o valor do campo "id"
            // Writeln('ID do Pedido: ' + JSONObject.GetValue<string>('id'));
            getPedido(JSONObject.GetValue<string>('id'));
            // TGetPedidoThread.Create(JSONObject.GetValue<string>('id')).Start;
          end;
        end;
      end;
    finally
      // Libera a memória alocada para o JSONArray
      JSONArray.Free;
    end;
  except

  end;

  Req.Free;

end;


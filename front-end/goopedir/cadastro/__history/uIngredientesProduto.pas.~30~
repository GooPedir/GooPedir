unit uIngredientesProduto;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  uCadastroPadrao, FMX.Effects, FMX.Layouts, FMX.TabControl,
  FMX.Controls.Presentation, FMX.Objects, FireDAC.Stan.Intf,
  FireDAC.Stan.Option, FireDAC.Stan.Param, FireDAC.Stan.Error, FireDAC.DatS,
  FireDAC.Phys.Intf, FireDAC.DApt.Intf, Data.DB, FireDAC.Comp.DataSet,
  FireDAC.Comp.Client, uMemTable, FMX.ListBox, FMX.Edit, uEdit, System.Rtti,
  FMX.Grid.Style, FMX.ScrollBox, FMX.Grid, Data.Bind.EngExt, FMX.Bind.DBEngExt,
  FMX.Bind.Grid, System.Bindings.Outputs, FMX.Bind.Editors,
  Data.Bind.Components, Data.Bind.Grid, Data.Bind.DBScope;

type
  TfrmIngredientesProduto = class(TfrmCadastroBase)
    Layout3: TLayout;
    edtDescricao: iEdit;
    Label5: TLabel;
    Layout1: TLayout;
    Label3: TLabel;
    cUnidade: TComboBox;
    memDados: iMemTable;
    memDadosid: TIntegerField;
    memDadosdescricao: TStringField;
    memDadosunidade: TStringField;
    StringGrid4: TStringGrid;
    BindSourceDB1: TBindSourceDB;
    BindingsList1: TBindingsList;
    LinkGridToDataSourceBindSourceDB1: TLinkGridToDataSource;
    TabItem1: TTabItem;
    Rectangle2: TRectangle;
    edtIngredienteEstoque: TEdit;
    Label4: TLabel;
    cUnidadeEstoque: TComboBox;
    Label6: TLabel;
    edtQuantidade: TEdit;
    Label8: TLabel;
    edtCusto: TEdit;
    Label9: TLabel;
    cEstoqueSaida: TComboBox;
    Label10: TLabel;
    rConversao: TRectangle;
    Label11: TLabel;
    edtConversao: TEdit;
    Label12: TLabel;
    lDadosConversao: TLabel;
    AtualizaTela: TTimer;
    lCusto: TLabel;
    procedure rSalvarClick(Sender: TObject);
    procedure rAdicionarClick(Sender: TObject);
    procedure rAlterarClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure StringGrid4CellClick(const Column: TColumn; const Row: Integer);
    procedure cEstoqueSaidaChange(Sender: TObject);
    procedure edtQuantidadeExit(Sender: TObject);
    procedure AtualizaTelaTimer(Sender: TObject);
  private
    FTotal: Real;
    FCodigoIngrediente: Integer;
    FCustoTotal: Real;
    FCustoConversao: Real;
    FQuantidade: Real;
    { Private declarations }
    procedure GetDados;
    procedure CalculaConversao;
    procedure SetTotal(const Value: Real);
    procedure SetCodigoIngrediente(const Value: Integer);
    procedure SetCustoConversao(const Value: Real);
    procedure SetCustoTotal(const Value: Real);
    procedure SetQuantidade(const Value: Real);
  public
    { Public declarations }
    property Total: Real read FTotal write SetTotal;
    property CustoTotal : Real read FCustoTotal write SetCustoTotal;
    property CustoConversao : Real read FCustoConversao write SetCustoConversao;
    property Quantidade : Real read FQuantidade write SetQuantidade;
    property CodigoIngrediente : Integer read FCodigoIngrediente write SetCodigoIngrediente;

  end;

var
  frmIngredientesProduto: TfrmIngredientesProduto;
  Codigo: Integer;

implementation

{$R *.fmx}

uses uDM;

procedure TfrmIngredientesProduto.AtualizaTelaTimer(Sender: TObject);
begin
  inherited;
  AtualizaTela.Enabled := False;
  rConversao.Visible := cUnidadeEstoque.Items[cUnidadeEstoque.ItemIndex] <>
    cEstoqueSaida.Items[cEstoqueSaida.ItemIndex];
  CalculaConversao;
end;

procedure TfrmIngredientesProduto.CalculaConversao;
var
  Quantidade: Real;
  Conversao: Real;
  Custo : Real;
begin
  try
    Quantidade := StrToFloat(edtQuantidade.Text);
  except
    Quantidade := 0;
  end;
  try
    Conversao := StrToFloat(edtConversao.Text);
  except
    Conversao := 0;
  end;
    try
    Custo := StrToFloat(edtCusto.Text);
  except
    Custo := 0;
  end;

  Total := Quantidade * Conversao;
  Custo := Custo / Total;
  lCusto.text := FormatFloat('R$ #0.00',Custo)+' custo por '+cUnidadeEstoque.Items[cUnidadeEstoque.ItemIndex];
  lDadosConversao.Text := 'Será dado entrada em ' + FormatFloat('#0.000', Total)
    + cUnidadeEstoque.Items[cUnidadeEstoque.ItemIndex];

end;

procedure TfrmIngredientesProduto.cEstoqueSaidaChange(Sender: TObject);
begin
  inherited;
  AtualizaTela.Enabled := True;
end;

procedure TfrmIngredientesProduto.edtQuantidadeExit(Sender: TObject);
begin
  inherited;
  try
    StrToFloat((Sender as TEdit).Text);
    CalculaConversao;
  except
    (Sender as TEdit).SetFocus;
    ShowMessage('Valor informado invalido!');
    exit;
  end;
end;

procedure TfrmIngredientesProduto.FormCreate(Sender: TObject);
begin
  inherited;
  tabPrincipal.TabPosition := TTabPosition.None;
  GetDados;
end;

procedure TfrmIngredientesProduto.GetDados;
begin
  DM.GetSimples('/v1/consulta/todos/ingredientes', memDados);
end;

procedure TfrmIngredientesProduto.rAdicionarClick(Sender: TObject);
begin
  inherited;
  Codigo := 0;
  edtDescricao.Text := '';
  cUnidade.ItemIndex := 0;
  tabPrincipal.TabIndex := 1;
end;

procedure TfrmIngredientesProduto.rAlterarClick(Sender: TObject);
var
  I: Integer;
begin
  inherited;
  Codigo := memDados.FieldByName('id').AsInteger;
  edtDescricao.Text := memDados.FieldByName('descricao').AsString;

  for I := 0 to cUnidade.Items.Count - 1 do
  begin
    cUnidade.ItemIndex := I;
    if UpperCase(cUnidade.Items[I]) = UpperCase(memDados.FieldByName('unidade')
      .AsString) then
    begin
      tabPrincipal.TabIndex := 1;
      exit;
    end;

  end;
  tabPrincipal.TabIndex := 1;
end;

procedure TfrmIngredientesProduto.rSalvarClick(Sender: TObject);
begin
  inherited;
  DM.PostSimplesUnico('/v1/util/grava/ingrediente/' + Codigo.ToString + '/' +
    UpperCase((edtDescricao.Text)) + '/' + cUnidade.Items
    [cUnidade.ItemIndex], nil);
  GetDados;
  tabPrincipal.TabIndex := 0;
end;

procedure TfrmIngredientesProduto.SetCodigoIngrediente(const Value: Integer);
begin
  FCodigoIngrediente := Value;
end;

procedure TfrmIngredientesProduto.SetCustoConversao(const Value: Real);
begin
  FCustoConversao := Value;
end;

procedure TfrmIngredientesProduto.SetCustoTotal(const Value: Real);
begin
  FCustoTotal := Value;
end;

procedure TfrmIngredientesProduto.SetQuantidade(const Value: Real);
begin
  FQuantidade := Value;
end;

procedure TfrmIngredientesProduto.SetTotal(const Value: Real);
begin
  FTotal := Value;
end;

procedure TfrmIngredientesProduto.StringGrid4CellClick(const Column: TColumn;
  const Row: Integer);
var
  I: Integer;
begin
  inherited;
  tabPrincipal.TabIndex := 2;

  edtIngredienteEstoque.Text := memDados.FieldByName('descricao').AsString;
  cEstoqueSaida.ItemIndex := 0;
  edtConversao.Text := '1,000';
  edtCusto.Text := '0,000';
  rConversao.Visible := False;
  for I := 0 to cUnidadeEstoque.Items.Count - 1 do
  begin
    cUnidadeEstoque.ItemIndex := I;
    if cUnidadeEstoque.Items[I] = memDados.FieldByName('unidade').AsString then
    begin
      rConversao.Visible := cUnidadeEstoque.Items[cUnidade.ItemIndex] <>
        cEstoqueSaida.Items[cEstoqueSaida.ItemIndex];
      exit;
    end;

  end;

end;

initialization

RegisterClass(TfrmIngredientesProduto);

end.

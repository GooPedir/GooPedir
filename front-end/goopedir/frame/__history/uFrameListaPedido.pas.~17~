unit uFrameListaPedido;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Objects, FMX.Controls.Presentation;

type
  TCallback = procedure of object;
  TfrmListaPedido = class(TFrame)
    rOrigem: TRectangle;
    rTipo: TRectangle;
    Label1: TLabel;
    lCodigo: TLabel;
    Label3: TLabel;
    lData: TLabel;
    Label5: TLabel;
    lTempo: TLabel;
    Label7: TLabel;
    lCliente: TLabel;
    Label9: TLabel;
    lTotal: TLabel;
    lTaxa: TLabel;
    lDesconto: TLabel;
    lPedido: TLabel;
    Label14: TLabel;
    Label15: TLabel;
    Label16: TLabel;
    lEndereco: TLabel;
    lStatus: TLabel;
  private
    FTaxa: Real;
    FDesconto: Real;
    FCodigoDia: Integer;
    FSelecionado: Integer;
    FValor: Real;
    FHora: TTime;
    FMotoboy: String;
    FCliente: String;
    FCodigo: Integer;
    FTotal: Real;
    FStatus: String;
    FTipo: String;
    FEndereco: String;
    FOrigem: Integer;
    FData: TDate;
    FTempo: String;
    FCaixa: Integer;
    procedure SetCliente(const Value: String);
    procedure SetCodigo(const Value: Integer);
    procedure SetCodigoDia(const Value: Integer);
    procedure SetData(const Value: TDate);
    procedure SetDesconto(const Value: Real);
    procedure SetEndereco(const Value: String);
    procedure SetHora(const Value: TTime);
    procedure SetMotoboy(const Value: String);
    procedure SetOrigem(const Value: Integer);
    procedure SetSelecionado(const Value: Integer);
    procedure SetStatus(const Value: String);
    procedure SetTaxa(const Value: Real);
    procedure SetTipo(const Value: String);
    procedure SetTotal(const Value: Real);
    procedure SetValor(const Value: Real);
    procedure SetTempo(const Value: String);
    procedure SetCaixa(const Value: Integer);
    { Private declarations }
  public
    { Public declarations }
    property Origem: Integer read FOrigem write SetOrigem;
    property Tipo: String read FTipo write SetTipo;
    property Codigo: Integer read FCodigo write SetCodigo;
    property CodigoDia: Integer read FCodigoDia write SetCodigoDia;
    property Data: TDate read FData write SetData;
    property Hora: TTime read FHora write SetHora;
    property Status: String read FStatus write SetStatus;
    property Cliente: String read FCliente write SetCliente;
    property Endereco: String read FEndereco write SetEndereco;
    property Valor: Real read FValor write SetValor;
    property Desconto: Real read FDesconto write SetDesconto;
    property Taxa: Real read FTaxa write SetTaxa;
    property Total: Real read FTotal write SetTotal;
    property Motoboy: String read FMotoboy write SetMotoboy;
    property Selecionado: Integer read FSelecionado write SetSelecionado;
    property Tempo : String read FTempo write SetTempo;
    property Caixa : Integer read FCaixa write SetCaixa;
  end;

implementation

uses
  FMXTee.Canvas, util;

{$R *.fmx}
{ TfrmListaPedido }

procedure TfrmListaPedido.SetCaixa(const Value: Integer);
begin
  FCaixa := Value;
end;

procedure TfrmListaPedido.SetCliente(const Value: String);
begin
  FCliente := Value;
  lCliente.Text := FormataNome(Value);
end;

procedure TfrmListaPedido.SetCodigo(const Value: Integer);
begin
  FCodigo := Value;
end;

procedure TfrmListaPedido.SetCodigoDia(const Value: Integer);
begin
  FCodigoDia := Value;
  lCodigo.Text := FormatFloat('000', Value);
end;

procedure TfrmListaPedido.SetData(const Value: TDate);
begin
  FData := Value;
  lData.Text := FormatDateTime('dd/mm/yyyy',Value);
end;

procedure TfrmListaPedido.SetDesconto(const Value: Real);
begin
  FDesconto := Value;
  lDesconto.Text := FormatFloat('#0.00', Value);
end;

procedure TfrmListaPedido.SetEndereco(const Value: String);
begin
  FEndereco := Value;
  lEndereco.Text := FormataNome(Value);
end;

procedure TfrmListaPedido.SetHora(const Value: TTime);
begin
  FHora := Value;
    lData.Text := lData.Text+' '+FormatDateTime('hh:nn',Value);
end;

procedure TfrmListaPedido.SetMotoboy(const Value: String);
begin
  FMotoboy := Value;
end;

procedure TfrmListaPedido.SetOrigem(const Value: Integer);
var
  Cor: TColor;
begin
  FOrigem := Value;
  case Value of
    1:
      begin
        Cor := RGB(189, 246, 227);
      end;
    2:
      begin
        Cor := RGB(175, 222, 250);
      end;
    3:
      begin
        Cor := RGB(227, 210, 244);
      end;
    4:
      begin
        Cor := RGB(227, 210, 244);
      end;
  end;

  rOrigem.Stroke.Color := Cor;
end;

procedure TfrmListaPedido.SetSelecionado(const Value: Integer);
begin
  FSelecionado := Value;
end;

procedure TfrmListaPedido.SetStatus(const Value: String);
begin
  FStatus := Value;
  lStatus.Text := Value;
end;

procedure TfrmListaPedido.SetTaxa(const Value: Real);
begin
  FTaxa := Value;
  lTaxa.Text := FormatFloat('#0.00', Value);
end;

procedure TfrmListaPedido.SetTempo(const Value: String);
begin
  FTempo := Value;
  lTempo.Text := Value;
end;

procedure TfrmListaPedido.SetTipo(const Value: String);
var
  Cor: TColor;
begin
  FTipo := Value;
  if UpperCase(Value) = 'DELIVERY' then
  begin
    Cor := RGB(165, 218, 232);
  end
  else
  begin
    Cor := RGB(185, 178, 219);
  end;
  rTipo.Fill.Color := Cor;
  rTipo.Stroke.Color := Cor;

end;

procedure TfrmListaPedido.SetTotal(const Value: Real);
begin
  FTotal := Value;
  lTotal.Text := FormatFloat('#0.00', Value);
end;

procedure TfrmListaPedido.SetValor(const Value: Real);
begin
  FValor := Value;
  lPedido.Text := FormatFloat('#0.00', Value);
end;

end.

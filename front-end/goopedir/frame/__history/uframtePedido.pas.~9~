implementation

{$R *.fmx}

uses uDM, UnitResumo, uFechamentoPedido;

{ TframtePedido }

procedure TframtePedido.img_alterarClick(Sender: TObject);
begin
  if NOT Assigned(FrmResumo) then
    Application.CreateForm(TFrmResumo, FrmResumo);
  FrmResumo.MESA := 0;
  FrmResumo.CodigoPedido := ID;
  FrmResumo.Show;
end;

procedure TframtePedido.img_faturarClick(Sender: TObject);
begin
  frmFechamentoPedido := TfrmFechamentoPedido.Create(Self);
  // frmFechamentoPedido.Executar := Conluir;
  // frmFechamentoPedido.Cancelar := Cancelar;

  frmFechamentoPedido.CodigoPedido := ID;
  frmFechamentoPedido.Valor := Total;
  frmFechamentoPedido.DescricaoMesa := Cliente;

  frmFechamentoPedido.pago := 0;

  frmFechamentoPedido.Show;
end;

procedure TframtePedido.img_imprimirClick(Sender: TObject);
begin
  DM.PostSimples('/v1/imprimir/1/' + ID.ToString, nil);
end;


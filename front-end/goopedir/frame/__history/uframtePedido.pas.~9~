    procedure SetDesconto(const Value: Real);
    procedure SetEndereco(const Value: String);
    procedure SetHora(const Value: TTime);
    procedure SetID(const Value: Integer);
    procedure SetMotoboy(const Value: Integer);
    procedure SetPedido(const Value: Real);
    procedure SetStatus(const Value: String);
    procedure SetTaxa(const Value: Real);
    procedure SetTotal(const Value: Real);
    { Private declarations }

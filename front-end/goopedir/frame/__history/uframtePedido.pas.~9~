    Rectangle2: TRectangle;
    c_status: TComboBox;
    Label9: TLabel;
    c_motoboy: TComboBox;
    Label10: TLabel;
    edt_endereco: TEdit;
    Label11: TLabel;
    procedure img_imprimirClick(Sender: TObject);

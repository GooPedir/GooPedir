unit uFrameBotao;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Objects, FMX.Controls.Presentation, FMX.Effects;

type
  tTipo = (Valida, Cadastro, ConexaoSite, Senha);
  TCallback = procedure of object;

  TFrameBotao = class(TFrame)
    rPrincipal: TRectangle;
    lTexto: TLabel;
    ShadowEffect1: TShadowEffect;
    procedure rPrincipalClick(Sender: TObject);
    procedure rPrincipalMouseEnter(Sender: TObject);
    procedure rPrincipalMouseDown(Sender: TObject; Button: TMouseButton;
      Shift: TShiftState; X, Y: Single);
  private
    FTipoBotao: tTipo;
    FTexto: String;
    procedure SetTipoBotao(const Value: tTipo);
    procedure SetTexto(const Value: String);
    { Private declarations }
  public
    { Public declarations }
    property TipoBotao: tTipo read FTipoBotao write SetTipoBotao;
    property Texto: String read FTexto write SetTexto;

  var
    Sim: TCallback;
  end;

implementation

uses
  FMXTee.Canvas;

{$R *.fmx}
{ TFrame1 }

procedure TFrameBotao.rPrincipalClick(Sender: TObject);
begin
  if Assigned(Sim) then
    Sim;
end;

procedure TFrameBotao.rPrincipalMouseDown(Sender: TObject; Button: TMouseButton;
  Shift: TShiftState; X, Y: Single);
begin
(Sender as TRectangle).Opacity := 0.8;
end;

procedure TFrameBotao.rPrincipalMouseEnter(Sender: TObject);
begin
(Sender as TRectangle).Opacity := 1;
end;

procedure TFrameBotao.SetTexto(const Value: String);
begin
  FTexto := Value;
  lTexto.Text := FTexto;
end;

procedure TFrameBotao.SetTipoBotao(const Value: tTipo);
begin
  FTipoBotao := Value;
  rPrincipal.Stroke.Color := RGB(0, 0, 0);
  case FTipoBotao of
    Valida:
      begin
        rPrincipal.Stroke.Color := RGB(0, 0, 0);
      end;
    Cadastro:
      begin
        rPrincipal.Stroke.Color := RGB(0, 0, 0);
      end;
    Senha:
      begin
        rPrincipal.Stroke.Color := RGB(0, 255, 141);
      end;
    ConexaoSite:
      begin
        rPrincipal.Stroke.Color := RGB(9, 1, 119);
      end;
  end;
  lTexto.TextSettings.FontColor := rPrincipal.Stroke.Color;
end;

end.

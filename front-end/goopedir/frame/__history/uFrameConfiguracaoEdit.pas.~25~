unit uFrameConfiguracaoEdit;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  FMX.Objects, FMX.Controls.Presentation, FMX.Edit, Data.DB;

type
  TipoEdit = (Inteiro, Numerico, Texto);

  TFrameConfiguracaoEdit = class(TFrame)
    edtValor: TEdit;
    lNome: TLabel;
    btnSalvar: TSpeedButton;
    Image1: TImage;
    lStatus: TLabel;
    tLimpaStatus: TTimer;
    lQtdCaracteres: TLabel;
    procedure tLimpaStatusTimer(Sender: TObject);
    procedure btnSalvarClick(Sender: TObject);
    procedure edtValorKeyUp(Sender: TObject; var Key: Word; var KeyChar: Char;
      Shift: TShiftState);
  private
    FDescricao: String;
    FCampo: String;
    FValorAtual: String;
    FTipoCampo: TipoEdit;
    procedure SetCampo(const Value: String);
    procedure SetDescricao(const Value: String);
    procedure SetValorAtual(const Value: String);
    procedure SetTipoCampo(const Value: TipoEdit);
    { Private declarations }
    property ValorAtual: String read FValorAtual write SetValorAtual;
    procedure Salvar;
    procedure ContaCaracteres;
  public
    { Public declarations }
    property Campo: String read FCampo write SetCampo;
    property Descricao: String read FDescricao write SetDescricao;
    property TipoCampo: TipoEdit read FTipoCampo write SetTipoCampo;

  end;

implementation

{$R *.fmx}

uses uDM, util;

{ TFrameConfiguracaoEdit }

procedure TFrameConfiguracaoEdit.btnSalvarClick(Sender: TObject);
begin
  Salvar;
end;

procedure TFrameConfiguracaoEdit.ContaCaracteres;
begin
  if (edtValor.MaxLength > 0) then
    lQtdCaracteres.Text := length(edtValor.Text).ToString + '/' +
      edtValor.MaxLength.ToString
  else
    lQtdCaracteres.Text := '';
end;

procedure TFrameConfiguracaoEdit.edtValorKeyUp(Sender: TObject; var Key: Word;
  var KeyChar: Char; Shift: TShiftState);
begin
  btnSalvar.Enabled := ((Sender as TEdit).Text <> ValorAtual);
  btnSalvar.Visible := btnSalvar.Enabled;
  ContaCaracteres;
end;

procedure TFrameConfiguracaoEdit.Salvar;
var
  ValorFormatado: String;
begin

  case TipoCampo of
    Inteiro:
      begin
        try
          edtValor.Text.ToInteger;
        except
          lStatus.Text := 'Valor Informado Invalido!';
          tLimpaStatus.Enabled := True;
          exit;
        end;
      end;
    Numerico:
      begin
        try
          edtValor.Text.ToDouble;
        except
          lStatus.Text := 'Valor Informado Invalido!';
          tLimpaStatus.Enabled := True;
          exit;
        end;
      end;
    Texto:
      ;
  end;

  DM.DADOS_WHATSAPP.Edit;
  try
    DM.DADOS_WHATSAPP.Edit;
    DM.DADOS_WHATSAPP.FieldByName(Campo).AsVariant := edtValor.Text;
    ValorAtual := edtValor.Text;
    DM.DADOS_WHATSAPP.Post;

    ValorFormatado := edtValor.Text;

    DM.AtualizaParametro(Campo, ValorFormatado);

    lStatus.Text := 'Salvo com Sucesso';
    tLimpaStatus.Enabled := True;
  except
    lStatus.Text := 'Erro ao Salvar!';
    tLimpaStatus.Enabled := True;
  end;
end;

procedure TFrameConfiguracaoEdit.SetCampo(const Value: String);
begin
  DM.GetNomeEmpresa;
  FCampo := Value;

  if Assigned(DM.DADOS_WHATSAPP.FindField(Value)) then
  begin
    case DM.DADOS_WHATSAPP.FindField(Value).DataType of
      ftString:
        begin
          TipoCampo := Texto;
        end;
      ftInteger:
        begin
          TipoCampo := Inteiro;
        end;
      ftSmallint:
        begin
          TipoCampo := Inteiro;
        end;
      ftFloat:
        begin
          TipoCampo := Numerico;
        end;
      ftCurrency:
        begin
          TipoCampo := Numerico;
        end;
    end;

    if DM.DADOS_WHATSAPP.FieldByName(Value).IsNull then
    begin
      // Criar o Campo
    end;

    edtValor.Text := DM.DADOS_WHATSAPP.FieldByName(Value).AsString;
    lNome.Text := DM.DADOS_WHATSAPP.FindField(Value).DisplayName;
    ValorAtual := DM.DADOS_WHATSAPP.FieldByName(Value).AsString;
    edtValor.MaxLength := DM.DADOS_WHATSAPP.FindField(Value).Size;
    ContaCaracteres;
    TipoCampo := Texto;

    // TipoCampo
  end
  else
  begin
    ShowMessage('campo "' + Value +
      '" não foi declarado na memorytable "DADOS_WHATSAPP" no datamodule!');
  end;
end;

procedure TFrameConfiguracaoEdit.SetDescricao(const Value: String);
begin
  FDescricao := Value;
  if trim(FDescricao) <> '' then
  begin
    lNome.Text := FDescricao;
  end;

end;

procedure TFrameConfiguracaoEdit.SetTipoCampo(const Value: TipoEdit);
begin
  FTipoCampo := Value;
end;

procedure TFrameConfiguracaoEdit.SetValorAtual(const Value: String);
begin
  FValorAtual := Value;
end;

procedure TFrameConfiguracaoEdit.tLimpaStatusTimer(Sender: TObject);
begin
  tLimpaStatus.Enabled := False;
  lStatus.Text := '';
end;

end.

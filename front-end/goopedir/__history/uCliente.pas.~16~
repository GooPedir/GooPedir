var
  frmCliente: TfrmCliente;
  Carregando: Boolean;

implementation

{$R *.fmx}

uses uDM;

{ TfrmCliente }

procedure TfrmCliente.FormCreate(Sender: TObject);
begin
  inherited;
  GetDados;
  dm.GetSimples('/v1/consulta/todos/taxa_entrega', MemTaxa);
end;

procedure TfrmCliente.GetDados;
begin
  if Carregando then
    exit;
  Carregando := True;
  try
    TThread.CreateAnonymousThread(
      procedure
      begin
        lDados.Visible := False;
        dm.GetSimples('/v1/consulta/todos/clientes', DADOS, True);

        TThread.Synchronize(TThread.CurrentThread,
          procedure
          begin
            Carregando := False;
            lDados.Visible := True;
          end);
      end).Start;
  except
    on E: Exception do
    begin
      ShowMessage(E.Message);
      Carregando := False;
      lDados.Visible := False;
    end;

  end;

  tabPrincipal.TabIndex := 0;

end;

procedure TfrmCliente.rAdicionarClick(Sender: TObject);
begin
  inherited;
  if MemTaxa.RecordCount = 0 then
  begin
    ShowMessage('Deve-se cadastrar as taxas primeiro!');
    exit;
  end;
end;

initialization

RegisterClass(TfrmCliente);

end.

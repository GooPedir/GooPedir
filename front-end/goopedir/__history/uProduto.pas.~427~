procedure TfrmProduto.GetProduto;
begin
  lTotalProduto.Text := '';

  if CarregandoProduto then
    exit;
  CarregandoProduto := True;

  try
    TThread.CreateAnonymousThread(
      procedure
      begin
        BDSPRODUTOS.DataSet := Nil;
        // LimpaProdutos;
        if length(edtPesquisa.Text) > 0 then
        begin

          DM.GetSimples('v1/produto/' + edtPesquisa.Text, ALL_PRODUTOS);
        end
        else
          DM.GetSimples('v1/produto/all', ALL_PRODUTOS);
        TThread.Synchronize(TThread.CurrentThread,
          procedure
          begin
            BDSPRODUTOS.DataSet := ALL_PRODUTOS;
            CarregandoProduto := false;
            // DadosProduto;
          end);
      end).Start;

  except
    edtPesquisa.ReadOnly := false;
    CarregandoProduto := false;
  end;

  {
    TCarregaProduto.Enabled := false;
    edtPesquisa.ReadOnly := True;

    TThread.CreateAnonymousThread(
    procedure
    var
    Tot: Integer;
    begin
    rLoadProduto.Visible := True;

    Tot := ALL_PRODUTOS.RecordCount;
    ALL_PRODUTOS.First;
    while not ALL_PRODUTOS.Eof do
    begin

    CarregaProduto(ALL_PRODUTOS.FieldByName('id').AsInteger,
    ALL_PRODUTOS.FieldByName('interno').AsInteger,
    ALL_PRODUTOS.FieldByName('ativo').AsInteger,
    ALL_PRODUTOS.FieldByName('nome').AsString,
    ALL_PRODUTOS.FieldByName('descricao').AsString,
    ALL_PRODUTOS.FieldByName('descpro').AsString,
    ALL_PRODUTOS.FieldByName('venda').AsFloat);
    ALL_PRODUTOS.Next;
    end;

    rLoadProduto.Visible := false;
    edtPesquisa.ReadOnly := false;
    end).Start; }

end;


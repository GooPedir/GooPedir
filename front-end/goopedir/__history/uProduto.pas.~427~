procedure TfrmProduto.SwitchClick(Sender: TObject);
Var
  Mensagem: String;
begin
  try
    ALL_PRODUTOS.Locate('id', (Sender as TSwitch).Tag, []);
    Tipo := Alterar;
    Zerar;
    ZerarTabela;
    LoadProduto;

    if (Sender as TSwitch).IsChecked then
    begin
      (Sender as TSwitch).IsChecked := false;
      Mensagem := edtNome.Text + ' Pausado com Sucesso!'
    end
    else
    begin
      (Sender as TSwitch).IsChecked := True;
      Mensagem := edtNome.Text + ' Ativado com Sucesso!'
    end;

    sAtivo.IsChecked := (Sender as TSwitch).IsChecked;
    SalvarProduto;
    ShowMessageToast(self, Mensagem, 3);
  except

  end;
end;


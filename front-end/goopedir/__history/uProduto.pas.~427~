procedure TfrmProduto.CarregaProdutosSabores;
var

  Valores: String;
  I: Integer;
  Achou: Boolean;
  Aux: String;
  Nome: String;
  Valor: String;

begin
  SABORES_PRODUTOS.Close;
  SABORES_PRODUTOS.Open;

  Valores := SABORES.FieldByName('codigo').AsString + ',';
  Nome := SABORES.FieldByName('nome_produto').AsString + ',';
  Valor := SABORES.FieldByName('venda').AsString + ',';

  while length(Valores) > 1 do
  begin
    SABORES_PRODUTOS.insert;

    Achou := false;
    Aux := '';

    for I := 1 to length(Valores) do
    begin

      if not Achou then
      begin
        if Valores[I] = ',' then
        begin

          Valores := StringReplace(Valores, Aux + ',', '', [rfReplaceAll]);
          Achou := True;
        end
        else
        begin
          Aux := Aux + Valores[I];
        end;
      end;
    end;

    SABORES_PRODUTOS.FieldByName('codigo').AsInteger := Aux.ToInteger;

    Achou := false;
    Aux := '';

    for I := 1 to length(Nome) do
    begin

      if not Achou then
      begin
        if Nome[I] = ',' then
        begin

          Nome := StringReplace(Nome, Aux + ',', '', [rfReplaceAll]);
          Achou := True;
        end
        else
        begin
          Aux := Aux + Nome[I];
        end;
      end;
    end;

    SABORES_PRODUTOS.FieldByName('nome_produto').AsString := Aux;

    Achou := false;
    Aux := '';

    for I := 1 to length(Valor) do
    begin

      if not Achou then
      begin
        if Valor[I] = ',' then
        begin

          Valor := copy(Valor, I + 1, length(Valor));
          Achou := True;
        end
        else
        begin
          Aux := Aux + Valor[I];
        end;
      end;
    end;

    try
      SABORES_PRODUTOS.FieldByName('valor').AsFloat := Aux.ToDouble;
    except
      SABORES_PRODUTOS.FieldByName('valor').AsFloat := 0;
    end;

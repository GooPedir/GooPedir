function TfrmProduto.Separar(Descricao, Separador: String): Boolean;
var
  I: Integer;
  K: Integer;
  Aux: String;
  Adicionou: Boolean;
begin
  INGREDIENTE.Close;
  INGREDIENTE.Open;
  Descricao := Descricao + Separador[1];

  for I := 1 to length(Descricao) do
  begin
    Adicionou := false;
    for K := 1 to length(Separador) do
    begin

      if not Adicionou then
      begin
        if Descricao[I] = Separador[K] then
        begin
          Aux := UpperCase(RemoveAcento(Aux));
          INGREDIENTE.insert;
          INGREDIENTE.FieldByName('DESCRICAO').AsString := 'SEM ' + Aux;
          INGREDIENTE.FieldByName('IDPRODUTO').AsInteger := CodigoProduto;
          INGREDIENTE.Post;
          Aux := '';
        end
        else
        begin
          Aux := Aux + Descricao[I];
        end;
        Adicionou := True;
      end;

    end;

  end;

end;


function TfrmProduto.TipoCor(Index: Integer): TColor;
begin
  case Index of
    1:
      begin
        // Azul
        Result := RGB(109, 178, 253);
      end;
    2:
      begin
        // Vermelho
        Result := RGB(247, 114, 115);
      end;
    3:
      begin
        // Verde
        Result := RGB(49, 204, 175);
      end;
    4:
      begin
        // Laranja
        Result := RGB(253, 128, 0);
      end;
    5:
      begin
        // Roxo
        Result := RGB(144, 11, 250);
      end;
    6:
      begin
        Result := RGB(255, 232, 121);
      end;
    7:
      begin
        // iForth
        Result := RGB(48, 48, 86);
      end;
    8:
      begin
        // Cinza
        Result := RGB(151, 151, 198);
      end;
    9:
      begin
        Result := RGB(0, 0, 0);
      end;
    10:
      begin
        // BRanco
        Result := RGB(255, 255, 255);
      end;

    15:
      begin
        Result := RGB(2, 233, 2);
      end;
    16:
      begin
        Result := RGB(233, 2, 2);
      end;
    17:
      begin
        Result := RGB(145, 2, 233);
      end;
    18:
      begin
        Result := RGB(0, 0, 0);
      end;

  end;
end;

function TfrmProduto.ValidaCampos: Boolean;
begin
  Result := false;
  if length(edtNome.Text) = 0 then
  begin
    ShowMessageToast(self, 'Nome do produto não pode ser vazio!', 1);
    exit;
  end;
  try
    StrToFloat(edtVenda.Text);
  except
    ShowMessageToast(self, 'Preço de venda com formato invalido', 1);
    exit;
  end;
  try
    StrToFloat(edtAdcDelivery.Text);
  except
    edtAdcDelivery.Text := '0';
  end;
  try
    StrToFloat(edtAdcVB.Text);
  except
    edtAdcVB.Text := '0';
  end;

  if sPizza.IsChecked then
  begin
    try
      StrToInt(edtSabores.Text);
    except
      ShowMessageToast(self, 'Informe a quantidade de sabores!', 1);
      exit;
    end;
  end;
  Result := True;
end;

procedure TfrmProduto.Zerar;
begin
  Abrir(2);
  edtCodigo.Text := '0';
  edtNome.Text := '';
  edtDescricao.Text := '';
  edtVenda.Text := '0,00';
  edtAdcDelivery.Text := '0,00';
  edtAdcVB.Text := '0,00';
  sAtivo.IsChecked := True;
  cCategoria.ItemIndex := 0;
  //
  DM.GetSimples('v1/categoria/all', CATEGORIA);

  CATEGORIA.Locate('codigo', UltimaCategoria, []);
end;

procedure TfrmProduto.ZerarTabela;
begin
  tInicial.Time := StrToTime('00:00:00');
  tFinal.Time := StrToTime('23:59:59');
  edtValorTabela.Text := edtVenda.Text;
  sSegunda.IsChecked := True;
  sTerca.IsChecked := True;
  sQuarta.IsChecked := True;
  sQuinta.IsChecked := True;
  sSexta.IsChecked := True;
  sSabado.IsChecked := True;
  sDomingo.IsChecked := True;
end;


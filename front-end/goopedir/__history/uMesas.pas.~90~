procedure TfrmMesas.CriarRetanguloMesa(Flow: TFlowLayout; Descricao: String;
  Numero, Status: Integer; Total: Real; Codigo: Integer);
var
  RetanguloPrincipal: TRectangle;
  LabelDescricao: TLabel;
  LabelNumero: TLabel;
  LabelTotalDescricao: TLabel;
  LabelTotal: TLabel;
begin
  RetanguloPrincipal := TRectangle.Create(Self);

  with RetanguloPrincipal do
  begin
    Parent := Flow;
    Width := 150;
    Height := 150;
    Stroke.Thickness := 5;
    Margins.Left := 10;
    Margins.Top := 10;
    Fill.Color := TAlphaColors.White;
    XRadius := 10;
    YRadius := 10;
    Name := 'RetanguloPrincipal' + Codigo.ToString;
    Cursor := crHandPoint;
    Opacity := 0.5;
    OnMouseEnter := OnMouseEnterLocal;
    OnMouseLeave := OnMouseLeaveLocal;
    OnClick := ClickLocal;
    Tag := Codigo;
  end;

  LabelDescricao := TLabel.Create(Self);
  with LabelDescricao do
  begin
    Parent := RetanguloPrincipal;
    Align := TAlignLayout.Top;
    Text := Descricao;
    Name := 'LabelDescricao' + Codigo.ToString;
    TextSettings.HorzAlign := TTextAlign.Center;
    TextSettings.Font.Style := [TFontStyle.fsBold];
    StyledSettings := [TStyledSetting.Family, TStyledSetting.FontColor];
    Width := 150;
    TextSettings.Font.Size := 16;
    Height := 23;
    Margins.Top := 10;
    TabOrder := 1;
    Tag := Codigo;
  end;

  LabelNumero := TLabel.Create(Self);
  with LabelNumero do
  begin
    Parent := LabelDescricao;
    Align := TAlignLayout.Center;
    Text := Numero.ToString;
    Name := 'LabelNumero' + Codigo.ToString;
    TextSettings.HorzAlign := TTextAlign.Center;
    TextSettings.Font.Style := [TFontStyle.fsBold];
    StyledSettings := [TStyledSetting.Family, TStyledSetting.FontColor];
    Width := 150;
    TextSettings.Font.Size := 24;
    Height := 38;
    Margins.Top := 60;
    TabOrder := 2;
  end;

  LabelTotalDescricao := TLabel.Create(Self);
  with LabelTotalDescricao do
  begin
    Parent := LabelNumero;
    Align := TAlignLayout.Center;
    Text := 'Total R$';
    Name := 'LabelTotalDescricao' + Codigo.ToString;
    TextSettings.HorzAlign := TTextAlign.Center;
    StyledSettings := [TStyledSetting.Family, TStyledSetting.FontColor];
    Width := 150;
    TextSettings.Font.Size := 12;
    Height := 23;
    Margins.Top := 60;
    TabOrder := 3;
  end;

  LabelTotal := TLabel.Create(Self);
  with LabelTotal do
  begin
    Parent := LabelTotalDescricao;
    Align := TAlignLayout.Center;
    Text := FormatFloat('#0.00', Total);
    Name := 'LabelTotal' + Codigo.ToString;
    TextSettings.HorzAlign := TTextAlign.Center;
    TextSettings.Font.Style := [TFontStyle.fsBold];
    StyledSettings := [TStyledSetting.Family, TStyledSetting.FontColor];
    Width := 150;
    TextSettings.Font.Size := 24;
    Height := 38;
    Margins.Top := 60;
    TabOrder := 4;
  end;

  if Total = 0 then
    Status := 0;

  AtualizarMesa(Codigo, Status, Total);

end;


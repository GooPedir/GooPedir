  edtCodigoPedido.Text := '';
end;

function TfrmPrincipalMotoboy.HexToTColor(sColor: string): TColor;
begin
  sColor := StringReplace(sColor, '#', '', []);
  Result := rgb(StrToInt('$' + Copy(sColor, 1, 2)),
    StrToInt('$' + Copy(sColor, 3, 2)), StrToInt('$' + Copy(sColor, 5, 2)));
end;


procedure TfrmPrincipalMotoboy.InserirStatus(Status: Integer);
begin
  { 1-Saiu para entrega
    2-Entregue }
  InserirUpdate('ws_pedidos_motoboy ', DadosEmpresa.FieldByName('user_id')
    .AsString, ['codigo', 'dia', 'data', 'hora', 'celular', 'nome', 'bairro',
    'total', 'taxa', 'user_id', 'motoboy', 'status', 'codigo_pedido',
    'data_apontado', 'hora_apontado'], [StrList[0], StrList[1], StrList[2],
    StrList[3], StrList[4], StrList[5], StrList[8], StrList[11], StrList[12],
    DadosEmpresa.FieldByName('user_id').AsString,
    memDadosMotoboy.FieldByName('id').AsString, Status.ToString, StrList[0],
    FormatDateTime('yyyy-mm-dd', Date), TimeToStr(time)]);
  GetDados;
  TabControl1.TabIndex := 0;
end;

function TfrmPrincipalMotoboy.InserirUpdate(Tabela, User: String;
  ArrayCampos, ArrayValores: array of String): Integer;
var
  qry: TFDquery;
  Inserir: Boolean;

  Campos: String;
  Parametros: String;
  I: Integer;

  SQL: String;

  Montado: String;

  Valor: String;
begin

  Requisicao.URL := 'insert/' + Tabela + '/' + User + '/a';

  Montado := '';

  for I := 0 to length(ArrayCampos) - 1 do
  begin
    Valor := ArrayValores[I];

    try
      StrToFloat(Valor);
      Valor := StringReplace(Valor, ',', '.', [rfReplaceAll]);
    except

    end;

    if I = 0 then
    begin
      Montado := '"' + ArrayCampos[I] + '":"' + Valor + '"';
    end
    else
    begin
      Montado := Montado + ',"' + ArrayCampos[I] + '":"' + Valor + '"';
    end;
  end;
  Montado := '{' + Montado + '}';
  Montado := StringReplace(Montado, '#$A', '', [rfReplaceAll]);
  Montado := StringReplace(Montado, #$A, '', [rfReplaceAll]);

  Requisicao.BODY(Montado);
  Requisicao.Metodo := mPost;
  Requisicao.Execute;

  try
    Result := StrToInt(Requisicao.Retorno);
  except
    Result := 0;

  end;

end;


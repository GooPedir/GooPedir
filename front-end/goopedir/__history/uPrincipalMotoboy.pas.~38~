procedure TfrmPrincipalMotoboy.ProcessaQRCod(QRCOD: String);
var
  Base64: TBase64Encoding;
  StrList: TStringList;
begin
  if not memDados.Active then
    memDados.Open;
    rStatus.Visible := True;
  rEntrega.Visible := True;


  CodeReader1.Stop;
  Base64 := TBase64Encoding.Create(0);
  QRCOD := Base64.Decode(QRCOD);


  StrList := TStringList.Create;
  try
    // alimentar a lista com a string
    StrList.Delimiter := '|';
    StrList.StrictDelimiter := True;
    StrList.DelimitedText := QRCOD;

    InserirUpdate('ws_pedidos_motoboy ', DadosEmpresa.FieldByName('user_id')
      .AsString, ['codigo', 'dia', 'data', 'hora', 'celular', 'nome', 'bairro',
      'total', 'taxa', 'user_id', 'motoboy', 'status', 'codigo_pedido',
      'data_apontado', 'hora_apontado'], [StrList[0], StrList[1], StrList[2],
      StrList[3], StrList[4], StrList[5], StrList[8], StrList[11], StrList[12],
      DadosEmpresa.FieldByName('user_id').AsString,
      memDadosMotoboy.FieldByName('id').AsString, '1', StrList[0],
      FormatDateTime('yyyy-mm-dd', Date), TimeToStr(time)]);
    GetDados;
    TabControl1.TabIndex := 0;


    // leitura

  finally
    StrList.Free;
  end;

  // ShowMessage(QRCOD);
end;


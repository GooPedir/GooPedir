end;

procedure TfrmRelatorioVendas.CalculaTotal;
var
  TotalPedido: Integer;
  TotalCancelado: Integer;
  ValorPedido: Real;
  ValorCancelado: Real;
  ValorTaxa: Real;
  ValorDesconto: Real;
begin
  TotalPedido := 0;
  TotalCancelado := 0;

  ValorPedido := 0;
  ValorCancelado := 0;
  ValorTaxa := 0;
  ValorDesconto := 0;

  if PEDIDOS.RecordCount > 0 then
  begin
    PEDIDOS.DisableControls;
    PEDIDOS.First;
    while not PEDIDOS.Eof do
    begin

      case PEDIDOS.FieldByName('status').AsInteger of
        0:
          begin
            TotalPedido := TotalPedido + PEDIDOS.FieldByName('qtd').AsInteger;
            TotalCancelado := TotalCancelado + PEDIDOS.FieldByName('qtd')
              .AsInteger;

            ValorPedido := ValorPedido + PEDIDOS.FieldByName('total').AsFloat;
            ValorCancelado := ValorCancelado + PEDIDOS.FieldByName
              ('total').AsFloat;

          end
      else
        begin
          TotalPedido := TotalPedido + PEDIDOS.FieldByName('qtd').AsInteger;
          ValorPedido := ValorPedido + PEDIDOS.FieldByName('total').AsFloat;
          ValorTaxa := ValorTaxa + PEDIDOS.FieldByName('taxa').AsFloat;
          ValorDesconto := ValorDesconto + PEDIDOS.FieldByName
            ('desconto').AsFloat;
        end;

      end;

      PEDIDOS.Next;
    end;

    BalaoValoresQtdPedido.Valor := TotalPedido;
    BalaoValoresQtdCancelado.Valor := TotalCancelado;
    BalaoValoresQtdConcluido.Valor := TotalPedido - TotalCancelado;

    BalaoValoresTotPedido.Valor := ValorPedido;
    BalaoValoresTotCancelado.Valor := ValorCancelado;
    BalaoValoresTotConcluido.Valor := ValorPedido - ValorCancelado;
    BalaoValoresTotDesconto.Valor := ValorDesconto;
    BalaoValoresTotTaxa.Valor := ValorTaxa;

    PEDIDOS.EnableControls;
  end;
end;

function TfrmRelatorioVendas.CriaFrame(Pai: TFmxObject; Descricao: String;
Tipo: TTipo): TframeBalaoValores;
begin
  inc(IDFrame);
  Result := TframeBalaoValores.Create(Pai);
  Result.Parent := Pai;
  Result.Align := TAlignLayout.Left;
  Result.Descricao := Descricao;
  Result.Tipo := Tipo;
  Result.Valor := 0;
  Result.Name := 'frameBalao' + IDFrame.ToString;
end;


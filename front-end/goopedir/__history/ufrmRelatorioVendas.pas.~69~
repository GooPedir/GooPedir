procedure TfrmRelatorioVendas.MontarGraficoMaisVendido;
var
  chart: TSuperChart;
  jsonStr, erro: string;
  Quant: Integer;

begin
  if not(PRODUTOS.RecordCount >= QtdRegistroGrafico) then
    exit;
  try
    chart := TSuperChart.Create(layout_chart1, Lines);

    // Valores...
    chart.ShowValues := true;
    chart.FontSizeValues := 10;
    chart.FontColorValues := $FFFFFFFF;
    chart.FormatValues := '#,##0.00';

    // Linhas...
    chart.LineColor := $FFFFFFFF;
    chart.ShowBackground := true;
    chart.BackgroundColor := $FF4F5060;
    chart.RoundedBotton := true;
    chart.RoundedTop := true;

    // Argumentos...
    chart.FontSizeArgument := 9;
    chart.FontColorArgument := $FFFFFFFF;
    jsonStr := '';
    PRODUTOS.First;
    Quant := 0;
    while not PRODUTOS.Eof do
    begin
      inc(Quant);
      if Quant <= QtdRegistroGrafico then
      begin
        if length(jsonStr) = 0 then
          jsonStr := '{"field":"' + PRODUTOS.FieldByName('produto').AsString +
            '", "valor":' + PRODUTOS.FieldByName('venda').AsString + '}'
        else
          jsonStr := jsonStr + ',{"field":"' + PRODUTOS.FieldByName('produto')
            .AsString + '", "valor":' + PRODUTOS.FieldByName('venda')
            .AsString + '}';
      end;

      PRODUTOS.Next;
    end;

    // Json...
    // jsonStr :=
    // '[{"field":"Jan", "valor":220}, {"field":"Fev", "valor":580}, {"field":"Mar", "valor":750},';
    // jsonStr := jsonStr +
    // '{"field":"Abr", "valor":600}, {"field":"Mai", "valor":700}, {"field":"Jun", "valor":800},';
    // jsonStr := jsonStr +
    // '{"field":"Jul", "valor":950}, {"field":"Ago", "valor":1100}, {"field":"Set", "valor":950},';
    // jsonStr := jsonStr +
    // '{"field":"Out", "valor":800}, {"field":"Nov", "valor":700}, {"field":"Dez", "valor":900}]';

    // Render do grafico...
    chart.LoadFromJSON('[' + jsonStr + ']', erro);

    if NOT erro.IsEmpty then
      showmessage(erro);

  finally
    chart.DisposeOf;
  end;
end;


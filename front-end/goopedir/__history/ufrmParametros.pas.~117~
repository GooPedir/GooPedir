procedure TfrmParametros.SenhaCadastrada;
begin
  ShowMessageToast(frmMain, 'Senha Cadastrada Com Sucesso!', 2);
end;

procedure TfrmParametros.SenhaGerente;
begin
  if not Assigned(frmSenha) then
    frmSenha := TfrmSenha.Create(frmMain);
  frmSenha.Sim := SenhaCadastrada;
  frmSenha.Tipo := Cadastrar;
  frmSenha.Show;
end;

procedure TfrmParametros.TestarConexao;
begin

  dm.DadosSite;
  if dm.UserId > 0 then
  begin
    ShowMessageToast(frmMain, 'Conectado Com Sucesso! ' + dm.Link, 3);
  end
  else
  begin
    ShowMessageToast(frmMain, 'Sem Conexão Com o Servidor!', 1);
  end;
end;


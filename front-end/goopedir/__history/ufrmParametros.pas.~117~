procedure TfrmParametros.AdicionaCombo(Pai: TFmxObject;
  Campo, Descricao: String; Itens: array of String; AcrecentaUm: Boolean);
var
  Frame: TFrameCombo;
  I: Integer;
begin

  Frame := TFrameCombo.Create(Pai);
  Frame.Parent := Pai;
  Frame.Name := 'TFrameCombo' + Campo;
  Frame.Campo := Campo;
  Frame.Descricao := Descricao;
  Frame.Align := TAlignLayout.Top;
  Frame.SomaUm := AcrecentaUm;
  for I := 0 to length(Itens) - 1 do
  begin
    Frame.AdicionaValor(Itens[I]);
  end;

end;

procedure TfrmParametros.AdicionaParametroEdit(Local: TVertScrollBox;
  Campo, Descricao: String);
var
  Frame: TFrameConfiguracaoEdit;
begin
  Frame := TFrameConfiguracaoEdit.Create(Local);
  Frame.Name := 'TFrameConfiguracaoEdit' + Campo;
  Frame.Campo := Campo;
  Frame.Parent := Local;
  Frame.Descricao := Descricao;
  Frame.Align := TAlignLayout.Top;
end;

procedure TfrmParametros.AdicionaSelecao(Pai: TFmxObject;
  Alinhamento: TAlignLayout; Campo, Descricao, True, False: String);
var
  Frame: TframeSelecao;
begin
  Frame := TframeSelecao.Create(Pai);
  Frame.Parent := Pai;
  Frame.Name := 'TframeSelecao' + Campo;
  Frame.Campo := Campo;
  Frame.ValorTrue := True;
  Frame.ValorFalse := False;
  Frame.Titulo := Descricao;
  Frame.Align := Alinhamento;

end;

procedure TfrmParametros.AdicionaTitulo(Local: TVertScrollBox;
  Descricao: String);
var
  Frame: TFrameTitulo;
begin
  inc(FrameTituloContador);
  Frame := TFrameTitulo.Create(Local);
  Frame.Name := 'TFrameTitulo' + FrameTituloContador.ToString;
  Frame.Parent := Local;
  Frame.Titulo := Descricao;
  Frame.Align := TAlignLayout.Top;
end;


implementation

{$R *.fmx}

uses uDM;

{ TfrmTipoPagamento }

procedure TfrmTipoPagamento.DadosTipoPagamento;
begin
  edtDescricao.Text := DADOS.FieldByName('descricao').AsString;
  sAtivo.IsChecked := DADOS.FieldByName('ativo').AsInteger = 1;
  sTroco.IsChecked := DADOS.FieldByName('troco_delivery').AsInteger = 1;
end;

procedure TfrmTipoPagamento.FormCreate(Sender: TObject);
begin
  inherited;
  GetDados;

  TIPO.Close;
  TIPO.Open;
  TIPO.Insert;
  TIPO.FieldByName('ID').AsInteger := 1;
  TIPO.FieldByName('DESCRICAO').AsString := 'Á VISTA';
  TIPO.Post;
  TIPO.Insert;
  TIPO.FieldByName('ID').AsInteger := 2;
  TIPO.FieldByName('DESCRICAO').AsString := 'Á PRAZO';
  TIPO.Post;

  PIX.Close;
  PIX.Open;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 1;
  PIX.FieldByName('DESCRICAO').AsString := 'NÃO É PIX';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 2;
  PIX.FieldByName('DESCRICAO').AsString := 'CPF';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 3;
  PIX.FieldByName('DESCRICAO').AsString := 'CNPJ';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 4;
  PIX.FieldByName('DESCRICAO').AsString := 'Celular';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 5;
  PIX.FieldByName('DESCRICAO').AsString := 'E-Mail';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 6;
  PIX.FieldByName('DESCRICAO').AsString := 'Celular';
  PIX.Post;
  PIX.Insert;
  PIX.FieldByName('ID').AsInteger := 7;
  PIX.FieldByName('DESCRICAO').AsString := 'Aleatória';
  PIX.Post;


  tabMain.TabPosition := TTabPosition.None;

end;

procedure TfrmTipoPagamento.GetDados;
begin
  dm.GetSimples('/v1/consulta/todos/tipo_pagamento', DADOS);
  tabMain.TabIndex := 0;
end;

procedure TfrmTipoPagamento.rAlterarClick(Sender: TObject);
begin
  inherited;
  edtDescricao.Text := DADOS.FieldByName('descricao').AsString;
  sAtivo.IsChecked := DADOS.FieldByName('ativo').AsInteger = 1;
  sTroco.IsChecked := DADOS.FieldByName('troco_delivery').AsInteger = 1;
  tabMain.TabIndex := 1;
end;

procedure TfrmTipoPagamento.rSalvarClick(Sender: TObject);
begin
  inherited;
  DADOS.Edit;
  DADOS.FieldByName('descricao').AsString := edtDescricao.Text;
  DADOS.FieldByName('movimentacao').AsInteger := TIPO.FieldByName('id')
    .AsInteger;

  if sAtivo.IsChecked then
    DADOS.FieldByName('ativo').AsInteger := 1
  else
    DADOS.FieldByName('ativo').AsInteger := 0;

  if sTroco.IsChecked then
    DADOS.FieldByName('troco_delivery').AsInteger := 1
  else
    DADOS.FieldByName('troco_delivery').AsInteger := 0;

  dm.PostSimplesUnico('/v1/tipopagamento/', DADOS);
  GetDados;
end;

procedure TfrmTipoPagamento.StringGrid4DrawColumnCell(Sender: TObject;
  const Canvas: TCanvas; const Column: TColumn; const Bounds: TRectF;
  const Row: Integer; const Value: TValue; const State: TGridDrawStates);
begin
  inherited;
  case Column.Index of
    0:
      begin
        // Status

        if (Value.ToString = '1') then
        begin
          Canvas.Fill.Color := TipoCor(3);
          Canvas.Stroke.Color := TipoCor(3);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(3);
          Canvas.FillText(Bounds, Value.ToString, false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end
        else
        begin
          Canvas.Fill.Color := TipoCor(2);
          Canvas.Stroke.Color := TipoCor(2);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(2);
          Canvas.FillText(Bounds, Value.ToString, false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end;
      end;
    3:
      begin
        // Status

        if (Value.ToString = '1') then
        begin
          Canvas.Fill.Color := TipoCor(3);
          Canvas.Stroke.Color := TipoCor(3);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(3);
          Canvas.FillText(Bounds, Value.ToString, false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end
        else
        begin
          Canvas.Fill.Color := TipoCor(2);
          Canvas.Stroke.Color := TipoCor(2);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(2);
          Canvas.FillText(Bounds, Value.ToString, false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end;
      end;
    4:
      begin
        // Status

        if (Value.ToString = '1') then
        begin
          Canvas.Fill.Color := TipoCor(1);
          Canvas.Stroke.Color := TipoCor(1);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(18);
          Canvas.FillText(Bounds, '80mm', false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end
        else
        begin
          Canvas.Fill.Color := TipoCor(5);
          Canvas.Stroke.Color := TipoCor(5);

          Canvas.FillRect(Bounds, 0, 0, [], 1);
          Canvas.Fill.Color := TipoCor(18);
          Canvas.FillText(Bounds, '56mm', false, 1,
            [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
            TTextAlign.Center);
        end;
      end;
  end;
end;

function TfrmTipoPagamento.TipoCor(Index: Integer): TColor;
begin
  case Index of
    1:
      begin
        // Azul
        Result := RGB(109, 178, 253);
      end;
    2:
      begin
        // Vermelho
        Result := RGB(247, 114, 115);
      end;
    3:
      begin
        // Verde
        Result := RGB(49, 204, 175);
      end;
    4:
      begin
        // Laranja
        Result := RGB(253, 128, 0);
      end;
    5:
      begin
        // Roxo
        Result := RGB(144, 11, 250);
      end;
    6:
      begin
        Result := RGB(255, 232, 121);
      end;
    7:
      begin
        // iForth
        Result := RGB(48, 48, 86);
      end;
    8:
      begin
        // Cinza
        Result := RGB(151, 151, 198);
      end;
    9:
      begin
        Result := RGB(0, 0, 0);
      end;
    10:
      begin
        // BRanco
        Result := RGB(255, 255, 255);
      end;

    15:
      begin
        Result := RGB(2, 233, 2);
      end;
    16:
      begin
        Result := RGB(233, 2, 2);
      end;
    17:
      begin
        Result := RGB(145, 2, 233);
      end;
    18:
      begin
        Result := RGB(0, 0, 0);
      end;

  end;
end;

initialization

RegisterClass(TfrmTipoPagamento);

end.

function TDM.TipoCor(Index: Integer): TColor;
begin
  case Index of
    1:
      begin
        // Azul
        Result := RGB(109, 178, 253);
      end;
    2:
      begin
        // Vermelho
        Result := RGB(247, 114, 115);
      end;
    3:
      begin
        // Verde
        Result := RGB(49, 204, 175);
      end;
    4:
      begin
        // Laranja
        Result := RGB(253, 128, 0);
      end;
    5:
      begin
        // Roxo
        Result := RGB(144, 11, 250);
      end;
    6:
      begin
        Result := RGB(255, 232, 121);
      end;
    7:
      begin
        // iForth
        Result := RGB(48, 48, 86);
      end;
    8:
      begin
        // Cinza
        Result := RGB(151, 151, 198);
      end;
    9:
      begin
        Result := RGB(0, 0, 0);
      end;
    10:
      begin
        // BRanco
        Result := RGB(255, 255, 255);
      end;

    15:
      begin
        Result := RGB(2, 233, 2);
      end;
    16:
      begin
        Result := RGB(233, 2, 2);
      end;
    17:
      begin
        Result := RGB(145, 2, 233);
      end;
    18:
      begin
        Result := RGB(0, 0, 0);
      end;

  end;
end;


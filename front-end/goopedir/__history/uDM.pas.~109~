function TDM.Link: String;
var
  Campo: String;
  Valor: String;
begin
  if FUserId = 0 then
  begin
    DadosSite;
  end;
  Campo := 'link';
  Valor := JSonDadosSite.Get(Campo).JsonValue.ToString;
  Valor := StringReplace(Valor, '"', '', [rfReplaceAll]);
  Valor := StringReplace(Valor, '\', '/', [rfReplaceAll]);
  Valor := StringReplace(Valor, '//', '/', [rfReplaceAll]);

  Result := Valor;
end;


  Requisicao.BaseURL := 'https://goopedir.com/ws/v1/';
  Requisicao.URL := 'token2/a';
  Body := '{' + #13 + '"client_id":"' + DADOS_WHATSAPP.FieldByName('client_id')
    .AsString + '",' + #13 + '"client_security":"' + DADOS_WHATSAPP.FieldByName

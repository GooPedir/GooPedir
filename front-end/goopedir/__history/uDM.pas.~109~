function TDM.UserId: Integer;
var
  Campo: String;
  Valor: String;
begin
  if FUserId = 0 then
  begin
    DadosSite;
  end;
  Campo := 'user';
  Valor := JSonDadosSite.Get(Campo).JsonValue.ToString;
  Valor := StringReplace(Valor, '"', '', [rfReplaceAll]);

  try
    Result := Valor.ToInteger;
  except
    Result := 0;
  end;
end;


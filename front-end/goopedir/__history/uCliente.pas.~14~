unit uCliente;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Graphics, FMX.Controls, FMX.Forms, FMX.Dialogs, FMX.StdCtrls,
  uCadastroPadrao, FMX.Effects, FMX.Layouts, FMX.TabControl,
  FMX.Controls.Presentation, FMX.Objects, FireDAC.Stan.Intf,
  FireDAC.Stan.Option, FireDAC.Stan.Param, FireDAC.Stan.Error, FireDAC.DatS,
  FireDAC.Phys.Intf, FireDAC.DApt.Intf, Data.DB, FireDAC.Comp.DataSet,
  FireDAC.Comp.Client, uMemTable, FMX.ListView.Types, FMX.ListView.Appearances,
  FMX.ListView.Adapters.Base, System.Rtti, System.Bindings.Outputs,
  FMX.Bind.Editors, Data.Bind.EngExt, FMX.Bind.DBEngExt, Data.Bind.Components,
  Data.Bind.DBScope, FMX.ListView;

type
  TfrmCliente = class(TfrmCadastroBase)
    DADOS: iMemTable;
    DADOScodigo: TIntegerField;
    DADOSnome: TStringField;
    DADOScelular: TStringField;
    DADOSativo: TIntegerField;
    lDados: TListView;
    BindSourceDB1: TBindSourceDB;
    BindingsList1: TBindingsList;
    LinkListControlToField1: TLinkListControlToField;
    DADOSendereco: TStringField;
    DADOSrua: TStringField;
    DADOSbairro: TStringField;
    DADOScidade: TStringField;
    DADOSestado: TStringField;
    DADOScomplemento: TStringField;
    DADOSnumero: TStringField;
    MemTaxa: iMemTable;
    MemTaxabairro: TStringField;
    MemTaxacidade: TStringField;
    MemTaxaestado: TStringField;
    MemTaxacodigo: TIntegerField;
    MemTaxavalor_taxa: TFloatField;
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
    procedure GetDados;
  end;

var
  frmCliente: TfrmCliente;
  Carregando: Boolean;

implementation

{$R *.fmx}

uses uDM;

{ TfrmCliente }

procedure TfrmCliente.FormCreate(Sender: TObject);
begin
  inherited;
  GetDados;
 dm.GetSimples('/v1/consulta/todos/taxa_entrega', MemTaxa);
end;

procedure TfrmCliente.GetDados;
begin
  if Carregando then
    exit;
  Carregando := True;
  try
    TThread.CreateAnonymousThread(
      procedure
      begin
        lDados.Visible := False;
        dm.GetSimples('/v1/consulta/todos/clientes', DADOS,True);

        TThread.Synchronize(TThread.CurrentThread,
          procedure
          begin
            Carregando := False;
            lDados.Visible := True;
          end);
      end).Start;
  except
    on E: Exception do
    begin
      ShowMessage(E.Message);
      Carregando := False;
      lDados.Visible := False;
    end;

  end;

  tabPrincipal.TabIndex := 0;

end;

initialization

RegisterClass(TfrmCliente);

end.

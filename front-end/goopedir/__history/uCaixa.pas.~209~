procedure TfrmCaixa.BuscaCaixa;
begin
  DADOSCAIXA.Close;
  DADOSCAIXA.Open;

  dm.Caixa.Close;
  dm.GetSimples('/v1/caixa/historico/', HISTORICOCAIXAS);
  Layout2.Visible := False;
  rGerencial1.Visible := False;
  if dm.CodigoCaixa > 0 then
  begin
    // Aberto
    CodigoDoCaixa := dm.Caixa.FieldByName('id').AsInteger;
    lTipo.Text := 'Fechar Caixa';
    lStatusLateral.Text := 'Aberto';
    Layout2.Visible := True;
    lDataAbertura.Text := dm.Caixa.FieldByName('data_abertura').AsString + '  '
      + dm.Caixa.FieldByName('hora_abertura').AsString;
    lValorInicial.Text := 'R$ ' + FormatFloat('#0.00',
      dm.Caixa.FieldByName('valor_abertura').AsFloat);

    if dm.AbrirFecharCaixaAuto = 1 then
    begin
      if dm.Caixa.FieldByName('data_abertura').AsDateTime <> Date then
      begin

        if dm.FaturarPedidosAoFecharCaixa = 1 then
        begin
          dm.PostSimplesUnico('/v1/caixa/fechamento/pedido/automatico/' +
            CodigoDoCaixa.toString, nil);
          BuscaDadosCaixa;
        end;
        if DADOSPAGAMENTO.RecordCount > 0 then
        begin
          DADOSPAGAMENTO.First;
          while not DADOSPAGAMENTO.Eof do
          begin
            DADOSPAGAMENTO.Edit;
            DADOSPAGAMENTO.FieldByName('informado').AsFloat :=
              DADOSPAGAMENTO.FieldByName('total').AsFloat;
            DADOSPAGAMENTO.Post;
            DADOSPAGAMENTO.Next;
          end;
          FinalizaCaixa;
        end;

      end;

    end;

  end
  else
  begin
    // Abrir
    if dm.AbrirFecharCaixaAuto = 1 then
    begin
      rGerencial1.Visible := False;
      dm.PostSimples('/v1/caixa/abertura/' + dm.CodigoUsuario.toString + '/' +
        FloatToStr(dm.ValorInicialPadraoCaixa), nil);
      BuscaCaixa;
    end;

    lStatusLateral.Text := 'Fechado';
    rGerencial1.Visible := True;
    lTipo.Text := 'Abrir Caixa';

  end;

  Caixa;

end;

procedure TfrmCaixa.BuscaDadosCaixa;
var
  Requisicao: iRequisicao;
  Pedido: Real;
  Desconto: Real;
  Taxa: Real;
  Faturado: Real;
  TotalFinalizado: Real;
  TotalSaida: Real;
  TotalEntrada: Real;
begin

  TabControl1.TabIndex := 0;
  if BuscandoDados then
    exit;
  BuscandoDados := True;
  Pedido := 0;
  Desconto := 0;
  Taxa := 0;
  Faturado := 0;
  TotalFinalizado := 0;
  TotalSaida := 0;
  TotalEntrada := 0;
  try
    DADOSCAIXA.Close;
    Requisicao := iRequisicao.Create(nil);
    Requisicao.BaseURL := dm.CONEXAO.BaseURL;
    Requisicao.URL := '/v1/caixa/pedidos/dados/' + CodigoDoCaixa.toString;
    Requisicao.MemTable := DADOSCAIXA;
    Requisicao.Metodo := mGet;
    Requisicao.Execute;

    DADOSHISTORICO.Close;
    Requisicao := iRequisicao.Create(nil);
    Requisicao.BaseURL := dm.CONEXAO.BaseURL;
    Requisicao.URL := '/v1/caixa/pedidos/historico/' + CodigoDoCaixa.toString;
    Requisicao.MemTable := DADOSHISTORICO;
    Requisicao.Metodo := mGet;
    Requisicao.Execute;

    DADOSPAGAMENTO.Close;
    Requisicao := iRequisicao.Create(nil);
    Requisicao.BaseURL := dm.CONEXAO.BaseURL;
    Requisicao.URL := '/v1/caixa/pedidos/pagamento/' + CodigoDoCaixa.toString;
    Requisicao.MemTable := DADOSPAGAMENTO;
    Requisicao.Metodo := mGet;
    Requisicao.Execute;

  except

  end;
  Requisicao.Free;

  if DADOSCAIXA.RecordCount > 0 then
  begin
    DADOSCAIXA.DisableControls;
    DADOSCAIXA.First;
    while not DADOSCAIXA.Eof do
    begin
      Pedido := Pedido + DADOSCAIXA.FieldByName('valor_total_pedido').AsFloat;
      Desconto := Desconto + DADOSCAIXA.FieldByName('valor_desconto').AsFloat;
      Taxa := Taxa + DADOSCAIXA.FieldByName('valor_taxa_entrega').AsFloat;

      if DADOSCAIXA.FieldByName('id_caixa').AsFloat > 0 then
        Faturado := Faturado + DADOSCAIXA.FieldByName
          ('valor_total_pedido').AsFloat;

      DADOSCAIXA.Next;
    end;

    DADOSCAIXA.Last;
    DADOSCAIXA.EnableControls;
  end;

  if DADOSHISTORICO.RecordCount > 0 then
  begin
    DADOSHISTORICO.DisableControls;
    DADOSHISTORICO.First;
    while not DADOSHISTORICO.Eof do
    begin
      if not(DADOSHISTORICO.FieldByName('tipo').AsInteger in [0, 2, 3]) then
        TotalFinalizado := TotalFinalizado + DADOSHISTORICO.FieldByName
          ('valor').AsFloat;

      if (DADOSHISTORICO.FieldByName('tipo').AsInteger in [2]) then
        TotalSaida := TotalSaida + DADOSHISTORICO.FieldByName('valor').AsFloat;

      if (DADOSHISTORICO.FieldByName('tipo').AsInteger in [0, 3]) then
        TotalEntrada := TotalEntrada + DADOSHISTORICO.FieldByName
          ('valor').AsFloat;

      DADOSHISTORICO.Next;
    end;

    DADOSHISTORICO.EnableControls;
  end;
  TotalEntrada := TotalFinalizado + TotalEntrada + dm.Caixa.FieldByName
    ('valor_abertura').AsFloat;
  lTotalDesconto.Text := FormatFloat('#0.00', Desconto);
  LTaxa.Text := FormatFloat('#0.00', Taxa);
  LTotal.Text := FormatFloat('#0.00', (Pedido + Taxa) - Desconto);
  lTotalComputacional.Text := FormatFloat('#0.00', Faturado);
  lTotalFaturado.Text := FormatFloat('#0.00', TotalFinalizado);
  lTotalDiferenca.Text := FormatFloat('#0.00', TotalFinalizado - Faturado);
  lTotalEntrada.Text := FormatFloat('#0.00', TotalEntrada);
  lTotalSaida.Text := FormatFloat('#0.00', TotalSaida);
  lTotalDiferencaCaixa.Text := FormatFloat('#0.00', TotalEntrada - TotalSaida);

  if (TotalEntrada - TotalSaida) > 0 then
  begin

    lDadosDiferenca.FontColor := RGB(5, 168, 93);
    lTotalDiferencaCaixa.FontColor := RGB(5, 168, 93);
    lDadosDiferenca.Text := 'Diferença R$ [+]';
  end
  else
  begin
    lDadosDiferenca.Text := 'Diferença R$ [-]';
    lTotalDiferencaCaixa.FontColor := RGB(249, 65, 65);
    lDadosDiferenca.FontColor := RGB(249, 65, 65);
  end;

  if (TotalFinalizado - Faturado) > 0 then
  begin
    lTotalDiferenca.FontColor := RGB(5, 168, 93);
  end
  else
  begin
    lTotalDiferenca.FontColor := RGB(0, 0, 0);
  end;

  // Buscar Historico

  dm.GetSimples('/v1/motoboy/historico/' + FormatDateTime('ddmmyyyy',
    dm.Caixa.FieldByName('DATA_ABERTURA').AsDateTime), HISTORICOMOTOBOY);

  BuscandoDados := False;
end;

procedure TfrmCaixa.Button1Click(Sender: TObject);
var
  VisualizarCaixa: TfrmCaixa;
begin

  TThread.CreateAnonymousThread(
    procedure
    begin
      VisualizarCaixa := TfrmCaixa.Create(self);
      try
        VisualizarCaixa.CodigoDoCaixa := HISTORICOCAIXAS.FieldByName('id')
          .AsInteger;
        VisualizarCaixa.BuscaDadosCaixa;
        VisualizarCaixa.Visualizacao := True;
        VisualizarCaixa.ShowModal;
      finally
        VisualizarCaixa.Free;
      end;
    end).Start;

end;


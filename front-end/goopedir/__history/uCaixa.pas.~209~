procedure TfrmCaixa.StringGrid3DrawColumnCell(Sender: TObject;
const Canvas: TCanvas; const Column: TColumn; const Bounds: TRectF;
const Row: Integer; const Value: TValue; const State: TGridDrawStates);
var
  Cor: TColor;
  Valor: String;
begin
  case Column.Index of
    0:
      begin
        Cor := RGB(168, 16, 5);
        Valor := '#' + Value.toString;
        try
          if StrToInt(Value.toString) > 0 then
          begin
            Cor := RGB(5, 168, 93);
          end;

        except

        end;

        Canvas.Fill.Color := Cor;
        Canvas.Stroke.Color := Cor;
        Canvas.FillRect(Bounds, 0, 0, [], 1);
        Canvas.Fill.Color := TAlphaColorRec.Black;
        Canvas.FillText(Bounds, Valor, False, 1,
          [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
          TTextAlign.Center);

      end;
  end;
end;


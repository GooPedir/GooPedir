procedure TfrmCaixa.GraficoHistoricoCaixa;
var
  chart: TSuperChart;
  jsonStr, erro: string;
  Quant: Integer;
  Vl: String;
  Valor: Integer;
  Total: Real;
begin
  Quant := HISTORICOCAIXAS.RecordCount - 7;
  if not(HISTORICOCAIXAS.RecordCount > 1) then
    exit;

  try
    chart := TSuperChart.Create(lGrafico2, Lines);

    // Valores...
    chart.ShowValues := True;
    chart.FontSizeValues := 20;
    chart.FontColorValues := $FFFFFFFF;
    chart.FormatValues := 'R$ #,##0.00';

    // 164,0,27

    // Linhas...
    chart.LineColor := $FFA4001B;
    chart.ShowBackground := True;
    // chart.BackgroundColor := $FF4F5060;
    chart.RoundedBotton := True;
    chart.RoundedTop := True;

    // Argumentos...
    chart.FontSizeArgument := 18;
    chart.FontColorArgument := $FFFFFFFF;
    jsonStr := '';

    HISTORICOCAIXAS.First;
    Valor := 0;
    while not HISTORICOCAIXAS.Eof do
    begin
      inc(Valor);

function TfrmCaixa.ValidaTotalPagamento: Boolean;
var
  Computado: Real;
  Informado: Real;
begin

  if DADOSPAGAMENTO.RecordCount = 0 then
  begin
    Result := True;
    exit;
  end;

  Computado := 0;
  Informado := 0;
  DADOSPAGAMENTO.First;
  while not DADOSPAGAMENTO.Eof do
  begin
    Computado := Computado + DADOSPAGAMENTO.FieldByName('total').AsFloat;
    Informado := Informado + DADOSPAGAMENTO.FieldByName('informado').AsFloat;
    DADOSPAGAMENTO.Next;
  end;

  Result := Computado > Informado;
  DADOSPAGAMENTO.First;
end;


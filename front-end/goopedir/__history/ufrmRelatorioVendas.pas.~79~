procedure TfrmRelatorioVendas.MontarGraficoPedidoDia;
var
  chart: TSuperChart;
  jsonStr, erro: string;
  Quant: Integer;
  Vl: String;
  Mascara: String;

  ValorMedia: Real;

begin
  if not(PRODUTOS.RecordCount >= QtdRegistroGrafico) then
    exit;
  if not(PRODUTOS.RecordCount > 1) then
    exit;
  try
    chart := TSuperChart.Create(lGrafico2, Lines);

    // Valores...
    chart.ShowValues := true;
    chart.FontSizeValues := 20;
    chart.FontColorValues := $FFFFFFFF;
    chart.FormatValues := 'R$ #,##0.00';

    // 164,0,27

    // Linhas...
    chart.LineColor := $FFA4001B;
    chart.ShowBackground := true;
    // chart.BackgroundColor := $FF4F5060;
    chart.RoundedBotton := true;
    chart.RoundedTop := true;

    // Argumentos...
    chart.FontSizeArgument := 18;
    chart.FontColorArgument := $FFFFFFFF;
    jsonStr := '';

    if PEDIDOS.RecordCount > 15 then
    begin
      Mascara := 'dd/MM';
    end
    else
    begin
      Mascara := 'dd/mm/yyyy';
    end;

    PEDIDOS.First;
    Quant := 0;
    while not PEDIDOS.Eof do
    begin
      inc(Quant);
      ValorMedia := ValorMedia + PEDIDOS.FieldByName('total').AsFloat;

      Vl := PEDIDOS.FieldByName('total').AsString;
      Vl := StringReplace(Vl, ',', '.', [rfReplaceAll]);
      if length(jsonStr) = 0 then
        jsonStr := '{"field":"' + FormatDateTime(Mascara,
          PEDIDOS.FieldByName('data_pedido').AsDateTime) + '", "valor":'
          + Vl + '}'
      else
        jsonStr := jsonStr + ',{"field":"' + FormatDateTime(Mascara,
          PEDIDOS.FieldByName('data_pedido').AsDateTime) + '", "valor":'
          + Vl + '}';

      PEDIDOS.Next;
    end;

    ValorMedia := ValorMedia / PEDIDOS.RecordCount;

    lPedidoPeriodo.Text := lPedidoPeriodo.Text + ' - Média Diaria ' +
      FormatFloat(chart.FormatValues, ValorMedia);

    // Json...
    // jsonStr :=
    // '[{"field":"Jan", "valor":220}, {"field":"Fev", "valor":580}, {"field":"Mar", "valor":750},';
    // jsonStr := jsonStr +
    // '{"field":"Abr", "valor":600}, {"field":"Mai", "valor":700}, {"field":"Jun", "valor":800},';
    // jsonStr := jsonStr +
    // '{"field":"Jul", "valor":950}, {"field":"Ago", "valor":1100}, {"field":"Set", "valor":950},';
    // jsonStr := jsonStr +
    // '{"field":"Out", "valor":800}, {"field":"Nov", "valor":700}, {"field":"Dez", "valor":900}]';

    // Render do grafico...
    chart.LoadFromJSON('[' + jsonStr + ']', erro);

    if NOT erro.IsEmpty then
      showmessage(erro);

  finally
    chart.DisposeOf;
  end;
  CalculaTotal;
end;


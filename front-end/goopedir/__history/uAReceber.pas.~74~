begin
codigoUsuario := 0;
Buscar;
end;

procedure TfrmAReceber.Recebimento;
begin
  //
  dm.PostSimples('/v1/caixa/recebimento/pedido/' + dm.CodigoCaixa.ToString + '/'
    + DADOS.FieldByName('id').AsString + '/' + DADOS.FieldByName('id_pedido')
    .AsString, frmFechamentoPedido.PAG);

  Buscar;
end;


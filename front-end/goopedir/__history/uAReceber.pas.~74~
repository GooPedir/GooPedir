begin
  (Sender as TRectangle).Opacity := 1;
end;

procedure TfrmAReceber.Rectangle1MouseLeave(Sender: TObject);
begin
  (Sender as TRectangle).Opacity := 0.5;
end;

procedure TfrmAReceber.Rectangle2Click(Sender: TObject);
begin
  if NOT Assigned(FrmResumo) then
    Application.CreateForm(TFrmResumo, FrmResumo);
  FrmResumo.MESA := 0;
  FrmResumo.CodigoPedido := DADOS.FieldByName('id_pedido').AsInteger;
  FrmResumo.Show;
end;

procedure TfrmAReceber.rReceberClick(Sender: TObject);
begin
  if dm.CodigoCaixa = 0 then
  begin
    ShowMessageToast(frmmain, 'Não há caixa aberto!', 1);
    exit;
  end;

  if DADOS.FieldByName('status').AsInteger = 2 then
  begin
    ShowMessageToast(frmmain, 'Já foi recebido!', 1);
    exit;
  end;

  frmFechamentoPedido := TfrmFechamentoPedido.Create(Self);
  frmFechamentoPedido.Executar := Recebimento;
  frmFechamentoPedido.Cancelar := Cancelar;

  frmFechamentoPedido.CodigoPedido := DADOS.FieldByName('id_pedido').AsInteger;
  frmFechamentoPedido.Valor := DADOS.FieldByName('valor').AsFloat;

  frmFechamentoPedido.pago := 0;

  frmFechamentoPedido.Show;
  frmFechamentoPedido.Label3.Text := 'A Receber de ' + edtCliente.Text;
end;

procedure TfrmAReceber.SetAReceber(const Value: Real);
begin
  FAReceber := Value;

  lReceber.Text := 'R$ '+FormatarMoeda(Value);
end;

procedure TfrmAReceber.SetcodigoUsuario(const Value: Integer);
begin
  FcodigoUsuario := Value;
  if FcodigoUsuario = 0 then
  begin
    mConsultaCliente.Close;
    Buscar;
    exit;
  end;
  GetSimples('/v1/dados/consulta/cliente/' + codigoUsuario.ToString,
    mConsultaCliente);

  EdtCelular.Text := mConsultaCliente.FieldByName('celular_wpp').AsString;
  Buscar;
end;

procedure TfrmAReceber.SetRecebido(const Value: Real);
begin
  FRecebido := Value;
  LRecebido.Text := 'R$ '+FormatarMoeda(Value);
end;

procedure TfrmAReceber.StringGrid1CellDblClick(const Column: TColumn;
const Row: Integer);
begin
  EdtCelular.Text := DADOS.FieldByName('celular').AsString;
end;

procedure TfrmAReceber.StringGrid1DrawColumnCell(Sender: TObject;
const Canvas: TCanvas; const Column: TColumn; const Bounds: TRectF;
const Row: Integer; const Value: TValue; const State: TGridDrawStates);
begin

  case Column.Index of
    0:
      begin
        Canvas.Fill.Color := RGB(5, 168, 93);
        if StringGrid1.Cells[8, Row].ToInteger = 1 then
        begin
          // Valor := UpperCase(Lista.Cells[7, Row]);
          Canvas.Fill.Color := RGB(168, 16, 5);
        end;

        Canvas.Stroke.Color := Canvas.Fill.Color;
        Canvas.FillRect(Bounds, 0, 0, [], 1);
        Canvas.Fill.Color := TAlphaColorRec.Black;
        Canvas.FillText(Bounds, Value.ToString, False, 1,
          [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
          TTextAlign.Center);

      end;
  end;
end;


procedure TfrmAReceber.Buscar;
begin
  Carregando := True;
  dm.GetSimples('/v1/caixa/receber/' + codigoUsuario.ToString, DADOS);
  Carregando := False;
  DADOS.DisableControls;
  AReceber := 0;
  Recebido := 0;
  while not DADOS.Eof do
  begin
    if DADOS.FieldByName('status').AsInteger = 1 then
    begin
      AReceber := AReceber + DADOS.FieldByName('valor').AsFloat;
    end
    else
    begin
      Recebido := Recebido + DADOS.FieldByName('valor').AsFloat;
    end;
    DADOS.Next;
  end;
  DADOS.First;
  DADOS.EnableControls;
  DadosCaixa;

end;

procedure TfrmAReceber.BuscarCliente;
begin
  if ConsultaCliente then
    exit;
  ConsultaCliente := True;

  TThread.CreateAnonymousThread(
    procedure
    begin
      sleep(1000);
      mConsultaCliente.Close;
      GetSimples('v1/dados/consulta/cliente/celular/' + EdtCelular.Text,
        mConsultaCliente);
      // PegaDadosCliente;
      TThread.Synchronize(TThread.CurrentThread,
        procedure
        begin
          ConsultaCliente := False;
        end);
    end).Start;
end;

procedure TfrmAReceber.Cancelar;
begin

  Buscar;
end;

procedure TfrmAReceber.DADOSAfterScroll(DataSet: TDataSet);
begin
  DadosCaixa;
end;

procedure TfrmAReceber.DadosCaixa;
begin
  layReceberDados.Visible := DADOS.RecordCount > 0;
  if DADOS.RecordCount = 0 then
    exit;
  if Carregando then
    exit;
  edtCliente.Text := DADOS.FieldByName('nome').AsString;
  edtCelularCliente.Text := DADOS.FieldByName('celular').AsString;
  edtValorPedido.Text := FormatFloat('#0.00',
    DADOS.FieldByName('a_receber').AsFloat);

  edtNumeroCaixa.Text := '#' + DADOS.FieldByName('id_caixa').AsString;
  edtHoraCaixa.Text := FormatDateTime('dd/mm/yyyy', DADOS.FieldByName('data')
    .AsDateTime) + ' ' + FormatDateTime('hh:nn', DADOS.FieldByName('hora')
    .AsDateTime);
  EdtValorCaixa.Text := FormatFloat('#0.00', DADOS.FieldByName('valor')
    .AsFloat);
  EdtTipoPagamento.Text := DADOS.FieldByName('tipo_pagamento').AsString;
  EdtObservacao.Text := DADOS.FieldByName('observacao').AsString;

  case DADOS.FieldByName('status').AsInteger of
    1:
      begin
        rStatus.Fill.Color := RGB(168, 16, 5);
      end;
    2:
      begin
        rStatus.Fill.Color := RGB(5, 168, 93);
      end;
  end;
  // rStatus.Fill.Color := RGB(168, 16, 5);
  rStatus.Stroke.Color := rStatus.Fill.Color;

end;

procedure TfrmAReceber.EdtCelularKeyDown(Sender: TObject; var Key: Word;
var KeyChar: Char; Shift: TShiftState);
begin
  BuscarCliente;
end;


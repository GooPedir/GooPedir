procedure TDadosDashBoard.Execute;
Var
  JsonObject: TJSONObject;
  Body: String;
  Save: TBookmark;
  I: Integer;
begin
  inherited;

  while not Terminated do
  begin

    // frmPedido.rLoad.Visible := True;
    {
      try
      Requisicao.eTAG := True;
      Requisicao.URL := 'v1/total/' + FormatDateTime('ddmmyyyy',
      Pedido.DataInicial) + '/' + FormatDateTime('ddmmyyyy', Pedido.DataFinal)
      + '/' + FormatDateTime('hhmmss', Pedido.HoraInicial) + '/' +
      FormatDateTime('hhmmss', Pedido.HoraFinal);

      Requisicao.Metodo := mGet;
      Requisicao.Execute;

      JsonObject := TJSONObject.ParseJSONValue(Requisicao.Retorno)
      as TJSONObject;

      Pedido.PedidosTotal := JsonObject.GetValue('pedidos').Value.ToInteger;
      Pedido.PedidosWhatsapp := JsonObject.GetValue('pedidowhatsapp')
      .Value.ToInteger;
      Pedido.PedidosSite := JsonObject.GetValue('pedidossite').Value.ToInteger;
      Pedido.PedidosFicha := JsonObject.GetValue('pedidosficha')
      .Value.ToInteger;

      Pedido.DeliveryWhatsapp := JsonObject.GetValue('whatsappdelivery')
      .Value.ToExtended;
      Pedido.DeliverySite := JsonObject.GetValue('sitedelivery')
      .Value.ToExtended;

      Pedido.VemBuscarWhatsapp := JsonObject.GetValue('whatsappvembuscar')
      .Value.ToExtended;
      Pedido.VemBuscarSite := JsonObject.GetValue('sitevembuscar')
      .Value.ToExtended;

      Pedido.TotalWhatsapp := Pedido.VemBuscarWhatsapp +
      Pedido.DeliveryWhatsapp;
      Pedido.TotalSite := Pedido.VemBuscarSite + Pedido.DeliverySite;

      Pedido.TotalGeral := Pedido.TotalWhatsapp + Pedido.TotalSite +
      Pedido.TotalFicha;
      JsonObject.Free;
      except
      on E: Exception do
      begin
      showmessage(E.message);
      end;

      end; }
    if not NaoBuscar then
    begin
      try
        Requisicao.eTAG := True;
        Requisicao.URL := 'v1/pedidos/' + FormatDateTime('ddmmyyyy',
          Pedido.DataInicial) + '/' + FormatDateTime('ddmmyyyy',
          Pedido.DataFinal) + '/' + FormatDateTime('hhmmss', Pedido.HoraInicial)
          + '/' + FormatDateTime('hhmmss', Pedido.HoraFinal) + '/' +
          Pedido.getTipo + '/X';
        Requisicao.Metodo := mGet;

        Requisicao.MemTable2 := Memory;
        Requisicao.Execute;

        if Memory.RecordCount > 0 then
        begin
          Pedido.Lista.Visible := False;
          Pedido.bdsDados.DataSet := nil;

          if not Dados.Active then
            Dados.Open;

          Dados.DisableControls;
          Save := Dados.GetBookMark;
          while not Memory.Eof do
          begin
            if not Dados.Locate('codigo', Memory.FieldByName('codigo')
              .AsString, []) then
            begin
              Dados.Insert;
              Dados.FieldByName('selecionado').AsString := '0';
            end
            else
            begin
              Dados.Edit;
            end;
            for I := 0 to Dados.FieldCount - 1 do
            begin

              if Assigned(Memory.FindField(Dados.Fields[I].FieldName)) then
              begin
                try
                  Dados.FieldByName(Dados.Fields[I].FieldName).AsString :=
                    Memory.FieldByName(Dados.Fields[I].FieldName).AsString;
                except
                  on E: Exception do
                  begin
                    // ShowMessage(Memory.FieldByName(Dados.Fields[I].FieldName).AsString);
                  end;

                end;
              end;
            end;

            Dados.FieldByName('tempo').AsString :=
              SecondToTime(ConverteMysqlParaSegundo(Memory.FieldByName('tempo')
              .AsString));

            Dados.Post;
            Memory.Next;
          end;
          frmPedido.CarregaDadosPedidos(Pedido, Dados);

          Dados.GotoBookMark(Save);
          Dados.FreeBookmark(Save);
          Dados.EnableControls;
          Pedido.bdsDados.DataSet := Dados;
          Pedido.Lista.Visible := True;
        end;
      except

      end;
      Application.ProcessMessages;
      Pedido.Lista.SetFocus;
    end;
    // frmPedido.rLoad.Visible := False;
    Sleep(15 * 1000);
  end;

end;

function TDadosDashBoard.SecondToTime(Segundos: Cardinal): String;
var
  Seg, Min, Hora, Dia: Integer;
  Sobra: Real;
  Aux: String;

  AuxSoma: Integer;
  AHora: Boolean;
begin
  Hora := Segundos div 3600;
  Seg := Segundos mod 3600;
  Min := Seg div 60;
  Seg := Seg mod 60;
  Dia := Hora div 24;

  Sobra := ((Hora / 24) - Dia) * 24;

  Dia := (Dia * 24); // Hora
  Dia := (Dia * 60); // Minutos
  Dia := (Dia * 60); // Segundos

  Sobra := (Sobra * 60); // Minutos
  Sobra := (Sobra * 60); // Segundos

  Min := (Min * 60); // Segundos

  AuxSoma := Seg + Min + Dia;
  AuxSoma := (StrToInt(FloatToStr(Sobra)) div 1) + AuxSoma;

  Hora := AuxSoma div 3600;
  Seg := AuxSoma mod 3600;
  Min := Seg div 60;
  Seg := Seg mod 60;
  Dia := Hora div 24;
  Sobra := ((Hora / 24) - Dia) * 24;
  AHora := False;
  Aux := '';
  if Dia > 0 then
  begin
    Aux := Aux + FormatFloat('0d ', Dia);
  end;

  if Sobra > 0 then
  begin
    Aux := Aux + FormatFloat('00:', Sobra);
    AHora := True;
  end;

  if (Min > 0) or AHora then
  begin
    Aux := Aux + FormatFloat('00:', Min);
  end;

  if AHora then
    Aux := Aux + FormatFloat('00', Seg)
  else
    Aux := Aux + FormatFloat('00s', Seg);

  Result := Aux;

end;


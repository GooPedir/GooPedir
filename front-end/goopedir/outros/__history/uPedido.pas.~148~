procedure TfrmPedido.AlteracaoStatus(Sender: TObject);
var
  Status: Integer;
  SenhaGerente: Boolean;
begin
  Status := cStatus.CodItem.ToInteger;
  cStatus.HideMenu;
  case Status of
    0:
      begin

        if not Assigned(frmSenha) then
          frmSenha := TfrmSenha.Create(frmMain);
        frmSenha.Sim := CancelaPedido;
        frmSenha.Tipo := Validar;
        frmSenha.Show;
        exit;
      end
  else
    begin
      SenhaGerente := True;
    end;
  end;

  ShowMessageToast(Self, 'Pedido Atualizado Com Suceso!', 2);
  DM.PutSimples('v1/pedido/status/' + bdsDados.DataSet.FieldByName('codigo')
    .AsString + '/' + Status.ToString + '/', nil);

end;

procedure TfrmPedido.CancelaPedido;
begin
  ShowMessageToast(Self, 'Pedido Cancelado Com Suceso!', 2);
  DM.PutSimples('v1/pedido/status/' + bdsDados.DataSet.FieldByName('codigo')
    .AsString + '/0/', nil);
end;

procedure TfrmPedido.CarregaDadosPedidos(Form: TfrmPedido; Dados: iMemTable);
var
  Frame: TfrmListaPedido;
  Nome: String;
begin
  exit;
  if Dados.RecordCount = 0 then
    exit;
  if Dados.RecordCount > 60 then
  begin
    Form.verDadosPedido.Visible := False;
  end;

  Dados.First;
  while not Dados.Eof do
  begin
    try
      Nome := 'TfrmListaPedido' + Dados.FieldByName('codigo').AsString;
      Frame := Nil;
      if Assigned(Form.verDadosPedido.FindComponent(Nome)) then
      begin
        if (Form.verDadosPedido.FindComponent(Nome) is TfrmListaPedido) then
        begin
          Frame := (Form.verDadosPedido.FindComponent(Nome) as TfrmListaPedido);
        end;

      end;

      if not Assigned(Frame) then
      begin
        Frame := TfrmListaPedido.Create(Form.verDadosPedido);
        Frame.Parent := Form.verDadosPedido;
        Frame.Align := TAlignLayout.Top;
        Frame.Position.Y := 99999;
        Frame.Name := Nome;
      end;

      Frame.Origem := Dados.FieldByName('origem').AsInteger;
      Frame.Tipo := Dados.FieldByName('tipo').AsString;
      Frame.Codigo := Dados.FieldByName('codigo').AsInteger;
      Frame.CodigoDia := Dados.FieldByName('codigo_dia').AsInteger;
      Frame.Data := Dados.FieldByName('data').AsDateTime;
      Frame.Hora := Dados.FieldByName('hora').AsDateTime;
      Frame.Tempo := Dados.FieldByName('tempo').AsString;
      Frame.Status := Dados.FieldByName('status_descricao').AsString;
      Frame.Cliente := Dados.FieldByName('cliente').AsString;
      Frame.Endereco := Dados.FieldByName('endereco_completo').AsString;
      Frame.Valor := Dados.FieldByName('valor').AsFloat;
      Frame.Taxa := Dados.FieldByName('taxa').AsFloat;
      Frame.Desconto := Dados.FieldByName('desconto').AsFloat;
      Frame.Total := Dados.FieldByName('total').AsFloat;
      Frame.MOTOBOY := Dados.FieldByName('motoboy').AsString;
      Frame.Selecionado := Dados.FieldByName('selecionado').AsInteger;
      Frame.Caixa := Dados.FieldByName('id_caixa').AsInteger;
      Frame.Clique := Form.Selecionou;

      {



        property Motoboy: String read FMotoboy write SetMotoboy;
        property Selecionado: Integer read FSelecionado write SetSelecionado;
      }

    except
      on E: Exception do
      begin
        ShowMessage(E.Message);
      end;

    end;
    Dados.Next;
  end;
  if not Form.verDadosPedido.Visible then
    Form.verDadosPedido.Visible := True;
end;


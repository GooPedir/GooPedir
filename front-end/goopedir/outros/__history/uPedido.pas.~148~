function TfrmPedido.SelecionaMotoboy: Boolean;
begin
  Result := img_motoboy.Tag > 0;
end;

procedure TfrmPedido.Selecionou;
begin
  case img_motoboy.Tag of
    0:
      begin
        // Desmarcado
        if NOT Assigned(FrmResumo) then
          Application.CreateForm(TFrmResumo, FrmResumo);
        FrmResumo.MESA := 0;
        FrmResumo.CodigoPedido := Dados.FieldByName('codigo').AsInteger;
        FrmResumo.Show;
      end
  else
    begin
      if Dados.FieldByName('tipo').AsString = 'Delivery' then
      begin
        if SelecionaMotoboy then
        begin
          Dados.Edit;

          case Dados.FieldByName('selecionado').AsInteger of
            0:
              begin
                Dados.FieldByName('selecionado').AsInteger := 1;
              end
          else
            begin
              Dados.FieldByName('selecionado').AsInteger := 0;
            end;

          end;

          Dados.Post;
        end;
      end;
    end;
  end;
end;

procedure TfrmPedido.SetaMotoboy(Sender: TObject);
begin
  cMotoboy.HideMenu;

  if SelecionaMotoboy then
  begin
    DadosDashBoard.NaoBuscar := True;
    Dados.DisableControls;
    Dados.First;

    while not Dados.Eof do
    begin
      if Dados.FieldByName('selecionado').AsInteger = 1 then
      begin
        DM.PutSimples('v1/pedido/motoboy/' + bdsDados.DataSet.FieldByName
          ('codigo').AsString + '/' + cMotoboy.CodItem + '/', nil);
        Dados.Edit;
        Dados.FieldByName('selecionado').AsInteger := 0;
        Dados.Post;
      end;
      Dados.Next;
    end;

    Dados.EnableControls;
    DadosDashBoard.NaoBuscar := False;
  end
  else
  begin
    DM.PutSimples('v1/pedido/motoboy/' + bdsDados.DataSet.FieldByName('codigo')
      .AsString + '/' + cMotoboy.CodItem + '/', nil);
  end;

  ShowMessageToast(Self, cMotoboy.DescrItem +
    ' motoboy adicionado com sucesso ao ' + LowerCase(cMotoboy.SubTitleMenuText)
    + '!', 2);

end;


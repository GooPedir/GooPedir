function TfrmPedido.getTipo: String;
begin
  Result := '';
  if cWhatsapp.IsChecked then
    if Result = '' then
      Result := '1'
    else
      Result := Result + ',1';

  if cSite.IsChecked then
    if Result = '' then
      Result := '2'
    else
      Result := Result + ',2';

  if cFicha.IsChecked then
    if Result = '' then
      Result := '3'
    else
      Result := Result + ',3';

  if length(Result) = 0 then
    Result := '1,2,3';

end;


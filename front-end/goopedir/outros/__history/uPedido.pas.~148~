function TDadosDashBoard.ConverteMysqlParaSegundo(Dados: String): Integer;
var
  I: Integer;
  TotalVirgula: Integer;
  Aux: String;
  AuxHora: String;
  AuxMinuto: String;

begin
  // 470:15:00.000000
  TotalVirgula := 0;
  Aux := '';
  for I := 1 to length(Dados) - 1 do
  begin
    if Dados[I] = ':' then
    begin
      inc(TotalVirgula);
    end;
    if Dados[I] = '.' then
    begin
      break;
    end;
    Aux := Aux + Dados[I];
  end;

  Result := 0;
  AuxHora := Copy(Aux, 0, Pos(':', Aux) - 1);
  Aux := Copy(Aux, Pos(':', Aux) + 1, length(Aux));
  AuxMinuto := Copy(Aux, 0, Pos(':', Aux) - 1);
  Aux := Copy(Aux, Pos(':', Aux) + 1, length(Aux));

  Result := (StrToInt(AuxHora) * 60) * 60;
  Result := Result + (StrToInt(AuxMinuto) * 60) + StrToInt(Aux);

end;


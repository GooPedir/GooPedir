procedure TfrmDashBoard.DadosMedia;
var
  t: TThread;
begin
  t := TThread.CreateAnonymousThread(
    procedure
    var
      CONEXAO: iRequisicao;
      Dados: TFDMemTable;

      DataInicial: TDateTime;
      Hoje: Integer;
      DataComeco: TDateTime;
      DataFim: TDateTime;
      I: Integer;
      Datas: Array of String;
      DiaDaSemana: String;

    begin
      CONEXAO := iRequisicao.Create(nil);
      CONEXAO.BaseURL := dm.CONEXAO.BaseURL;

      Dados := TFDMemTable.Create(nil);
      CONEXAO.URL := '/v1/dashboard';
      CONEXAO.MemTable2 := Dados;
      CONEXAO.Metodo := mGet;
      CONEXAO.Execute;
      lProdutoPausado.Text := Dados.FieldByName('pausado').AsString;
      lTotalMotoboy.Text := Dados.FieldByName('motoboy').AsString;

      lCategoria.Text := Dados.FieldByName('categoria').AsString;
      lTaxa.Text := Dados.FieldByName('taxa').AsString;
      lMesas.Text := Dados.FieldByName('mesa').AsString;

      lTipoPagamento.Text := Dados.FieldByName('pagamento').AsString;
      lImpressora.Text := Dados.FieldByName('impressora').AsString;

      lPedidosMesAtual.Text := Dados.FieldByName('pedidos_mes_atual').AsString;
      lPedidosMesAnterior.Text :=
        Dados.FieldByName('pedidos_mes_anterior').AsString;

      Dados.Free;

      CONEXAO.URL := '/v1/media/pedido';
      Dados := TFDMemTable.Create(nil);

      Hoje := DayOfWeek(date);
      DataComeco := date - Hoje;
      DataFim := DataComeco + 7;

      setlength(Datas, 7);

      while not(DataComeco = DataFim) do
      begin
        // DayOfWeek(Hoje)
        DataInicial := DataComeco - 30;
        while not(DataInicial = DataComeco) do
        begin

          if DayOfWeek(DataInicial) = DayOfWeek(DataComeco) then
          begin

            if length(Datas[DayOfWeek(DataInicial) - 1]) = 0 then
            begin
              Datas[DayOfWeek(DataInicial) - 1] :=
                QuotedStr(FormatDateTime('yyyy-mm-dd', DataInicial));
            end
            else
            begin
              Datas[DayOfWeek(DataInicial) - 1] :=
                Datas[DayOfWeek(DataInicial) - 1] + ',' +
                QuotedStr(FormatDateTime('yyyy-mm-dd', DataInicial));
            end;

          end;

          DataInicial := DataInicial + 1;
        end;

        DataComeco := DataComeco + 1;
      end;

      for I := 0 to 6 do
      begin
        Dados.Close;
        CONEXAO.BODY(Datas[I]);
        CONEXAO.MemTable2 := Dados;
        CONEXAO.Metodo := mGet;
        CONEXAO.Execute;
        // ShowMessage(CONEXAO.Retorno);

        case I of
          0:
            DiaDaSemana := 'domingo';
          1:
            DiaDaSemana := 'segunda';
          2:
            DiaDaSemana := 'terca';
          3:
            DiaDaSemana := 'quarta';
          4:
            DiaDaSemana := 'quinta';
          5:
            DiaDaSemana := 'sexta';
          6:
            DiaDaSemana := 'sabado';
        end;

        if Assigned(Self.FindComponent('lMedia' + DiaDaSemana)) then
        begin
          if Dados.FieldByName('media').IsNull then
            (Self.FindComponent('lMedia' + DiaDaSemana) as TLabel).Text := '0'
          else
            (Self.FindComponent('lMedia' + DiaDaSemana) as TLabel).Text :=
              Dados.FieldByName('media').AsString;
        end;

        if Assigned(Self.FindComponent('lMedia' + DiaDaSemana + 'Cancelado'))
        then
        begin
          if Dados.FieldByName('media_cancelado').IsNull then
            (Self.FindComponent('lMedia' + DiaDaSemana + 'Cancelado') as TLabel)
              .Text := '0,00%'
          else
            (Self.FindComponent('lMedia' + DiaDaSemana + 'Cancelado') as TLabel)
              .Text := FormatFloat('#0.00%',
              Dados.FieldByName('media_cancelado').AsFloat);
        end;

        if Assigned(Self.FindComponent('lMedia' + DiaDaSemana + 'Cancelado'))
        then
        begin
          if Dados.FieldByName('media_concluido').IsNull then
            (Self.FindComponent('lMedia' + DiaDaSemana + 'Concluido') as TLabel)
              .Text := '0,00%'
          else
            (Self.FindComponent('lMedia' + DiaDaSemana + 'Concluido') as TLabel)
              .Text := FormatFloat('#0.00%',
              Dados.FieldByName('media_concluido').AsFloat);
        end;

      end;

      layHistorico.Visible := True;
    end);
  t.OnTerminate := OnFinis;
   t.Start;
//  OnFinis(Self);

end;


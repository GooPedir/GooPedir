procedure TfrmDashBoard.SetMesesPrevisao(const Value: Integer);
begin
  FMesesPrevisao := Value;
  lUltimosMesesText.Text := 'Ultimos ' + MesesPrevisao.ToString + ' meses';
end;

procedure TfrmDashBoard.SetPrevisaoHoje(const Value: Integer);
begin
  FPrevisaoHoje := Value;
  try
    FPrevisaoHoje := FPrevisaoHoje div MesesPrevisao;
  except

  end;
  lUltimosMeses.Text := (Value div MesesPrevisao).ToString;
end;

procedure TfrmDashBoard.SetPrevisaoUltimosMeses(const Value: Integer);
begin
  FPrevisaoUltimosMeses := Value;
  lPedidoHoje.Text := FPrevisaoUltimosMeses.ToString;
  try
    lPercentual.Text := FormatFloat('#0.00 %',
      (((FPrevisaoHoje - FPrevisaoUltimosMeses) * 100) / FPrevisaoHoje));
  except
    lPercentual.Text := '0,00 %';
  end;
end;

function TfrmDashBoard.ValidaData(Data: TDate): Boolean;
Var
  DiaAtualSemana: Integer;
  DiaValidaSemana: Integer;

  SemanaAtual: Integer;
  SemanaValida: Integer;
begin
  Result := False;

  DiaAtualSemana := DayOfWeek(date);

  DiaValidaSemana := DayOfWeek(Data);

  if DiaAtualSemana <> DiaValidaSemana then
  begin
    exit;
  end;

  SemanaAtual := (StrToInt(FormatDateTime('dd', date)) - 1) div 7 + 1;
  SemanaValida := (StrToInt(FormatDateTime('dd', Data)) - 1) div 7 + 1;

  if SemanaAtual <> SemanaValida then
    exit;

  Result := True;

end;

{ TPrevisaoPedidoTThread }

constructor TPrevisaoPedidoTThread.Create;
begin
  inherited Create(True);
  CONEXAO := iRequisicao.Create(nil);
  CONEXAO.BaseURL := dm.CONEXAO.BaseURL;
  Dados := TFDMemTable.Create(nil);
  CONEXAO.URL := '/v1/dashboard/previsao/';
end;

destructor TPrevisaoPedidoTThread.Destroy;
begin

  inherited;
end;

procedure TPrevisaoPedidoTThread.Execute;
var
  ValorString: String;
  MesAtras6: TDateTime;
  DiasValidos: String;
  DataAtual: TDateTime;
begin
  inherited;

  while not Terminated do
  begin
    if DataAtual <> date then
    begin
      MesAtras6 := StrToDate('01' + FormatDateTime('/mm/yyyy',
        IncMonth(date, -Formulario.MesesPrevisao)));
      DiasValidos := '';
      while not(MesAtras6 = date) do
      begin
        if Formulario.ValidaData(MesAtras6) then
        begin
          if length(DiasValidos) > 0 then
            DiasValidos := DiasValidos + ',' +
              QuotedStr(FormatDateTime('yyyy-mm-dd', MesAtras6))
          else
            DiasValidos := QuotedStr(FormatDateTime('yyyy-mm-dd', MesAtras6))
        end;

        MesAtras6 := MesAtras6 + 1;

      end;
      DataAtual := date;
    end;

    try
      Dados.Close;
      CONEXAO.BODY(DiasValidos);
      CONEXAO.MemTable2 := Dados;
      CONEXAO.Execute;

      Formulario.PrevisaoHoje := Dados.FieldByName('previsao').AsInteger;
      try
        Formulario.PrevisaoUltimosMeses := Dados.FieldByName('atual').AsInteger;
      except

      end;
    except

    end;
    // ValorString := 'Ultimos ' + Formulario.MesesPrevisao.ToString + ' meses';
    // Formulario.lUltimosMesesText.Text := ValorString;

    Sleep(60 * 1000);
  end;

end;


procedure TFrmAddItem.AddCategoriaLv(id_categoria: Integer; descricao: string;
  icone: TStream);
var
  bmp: TBitmap;
  Index: Integer;
  CATEGORIA: TframeCategorias;
begin
  // ArrayofCategoria : Array of TframeCategorias;
  SetLength(ArrayofCategoria, length(ArrayofCategoria) + 1);
  Index := length(ArrayofCategoria) - 1;

  if Assigned(VertCategorias.FindComponent('Categoria' + id_categoria.ToString))
  then
  begin
    VertCategorias.FindComponent('Categoria' + id_categoria.ToString).Free;
  end;

  ArrayofCategoria[Index] := TframeCategorias.Create(VertCategorias);
  CATEGORIA := ArrayofCategoria[Index];
  CATEGORIA.Parent := VertCategorias;
  CATEGORIA.descricao := descricao;
  CATEGORIA.Align := TAlignLayout.Top;
  CATEGORIA.Name := 'Categoria' + id_categoria.ToString;
  CATEGORIA.rPrincipal.OnClick := ClickCategoria;

{$IFDEF Android}
  CATEGORIA.rPrincipal.OnTap := OnTapCategoria;
{$ELSE}
  CATEGORIA.rPrincipal.OnClick := ClickCategoria;
{$ENDIF}
  CATEGORIA.Codigo := id_categoria;

  with lv_categoria.Items.Add do
  begin
    Tag := id_categoria;
    if Assigned(Objects.FindDrawable('TxtDescricao')) then
    begin
      TListItemText(Objects.FindDrawable('TxtDescricao')).Text := descricao;
    end;

    // Icone...
    if icone <> nil then
    begin
      bmp := TBitmap.Create;
      bmp.LoadFromStream(icone);
      // Somente se for carregado em tempo de execucao
      TListItemImage(Objects.FindDrawable('ImgIcone')).OwnsBitmap := true;
      TListItemImage(Objects.FindDrawable('ImgIcone')).Bitmap := bmp;
    end;
  end;
end;

procedure TFrmAddItem.LimpaDados;
var
  I: Integer;
begin

  for I := 0 to TotalComponente do
  begin
    if Assigned(FindComponent('DINAMIC_' + FormatFloat('0000', I))) then
    begin
      FindComponent('DINAMIC_' + FormatFloat('0000', I)).Free;
    end;
  end;
  TotalComponente := 0;
  TabControl.Visible := true;
  vertProdutos := nil;
end;

procedure TFrmAddItem.ListarCategoria;
var
  x: Integer;
  icone: TStream;
  I: Integer;

begin
  exit;
  if length(ArrayofCategoria) = 0 then
  begin

    CATEGORIA.Close;

    GetSimples('v1/categorias/', CATEGORIA);
    if not FastItens then
    begin

      lv_categoria.Items.Clear;

      icone := TMemoryStream.Create;
      img_icone.Bitmap.SaveToStream(icone);
      icone.Position := 0;

      for I := 0 to length(ArrayofCategoria) - 1 do
      begin
        try
          if Assigned(ArrayofCategoria[I]) then
            ArrayofCategoria[I].Free;
        except

        end;
      end;

      while not CATEGORIA.Eof do
      begin
        //
        AddCategoriaLv(CATEGORIA.FieldByName('codigo').AsInteger,
          CATEGORIA.FieldByName('descricao').AsString, icone);
        CATEGORIA.Next;
      end;
      icone.disposeof;
    end;
  end;
end;

procedure TFrmAddItem.AddProduto(Codigo: Integer);
var
  I: Integer;
  LabelDesc: TLabel;
  Check: TCheckBox;
  MemoDes: TMemo;

  descricao: String;

  DescricaoCheck: String;
  CodigoPai: Integer;

  DescricaoAdicional: TFrameDescricaoAdicional;
  DescricaoAdicionalItem: TframeExtra;
  ValorSabor: Real;
begin
  // Exibir a confirmacao + Qtd...
  PodeAdicionarDireto := true;
  for I := 0 to rDadosAddProduto.ComponentCount - 1 do
  begin
    if rDadosAddProduto.Components[I] is TVertScrollBox then
      (rDadosAddProduto.Components[I] as TVertScrollBox).Visible := False;

  end;
  ValorFaltando := '';
  PRODUTO.Locate('codigo', Codigo.ToString, []);
  lbl_qtd.Text := '01';
  lbl_descricao.Text := PRODUTO.FieldByName('nome').AsString;
  layout_qtd.Visible := true;
  TabControl.Visible := False;
  // layout_qtd.Tag
  // LimpaDados;

  if length(lbl_descricao.Text) = 0 then
    lbl_descricao.Text := PRODUTO.FieldByName('nome_produto').AsString;

  ValorView := 0;
  QTDView := 1;
  ValorViewAdicional := 0;

  TabControl.Visible := False;
  ValorView := PRODUTO.FieldByName('venda').AsFloat;
  if (ValorView = 0) and (PRODUTO.FieldByName('valor_venda').AsFloat > 0) then
    ValorView := PRODUTO.FieldByName('valor_venda').AsFloat;

  ValorProdutoUnitario := ValorView;

  codigoProduto := Codigo;
  ADICIONAL.Close;
  SABORES.Close;
  GetSimples('v1/produtos/sabores/' + Codigo.ToString, SABORES);
  GetSimples('v1/produtos/adicional/' + codigoProduto.ToString, ADICIONAL);

  if ADICIONAL.RecordCount > 0 then
    PodeAdicionarDireto := False;
  if SABORES.RecordCount > 0 then
    PodeAdicionarDireto := False;

  if Assigned(rDadosAddProduto.FindComponent('VerticalProduto' +
    Codigo.ToString)) then
  begin
    // Achou
    vertProdutos := rDadosAddProduto.FindComponent
      ('VerticalProduto' + Codigo.ToString) as TVertScrollBox;
    vertProdutos.Visible := true;
  end
  else
  begin
    // Não Achou
    if not Assigned(vertProdutos) then
      vertProdutos := TVertScrollBox.Create(rDadosAddProduto);
    vertProdutos.Parent := rDadosAddProduto;
    vertProdutos.Align := TAlignLayout.Client;
    vertProdutos.Margins.Top := 5;
    vertProdutos.Margins.Left := 5;
    vertProdutos.Margins.Right := 5;
    vertProdutos.Margins.Bottom := 5;
    vertProdutos.Name := 'VerticalProduto' + Codigo.ToString;

    TotalComponente := 0;
    if SABORES.FieldByName('quantidade_sabores').AsInteger > 0 then
    begin
      ValorView := 0;
      DescricaoAdicional := TFrameDescricaoAdicional.Create(vertProdutos);
      DescricaoAdicional.Parent := vertProdutos;
      // DescricaoAdicional.CodigoAdicional := SABORES.FieldByName('id').AsInteger;
      DescricaoAdicional.Minimo := SABORES.FieldByName('quantidade_sabores')
        .AsInteger;
      DescricaoAdicional.Maximo := SABORES.FieldByName('quantidade_sabores')
        .AsInteger;
      DescricaoAdicional.descricao := 'Selecione os Sabores';
      DescricaoAdicional.Name := 'DescSabores' + SABORES.FieldByName
        ('id').AsString;
      DescricaoAdicional.Align := TAlignLayout.Top;

      ValorSabor := 0;
      if dm.DADOS_WHATSAPP.FieldByName('tipo_preco_pizza').AsInteger = 1 then
      begin
        //
        while not SABORES.Eof do
        begin
          if SABORES.FieldByName('vl_venda').AsFloat > ValorSabor then
            ValorSabor := SABORES.FieldByName('vl_venda').AsFloat;
          SABORES.Next;
        end;
      end;
      SABORES.First;
      while not SABORES.Eof do
      begin

        DescricaoAdicionalItem := TframeExtra.Create(vertProdutos);
        DescricaoAdicionalItem.descricao := DescricaoCheck;
        DescricaoAdicionalItem.Sabor := SABORES.FieldByName('nome').AsString;
        DescricaoAdicionalItem.CategoriaSabor :=
          SABORES.FieldByName('descricao').AsString;
        DescricaoAdicionalItem.Codigo := SABORES.FieldByName('id').AsInteger;
        DescricaoAdicionalItem.Tipo := Pizza;
        DescricaoAdicionalItem.TipoValor := dm.DADOS_WHATSAPP.FieldByName
          ('tipo_preco_pizza').AsInteger;
        DescricaoAdicionalItem.Pai := DescricaoAdicional;;
        if dm.DADOS_WHATSAPP.FieldByName('tipo_preco_pizza').AsInteger = 1 then
        begin
          DescricaoAdicionalItem.Valor := ValorSabor;
        end
        else
          DescricaoAdicionalItem.Valor :=
            SABORES.FieldByName('vl_venda').AsFloat;

        DescricaoAdicionalItem.Quantidade := 0;
        DescricaoAdicionalItem.Parent := vertProdutos;
        DescricaoAdicionalItem.Name := 'Sabores' + SABORES.FieldByName('id')
          .AsString + Codigo.ToString;
        DescricaoAdicionalItem.Align := TAlignLayout.Top;
        DescricaoAdicionalItem.AtualizaValo := AtualizarValores;

        SABORES.Next;
      end;
    end;

    descricao := '';
    while not ADICIONAL.Eof do
    begin
      if descricao <> trim(ADICIONAL.FieldByName('categoria').AsString) then
      begin
        descricao := trim(ADICIONAL.FieldByName('categoria').AsString);

        DescricaoAdicional := TFrameDescricaoAdicional.Create(vertProdutos);
        DescricaoAdicional.Parent := vertProdutos;
        DescricaoAdicional.Minimo := ADICIONAL.FieldByName('min').AsInteger;
        DescricaoAdicional.Maximo := ADICIONAL.FieldByName('max').AsInteger;
        DescricaoAdicional.descricao :=
          ADICIONAL.FieldByName('categoria').AsString;
        DescricaoAdicional.CodigoAdicional := ADICIONAL.FieldByName('codigo')
          .AsInteger;
        DescricaoAdicional.Align := TAlignLayout.Top;

      end;
      DescricaoCheck := (trim(ADICIONAL.FieldByName('nome').AsString));
      // DescricaoAdicional: Array of TFrameDescricaoAdicional;

      DescricaoAdicionalItem := TframeExtra.Create(vertProdutos);
      DescricaoAdicionalItem.descricao := DescricaoCheck;
      DescricaoAdicionalItem.Codigo := ADICIONAL.FieldByName('codigo')
        .AsInteger;
      DescricaoAdicionalItem.Valor := ADICIONAL.FieldByName('valor').AsFloat;
      DescricaoAdicionalItem.Pai := DescricaoAdicional;;
      DescricaoAdicionalItem.Quantidade := 0;

      DescricaoAdicionalItem.Parent := vertProdutos;
      DescricaoAdicionalItem.Name := 'Extra' + ADICIONAL.FieldByName('codigo')
        .AsString + Codigo.ToString;
      DescricaoAdicionalItem.Align := TAlignLayout.Top;
      DescricaoAdicionalItem.AtualizaValo := AtualizarValores;
      DescricaoAdicionalItem.CATEGORIA := descricao;

      ADICIONAL.Next;
    end;

    if ADICIONAL.FieldByName('observacao').AsInteger = 1 then
    begin
      PodeAdicionarDireto := False;
      ObservacaoPedido := TframeObservacaoPedido.Create(vertProdutos);
      ObservacaoPedido.Name := 'ObservacaoPedido' + Codigo.ToString;
      ObservacaoPedido.Align := TAlignLayout.Top;
      ObservacaoPedido.Parent := vertProdutos;

    end;

  end;

  if dadosSelecionado.RecordCount > 0 then
  begin

    for I := 0 to vertProdutos.ComponentCount - 1 do
    begin
      if (vertProdutos.Components[I] is TframeExtra) then
      begin
        dadosSelecionado.First;
        while not dadosSelecionado.Eof do
        begin
          if UpperCase((vertProdutos.Components[I] as TframeExtra).CATEGORIA)
            = UpperCase(dadosSelecionado.FieldByName('nomeclatura').AsString)
          then
            if UpperCase(dadosSelecionado.FieldByName('descricao').AsString)
              = UpperCase((vertProdutos.Components[I] as TframeExtra).descricao)
            then
            begin
              (vertProdutos.Components[I] as TframeExtra).Mais;
            end;

          dadosSelecionado.Next;
        end;
      end;
      if (vertProdutos.Components[I] is TframeObservacaoPedido) then
      begin
        dadosSelecionado.First;
        while not dadosSelecionado.Eof do
        begin
          dadosSelecionado.Next;
        end;
      end;

    end;

  end;

  if PodeAdicionarDireto then
  begin
    AdicionarProdutoPedido;
  end;
end;

procedure TFrmAddItem.AddProdutoLv(id_produto: Integer; descricao: string;
  preco: double);
begin
  with lv_produto.Items.Add do
  begin
    Tag := id_produto;
    TListItemText(Objects.FindDrawable('TxtDescricao')).Text := descricao;

    TListItemText(Objects.FindDrawable('TxtPreco')).Text :=
      FormatFloat('R$ #,##0.00', preco);
    TListItemImage(Objects.FindDrawable('ImgAdd')).Bitmap := img_add.Bitmap;
  end;
end;

procedure TFrmAddItem.AdicionarProdutoPedido;
begin
  if not ValidaSePodeAdicionar then
    exit;
  if not dm.TestaConexao then
  begin
    ShowMessageToast(self, 'Sem conexão com servidor!', 1);

  end
  else
  begin
    frmSimNao.titulo := 'Confirmação';
    frmSimNao.descricao := 'Deseja adicionar o ' + lbl_descricao.Text +
      ' ao pedido?';
    frmSimNao.Sim := Confirmacao;
    frmSimNao.Show;
  end;
end;

procedure TFrmAddItem.AtualizarValores;
var
  Valor: Real;
  I: Integer;
begin
  ValorViewAdicional := 0;
  for I := 0 to vertProdutos.ComponentCount - 1 do
  begin

    if (vertProdutos.Components[I] is TframeExtra) then
    begin
      if ((vertProdutos.Components[I] as TframeExtra).Quantidade > 0) then
      begin
        ValorViewAdicional := ValorViewAdicional +
          (vertProdutos.Components[I] as TframeExtra).ValorTotal;
      end;
    end;
  end;

  Valor := (ValorView + ValorViewAdicional) * QTDView;
  lTotal.Text := 'R$ ' + FormatFloat('#0.00', Valor);
end;

procedure TFrmAddItem.AtualizaValorView;
var
  Valor: Real;
  I: Integer;
begin


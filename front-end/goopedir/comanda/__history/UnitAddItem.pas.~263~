procedure TFrmAddItem.Confirmacao;
var
  I: Integer;
  K: Integer;
  Produtos: TFrameProdutos;
  Extra: TframeExtra;
begin
  rTelaPreta.Visible := true;

  // OcultaProdutos;

  memInsert.Close;
  memInsert.Open;
  memInsert.insert;
  memInsert.FieldByName('mesa').AsInteger := comanda;
  memInsert.FieldByName('pedido').AsInteger := codigoPedido;
  memInsert.FieldByName('produto').AsInteger := codigoProduto;
  memInsert.FieldByName('valor_produto').AsFloat := ValorProdutoUnitario;
  try
    memInsert.FieldByName('qtd').AsInteger := lbl_qtd.Text.ToInteger;
  except
    memInsert.FieldByName('qtd').AsInteger := 1;
  end;

  for I := 0 to vertProdutos.ComponentCount - 1 do
  begin
    if vertProdutos.Components[I] is TframeExtra then
    begin
      Extra := (vertProdutos.Components[I] as TframeExtra);

      if Extra.Tipo = Pizza then
      begin
        for K := 1 to Extra.Quantidade do
        begin

          if length(memInsert.FieldByName('pizza').AsString) = 0 then
          begin
            memInsert.FieldByName('pizza').AsString := Extra.Codigo.ToString;
          end
          else
          begin
            memInsert.FieldByName('pizza').AsString :=
              memInsert.FieldByName('pizza').AsString + ',' +
              Extra.Codigo.ToString;
          end;
        end;
        Extra.Quantidade := 0;
        Extra.ValorTotal := 0;
        Extra.Pai.ZerarSelecionado;
      end
      else
      begin
        for K := 1 to Extra.Quantidade do
        begin
          if length(memInsert.FieldByName('adicionais').AsString) = 0 then
          begin
            memInsert.FieldByName('adicionais').AsString :=
              Extra.Codigo.ToString;
          end
          else
          begin
            memInsert.FieldByName('adicionais').AsString :=
              memInsert.FieldByName('adicionais').AsString + ',' +
              Extra.Codigo.ToString;
          end;
        end;
        Extra.Quantidade := 0;
        Extra.ValorTotal := 0;
        Extra.Pai.ZerarSelecionado;
      end;

    end;
    if vertProdutos.Components[I] is TframeObservacaoPedido then
    begin
      memInsert.FieldByName('observacao').AsString :=
        (vertProdutos.Components[I] as TframeObservacaoPedido).memMensagem.Text;
      (vertProdutos.Components[I] as TframeObservacaoPedido)
        .memMensagem.Text := '';
    end;

  end;

  layout_qtd.Visible := False;
  PostSimples('/v1/pedido/produto/:usuario', memInsert);
  Delivery := 0;

  LimpaDados;
  ShowMessageToast(self, 'Produto Incluido!', 3);
  if Assigned(FrmResumo) then
    FrmResumo.ListarProduto;
  Close;
  rTelaPreta.Visible := False;
end;


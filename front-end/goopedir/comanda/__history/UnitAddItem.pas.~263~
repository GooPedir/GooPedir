function TFrmAddItem.ValidaSePodeAdicionar: Boolean;
var
  Extra: TframeExtra;
  I: Integer;
begin
  Result := true;
  for I := 0 to vertProdutos.ComponentCount - 1 do
  begin
    if vertProdutos.Components[I] is TframeExtra then
    begin
      Extra := (vertProdutos.Components[I] as TframeExtra);

      if Extra.Tipo = Pizza then
      begin
        if Extra.Pai.Minimo > 0 then
          if (Extra.Pai.Minimo > Extra.Pai.Selecionado) then
          begin
            ValorFaltando := 'Deve-se selecionar ' + Extra.Pai.Minimo.ToString +
              ' sabores!';
            Result := False;
            Abort;
          end;

      end
      else
      begin
        if Extra.Pai.Minimo > 0 then
          if (Extra.Pai.Minimo > Extra.Pai.Selecionado) then
          begin
            ValorFaltando := 'Deve-se selecionar no minimo ' +
              Extra.Pai.Minimo.ToString + ' do extra ' +
              Extra.Pai.descricao + '!';
            Result := False;
            Abort;
          end;

      end;

    end;

  end;
end;


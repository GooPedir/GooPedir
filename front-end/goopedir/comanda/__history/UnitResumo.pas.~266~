function TFrmResumo.ValidaCampo: Boolean;
begin
  Result := False;

  if length(EdtCelular.Text) < 10 then
  begin
    ShowMessageToast(Self, 'Celular não informado!', 1);
    EdtCelular.SetFocus;
    exit;
  end;

  if length(EdtNome.Text) < 3 then
  begin
    ShowMessageToast(Self, 'Nome não informado!', 1);
    EdtNome.SetFocus;
    exit;
  end;

  if cTipo.ItemIndex = 0 then
  begin
    if length(EdtRua.Text) = 0 then
    begin
      ShowMessageToast(Self, 'Rua não informado!', 1);
      EdtRua.SetFocus;
      exit;
    end;

    if length(EdtNumero.Text) = 0 then
    begin
      ShowMessageToast(Self, 'Número não informado!', 1);
      EdtNumero.SetFocus;
      exit;
    end;

    if length(EdtBairro.Text) = 0 then
    begin
      ShowMessageToast(Self, 'Bairro não informado!', 1);
      EdtBairro.SetFocus;
      exit;
    end;

    if length(EdtCidade.Text) = 0 then
    begin
      ShowMessageToast(Self, 'Cidade não informado!', 1);
      EdtCidade.SetFocus;
      exit;
    end;

    if length(EdtEstado.Text) = 0 then
    begin
      ShowMessageToast(Self, 'Estado não informado!', 1);
      EdtEstado.SetFocus;
      exit;
    end;

  end;
  if ValorTotal = 0 then
  begin
    ShowMessageToast(Self, 'Pedido com valor Zerado!!', 1);
    exit;
  end;
  Result := True;
end;


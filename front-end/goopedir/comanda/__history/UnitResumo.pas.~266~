function TFrmResumo.ApenasNumerosValidos(Valor: String): String;
var
  vText: PChar;
begin
  vText := PChar(Valor);
  Result := '';

  while (vText^ <> #0) do
  begin

    if vText^ in ['0' .. '9'] then
      Result := Result + vText^;
    if vText^ = ',' then
      Result := Result + vText^;

    Inc(vText);
  end;
end;


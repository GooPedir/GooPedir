function TFrmResumo.calcularDiferencaHoras(Dataf, datai: Tdate;
HoraF, HoraI: ttime): TDateTime;
var
  DataHoraF, DataHoraI: TDateTime;
begin
  DataHoraF := Dataf + HoraF;
  DataHoraI := datai + HoraI;
  if DataHoraI > DataHoraF then
    Result := DataHoraI - DataHoraF
  else
    Result := DataHoraF - DataHoraI;
end;

procedure TFrmResumo.CalcularTotal;
begin

  ValorTotal := (ValorProduto + ValorEntrega + ValorAcrescimo) - ValorDesconto;
end;

procedure TFrmResumo.CalculaTempo;
var
  Dias: Integer;
  Total, Horas: Real;
  QuerEmHorasMinutosSegundos: string;
  H, M, S, SS: Word;
  DT_INI: Tdate;
  HR_INI: ttime;
  DT_FIM: Tdate;
  HR_FIM: ttime;
begin
  DT_FIM := Date;
  HR_FIM := Time;
  DT_INI := edtData.Date;;
  HR_INI := edtHora.Time;
  Total := calcularDiferencaHoras(DT_FIM, DT_INI, HR_FIM, HR_INI);
  Dias := Trunc(Total);
  Horas := Total - Trunc(Total);
  Decodetime(Horas, H, M, S, SS);
  H := H + 24 * Trunc(Dias);

  if H > 0 then
    QuerEmHorasMinutosSegundos := FormatFloat('#00h ', H);

  if M > 0 then
    QuerEmHorasMinutosSegundos := QuerEmHorasMinutosSegundos +
      FormatFloat('00m ', M);

  QuerEmHorasMinutosSegundos := QuerEmHorasMinutosSegundos +
    FormatFloat('00s', S);

  EdtTempo.Text := QuerEmHorasMinutosSegundos;
end;


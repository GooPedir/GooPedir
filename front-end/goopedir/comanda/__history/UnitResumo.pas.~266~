  frmSimNao.Nao := ReImprimir;
  frmSimNao.Show;

end;

procedure TFrmResumo.PegaDadosCliente;
begin
  EdtNome.Text := '';
  EdtRua.Text := '';
  EdtNumero.Text := '';
  EdtBairro.Text := '';
  EdtCidade.Text := '';
  EdtEstado.Text := '';
  edtComplemento.Text := '';
  if mConsultaCliente.RecordCount > 0 then
  begin
    CodigoCliente := mConsultaCliente.FieldByName('codigo').AsInteger;
    CodigoClienteEndereco := mConsultaCliente.FieldByName('codigo1').AsInteger;
    EdtNome.Text := mConsultaCliente.FieldByName('nome').AsString;

    // EdtCelular.Text := mConsultaCliente.FieldByName('celular_wpp').AsString;
    EdtBairro.Text := mConsultaCliente.FieldByName('bairro').AsString;
    EdtRua.Text := mConsultaCliente.FieldByName('rua').AsString;
    EdtNumero.Text := mConsultaCliente.FieldByName('numero').AsString;
    EdtCidade.Text := mConsultaCliente.FieldByName('cidade').AsString;
    EdtEstado.Text := mConsultaCliente.FieldByName('estado').AsString;
    edtComplemento.Text := mConsultaCliente.FieldByName('complemento').AsString;
    ValorEntrega := mConsultaCliente.FieldByName('valor_taxa').AsFloat;
    ValorEntregaAnterior := mConsultaCliente.FieldByName('valor_taxa').AsFloat;
    EdtNome.TextPrompt := '';
  end
  else
  begin
    CodigoCliente := 0;
    CodigoClienteEndereco := 0;
    EdtNome.TextPrompt := 'Nenhum cliente localizado!';

  end;
  mConsultaCliente.Close;
end;


procedure TFrmResumo.AddProdutoResumo(id_produto, qtd: Integer;
  descricao, descricaoitem: string; preco: double);
begin
  with lv_produto.Items.Add do
  begin
    Tag := id_produto;
    TListItemText(Objects.FindDrawable('TxtDescricao')).Text :=
      FormatFloat('00', qtd) + ' - ' + descricao;
    TListItemText(Objects.FindDrawable('txtDescricaoItem')).Text :=
      descricaoitem;
    TListItemText(Objects.FindDrawable('TxtPreco')).Text :=
      FormatFloat('R$ #,##0.00', preco);
    // TListItemImage(Objects.FindDrawable('ImgDelete')).bitmap :=
    // img_delete.bitmap;
  end;
end;

procedure TFrmResumo.ListarProduto;
var
  x: Integer;

  descricao: String;
  Tipo: Integer;
  Codigo: Integer;
  Total: Real;

  FrameItens: TframeDadosItens;
  I: Integer;
begin
  try
    if not Iniciou then
    begin

      for I := 0 to DadosPedidos.ComponentCount - 1 do
      begin
        if (DadosPedidos.Components[I]) is TframeDadosItens then
        begin
          (DadosPedidos.Components[I] as TframeDadosItens).Visible := False;
        end;

      end;

      BDSPRODS.DataSet := Nil;
      lv_produto.Items.Clear;

      if CodigoPedido > 0 then
      begin
        Codigo := CodigoPedido;
        Tipo := 2;
      end
      else
      begin
        Codigo := mesa;
        Tipo := 1;
      end;

      GetSimples('v1/produtos/pedido/' + Tipo.ToString + '/' + Codigo.ToString,
        Produtos);
      GetSimples('v1/produtos/pedido/' + Tipo.ToString + '/' + Codigo.ToString,
        ProdCompleto);
      Total := 0;
      while not Produtos.Eof do
      begin
        descricao := '';
        DadoIten.Close;
        GetSimples('v1/produtos/pedido/itens/' + Produtos.FieldByName('codigo')
          .AsString, DadoIten);

        while not DadoIten.Eof do
        begin
          descricao := descricao + DadoIten.FieldByName('dados').AsString;

          DadoIten.Next;
        end;
        ProdCompleto.Edit;
        ProdCompleto.FieldByName('dados').AsString := descricao;
        ProdCompleto.Post;
        AddProdutoResumo(Produtos.FieldByName('codigo').AsInteger,
          Produtos.FieldByName('quantidade').AsInteger,
          Produtos.FieldByName('nome_produto').AsString, descricao,
          Produtos.FieldByName('valor_total').AsFloat);

        Total := Total + Produtos.FieldByName('valor_total').AsFloat;
        ProdCompleto.Next;
        Produtos.Next;
      end;
      ValorProduto := Total;

      if ProdCompleto.RecordCount > 0 then
      begin
        ProdCompleto.First;
        while not ProdCompleto.Eof do
        begin
          if Assigned(DadosPedidos.FindComponent('FRAME_ITEN_' +
            ProdCompleto.FieldByName('codigo').AsString)) then
          begin
            FrameItens := DadosPedidos.FindComponent
              ('FRAME_ITEN_' + ProdCompleto.FieldByName('codigo').AsString)
              as TframeDadosItens;
          end
          else
          begin
            FrameItens := TframeDadosItens.Create(DadosPedidos);
            FrameItens.Parent := DadosPedidos;
            FrameItens.Codigo := ProdCompleto.FieldByName('codigo').AsInteger;
            FrameItens.Name := 'FRAME_ITEN_' + ProdCompleto.FieldByName
              ('codigo').AsString;
          end;
          FrameItens.Nome := ProdCompleto.FieldByName('nome_produto').AsString;
          FrameItens.descricao := ProdCompleto.FieldByName('dados').AsString;
          FrameItens.Quantidade := ProdCompleto.FieldByName('quantidade')
            .AsInteger;
          FrameItens.Valor := ProdCompleto.FieldByName('valor_total').AsFloat;
          FrameItens.Visible := True;
          FrameItens.Align := TAlignLayout.Top;
          FrameItens.Sim := FuncaoExcluir;
          FrameItens.FormResumo := Self;
          FrameItens.mesa := mesa;
          FrameItens.CodigoPedido := CodigoPedido;

          ProdCompleto.Next;
        end;
      end;

      BDSPRODS.DataSet := ProdCompleto;

      rFundoPreto.Visible := False;
      rFundoPreto1.Visible := False;
      Iniciou := False;
    end;
  except
    Iniciou := False;
  end;









  // TLoading.Show(self, 'Aguarde..');

  {
    TThread.CreateAnonymousThread(
    procedure
    begin
    GetSimples('v1/produtos/pedido/' + mesa.ToString, Produtos);

    while not Produtos.Eof do
    begin
    descricao := '';
    DadoIten.Close;
    GetSimples('v1/produtos/pedido/itens/' + Produtos.FieldByName('codigo')
    .AsString, DadoIten);

    while not DadoIten.Eof do
    begin
    descricao := descricao + DadoIten.FieldByName('dados').AsString;
    DadoIten.Next;
    end;
    AddProdutoResumo(Produtos.FieldByName('codigo').AsInteger,
    Produtos.FieldByName('quantidade').AsInteger,
    Produtos.FieldByName('nome_produto').AsString, descricao,
    Produtos.FieldByName('valor_total').AsFloat);

    Produtos.Next;
    end;
    TThread.Synchronize(nil,
    procedure
    begin
    TLoading.Hide;
    end);

    end).start; }
  // Buscar dados no server...
  // for x := 1 to 10 do
  // AddProdutoResumo(x, 01, 'Produto ' + x.ToString, x);

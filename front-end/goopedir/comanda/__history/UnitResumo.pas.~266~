procedure TFrmResumo.Setmesa(const Value: Integer);

begin
  lCodigoInterno.Text := '';
  layMesa.Visible := True;
  rDadosPedido.Visible := False;

  Fmesa := Value;
  if Value > 0 then
  begin
    lFaturado.Visible := False;
    lApenasVisualizacao.Visible := False;
    if Assigned(Dados) then
    begin
      Dados.Free;
    end;
    FrmResumo.MESAS.Close;
    GetSimples('v1/mesa/' + FrmResumo.mesa.ToString, FrmResumo.MESAS);
    if FrmResumo.MESAS.RecordCount > 0 then
    begin
      FrmResumo.lTipo.Text := FrmResumo.MESAS.FieldByName('descricao').AsString;
      FrmResumo.lbl_comanda.Text := FrmResumo.MESAS.FieldByName
        ('nr_mesa').AsString;
      FrmResumo.lTotal.Text := FormatFloat('R$ #,##0.00',
        FrmResumo.MESAS.FieldByName('tot_mesa').AsFloat);
    end;
    // FrmResumo.ListarProduto;
    // Dados.Start;
    // Fazer uma thread anonima
    CarregaDados;
  end
  else
  begin
    layMesa.Visible := False;
  end;
  rTotalMesa.Visible := layMesa.Visible;
  img_transferencia.Visible := layMesa.Visible;
  // img_fatura.Visible := layMesa.Visible;
  // img_imprimir.Visible := layMesa.Visible;
  rDadosMesa.Visible := layMesa.Visible;
end;


procedure TFrmResumo.SalvarDadosPedido;
begin
  if ValorProduto = 0 then
    exit;

  memDadosPedido.Close;
  memDadosPedido.Open;
  memDadosPedido.Insert;
  memDadosPedido.FieldByName('codigo').AsInteger := CodigoPedido;
  memDadosPedido.FieldByName('data').AsDateTime := edtData.Date;
  memDadosPedido.FieldByName('hora').AsDateTime := edtHora.Time;
  memDadosPedido.FieldByName('produto').AsFloat := ValorProduto;
  memDadosPedido.FieldByName('acrecimo').AsFloat := ValorAcrescimo;
  memDadosPedido.FieldByName('entrega').AsFloat := ValorEntrega;
  memDadosPedido.FieldByName('desconto').AsFloat := ValorDesconto;
  memDadosPedido.FieldByName('total').AsFloat := ValorTotal;
  memDadosPedido.FieldByName('troco').AsFloat := ValorTroco;
  memDadosPedido.FieldByName('cliente').AsInteger := CodigoCliente;
  memDadosPedido.FieldByName('celular').AsString := EdtCelular.Text;
  memDadosPedido.FieldByName('nome').AsString := EdtNome.Text;
  memDadosPedido.FieldByName('rua').AsString := EdtRua.Text;
  memDadosPedido.FieldByName('bairro').AsString := EdtBairro.Text;
  memDadosPedido.FieldByName('cidade').AsString := EdtCidade.Text;
  memDadosPedido.FieldByName('estado').AsString := EdtEstado.Text;
  memDadosPedido.FieldByName('complemento').AsString := edtComplemento.Text;
  memDadosPedido.FieldByName('numero').AsString := EdtNumero.Text;
  memDadosPedido.FieldByName('endereco').AsInteger := CodigoClienteEndereco;
  memDadosPedido.FieldByName('status').AsInteger := StatusPedido;
  memDadosPedido.FieldByName('tipo_pagamento').AsInteger :=
    Pagamento.FieldByName('codigo').AsInteger;
  if StatusPedido < 0 then
    memDadosPedido.FieldByName('status').AsInteger := 1;

  case cTipo.ItemIndex of
    0:
      begin
        if not(memDadosPedido.FieldByName('endereco').AsInteger > 0) then
        begin
          memDadosPedido.FieldByName('endereco').AsInteger := 0;
        end;

      end;
    1:
      begin
        memDadosPedido.FieldByName('endereco').AsInteger := -1;
      end;
  end;

  // if cTipo.ItemIndex = 0 then
  // memDadosPedido.FieldByName('endereco').AsInteger := -1
  // else
  // begin
  // if memDadosPedido.FieldByName('endereco').AsInteger = 0 then
  // begin
  // memDadosPedido.FieldByName('endereco').AsInteger := -1;
  // end;
  // end;

  memDadosPedido.Post;

  PostSimples('/v1/atualiza/dados/pedido/', memDadosPedido);
  if StatusPedido < 0 then
    PostSimples('/v1/imprimir/1/' + CodigoPedido.ToString, nil);
end;


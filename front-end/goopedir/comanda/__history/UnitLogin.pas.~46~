procedure TFrmLogin.GravaIni(Secao, Indice, Valor: String);
var
  ArquivoINI: TIniFile;
begin
  ArquivoINI := TIniFile.Create(lArquivo);
  ArquivoINI.WriteString(Secao, Indice, Valor);
  ArquivoINI.Free;
end;

procedure TFrmLogin.img_fecharupdateClick(Sender: TObject);
begin
  rect_update.Visible := false;
end;

procedure TFrmLogin.lbl_configClick(Sender: TObject);
begin

  TThread.CreateAnonymousThread(
    procedure
    begin
      IPS.Close;
      RequisicaoIP.MemTable := IPS;
      RequisicaoIP.Execute;

      if IPS.RecordCount > 0 then
      begin

        while not IPS.Eof do
        begin

          URL := 'http://' + IPS.FieldByName('IP').AsString + ':2121/';
          try
            if TestaConexao then
            begin
              edtHost.Text := IPS.FieldByName('IP').AsString;
            end;
          except

          end;

          IPS.Next;
        end;
      end;
      TThread.Synchronize(TThread.CurrentThread,
        procedure
        begin
          TabControl.GotoVisibleTab(1, TTabTransition.Slide);
          lbl_titulo.Text := 'Configurações';
        end);
    end).Start;

end;

function TFrmLogin.LerIni(Secao, Indice, ValorPadrao: String): String;
var
  ArquivoINI: TIniFile;
begin
  ArquivoINI := TIniFile.Create(lArquivo);
  Result := ArquivoINI.ReadString(Secao, Indice, ValorPadrao);
  ArquivoINI.Free;
end;

procedure TFrmLogin.OnFinishUpdate(Sender: TObject);
begin
  if Assigned(TThread(Sender).FatalException) then
  begin
    showmessage(exception(TThread(Sender).FatalException).Message);
    exit;
  end;

  if VersaoAtualizacao > versaoApp then
  begin
    // Exibe o painel de update...
    rect_update.Visible := true;
    img_seta.Position.Y := 0;
    img_seta.Opacity := 0;
    lbl_titulo.Opacity := 0;
    lbl_texto.Opacity := 0;
    rect_botao.Opacity := 0;

    rect_update.BringToFront;
    rect_update.AnimateFloat('Margins.Top', 0, 0.8, TAnimationType.InOut,
      TInterpolationType.Circular);

    img_seta.AnimateFloatDelay('Position.Y', 50, 0.5, 1, TAnimationType.Out,
      TInterpolationType.Back);
    img_seta.AnimateFloatDelay('Opacity', 1, 0.4, 0.9);

    lbl_titulo.AnimateFloatDelay('Opacity', 1, 0.7, 1.3);
    lbl_texto.AnimateFloatDelay('Opacity', 1, 0.7, 1.6);
    rect_botao.AnimateFloatDelay('Opacity', 1, 0.7, 1.9);
  end;
end;

procedure TFrmLogin.rect_loginClick(Sender: TObject);
begin
  URL := 'http://' + GetHost + ':2121/';
  if not TestaConexao then
  begin
    ShowMessageToast(self, 'Sem Conexão!', 1);
    exit;
  end;

  if (length(Usuario) = 0) or (length(Usuario) = 0) then
  begin
    ShowMessageToast(self, 'Usuário invalido!', 1);
    exit;
  end;

  dm.GetSimples2('/v1/usuario/' + Usuario + '/' + Senha, dm.Usuario);

  if dm.Usuario.RecordCount = 0 then
  begin
    ShowMessageToast(self, 'Usuário/Senha Invalido!', 1);
    exit;
  end;

  if dm.Usuario.FieldByName('app').AsInteger = 0 then
  begin
    ShowMessageToast(self, 'Usuário não tem permissão!', 1);
    exit;
  end;
  dm.CodigoCaixa;
  if NOT Assigned(FrmPrincipal) then
    Application.CreateForm(TFrmPrincipal, FrmPrincipal);

  FrmPrincipal.Show;
  Application.MainForm := FrmPrincipal;
  FrmLogin.Close;

end;

procedure TFrmLogin.rect_motoboyClick(Sender: TObject);
begin
  if not dm.LoginMotoboy then
  begin
    ShowMessageToast(self, 'Acesso negado!', 1);
    exit;
  end;

  if NOT Assigned(frmPrincipalMotoboy) then
    Application.CreateForm(TfrmPrincipalMotoboy, frmPrincipalMotoboy);
  // frmPrincipalMotoboy.Celular := dm.GetCelular;

  frmPrincipalMotoboy.Show;
  Application.MainForm := frmPrincipalMotoboy;
  FrmLogin.Close;
end;

procedure TFrmLogin.rect_save_configClick(Sender: TObject);
begin
  lbl_titulo.Text := Usuario;

  if length(edtHost.Text) = 0 then
  begin
    if length(edtCelular.Text) <> 0 then
    begin

      Celular := edtCelular.Text;
      Validacao;
      TabControl.GotoVisibleTab(0, TTabTransition.Slide);
    end;
    exit;
  end;

  URL := 'http://' + edtHost.Text + ':2121/';
  if TestaConexao then
  begin
    ShowMessageToast(self, 'Conexão Estabelecida Com Sucesso!', 3);

    if WIN then
    begin
      Host := edtHost.Text;
      dm.Free;
      Close;
      exit;
    end;
    Celular := edtCelular.Text;
    Host := edtHost.Text;
    Senha := edtSenha.Text;
    Usuario := edtUsuario.Text;
    Validacao;
    TabControl.GotoVisibleTab(0, TTabTransition.Slide);
  end
  else
  begin
    ShowMessageToast(self, 'Sem Conexão Com O Servidor!', 1);
  end;

end;


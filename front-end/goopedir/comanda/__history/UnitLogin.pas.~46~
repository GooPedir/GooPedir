procedure TFrmLogin.FormActivate(Sender: TObject);
var
  t: TThread;
begin
  exit;
  t := TThread.CreateAnonymousThread(
    procedure
    var
      JsonObj: TJSONObject;
    begin
      // sleep(2000);

      // Tenta consumir servico...
      // try
      //
      // BaseURL := 'http://' + GetHost + ':2121/';
      // dm.CONEXAO_LOCAL.url := 'v1/versao/app';
      // dm.CONEXAO_LOCAL.Metodo := mGet;
      // dm.CONEXAO_LOCAL.Execute;
      // except
      // on ex: exception do
      // begin
      // // raise exception.Create('Erro ao acessar o servidor: ' + ex.Message);
      // exit;
      // end;
      // end;

      // Trata retorno em JSON...
      try
        JsonObj := TJSONObject.ParseJSONValue(TEncoding.ASCII.GetBytes
          (dm.GetRetornoString('v1/versao/app')), 0) as TJSONObject;
        VersaoAtualizacao := TJSONObject(JsonObj).GetValue('versao_app').Value;
        VersaoServidor := TJSONObject(JsonObj)
          .GetValue('versao_servidor').Value;
        VersaoMinima := TJSONObject(JsonObj).GetValue('versao_minima').Value;

        img_fecharupdate.Visible := versaoApp >= VersaoMinima;
        if VersaoMinima <> VersaoAtualizacao then
          lVersaoNova.Text := 'Versão disponível ' + VersaoAtualizacao +
            'v Versão mínima ' + VersaoMinima + 'v'
        else
          lVersaoNova.Text := 'Versão disponível ' + VersaoAtualizacao + 'v';

      finally
        JsonObj.DisposeOf;
      end;

    end);

  t.OnTerminate := OnFinishUpdate;
  t.Start;
{$IFDEF ANDROID}
  t.Start;
{$ENDIF}
end;


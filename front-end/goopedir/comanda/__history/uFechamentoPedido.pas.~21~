unit uFechamentoPedido;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Param,
  FireDAC.Stan.Error, FireDAC.DatS, FireDAC.Phys.Intf, FireDAC.DApt.Intf,
  Data.DB, FireDAC.Comp.DataSet, FireDAC.Comp.Client, uMemTable, FMX.Objects,
  FMX.Layouts, FMX.Controls.Presentation, FMX.StdCtrls, FMX.ListBox,
  Data.Bind.Components, Data.Bind.DBScope, System.Rtti, System.Bindings.Outputs,
  FMX.Bind.Editors, Data.Bind.EngExt, FMX.Bind.DBEngExt, FMX.Edit, uButton,
  FMX.Grid.Style, FMX.Bind.Grid, Data.Bind.Grid, FMX.ScrollBox, FMX.Grid;

type
  TCallback = procedure of object;

  TfrmFechamentoPedido = class(TForm)
    Layout1: TLayout;
    PAG: iMemTable;
    PAGID: TIntegerField;
    PAGID_TIPO_PAGAMENTO: TIntegerField;
    PAGDESCRICAO_TIPO_PAG: TStringField;
    PAGVALOR: TFloatField;
    rect_login: TRectangle;
    Label3: TLabel;
    Rectangle1: TRectangle;
    Layout2: TLayout;
    Rectangle2: TRectangle;
    ComboBox1: TComboBox;
    bdsPAGAMENTO: TBindSourceDB;
    PAGAMENTO: iMemTable;
    PAGAMENTOcodigo: TIntegerField;
    PAGAMENTOdescricao: TStringField;
    BindingsList1: TBindingsList;
    LinkListControlToField1: TLinkListControlToField;
    edtValor: TEdit;
    btnSim: iButton;
    PRODUTOS: iMemTable;
    PRODUTOScodigo: TIntegerField;
    PRODUTOSnome_produto: TStringField;
    PRODUTOSquantidade: TIntegerField;
    PRODUTOSvalor_total: TFloatField;
    PRODUTOSobs: TStringField;
    BDSPRODUTOS: TBindSourceDB;
    Lista: TStringGrid;
    LinkGridToDataSourceBDSPRODUTOS: TLinkGridToDataSource;
    PRODUTOSselecionado: TIntegerField;
    lValorSelecionado: TLabel;
    Layout3: TLayout;
    Label1: TLabel;
    Layout4: TLayout;
    Label2: TLabel;
    Layout5: TLayout;
    Label4: TLabel;
    edtTotal: TEdit;
    EdtPago: TEdit;
    EdtDiferenca: TEdit;
    btnFinalizar: iButton;
    StringGrid1: TStringGrid;
    BDSPAG: TBindSourceDB;
    LinkGridToDataSourceBDSPAG: TLinkGridToDataSource;
    edtDividir: TEdit;
    Label5: TLabel;
    iButton1: iButton;
    Image1: TImage;
    PAGTRANSACAO_MP: TStringField;
    procedure FormCreate(Sender: TObject);
    procedure ListaCellDblClick(const Column: TColumn; const Row: Integer);
    procedure ListaDrawColumnCell(Sender: TObject; const Canvas: TCanvas;
      const Column: TColumn; const Bounds: TRectF; const Row: Integer;
      const Value: TValue; const State: TGridDrawStates);
    procedure btnSimClick(Sender: TObject);
    procedure edtDividirExit(Sender: TObject);
    procedure iButton1Click(Sender: TObject);
    procedure btnFinalizarClick(Sender: TObject);
    procedure Image1Click(Sender: TObject);
    procedure edtValorKeyDown(Sender: TObject; var Key: Word; var KeyChar: Char;
      Shift: TShiftState);
    procedure FormShow(Sender: TObject);
  private
    FCodigoPedido: Integer;
    FSomaSelecionado: Real;
    FValor: Real;
    FPago: Real;
    FCodigo: Integer;
    procedure SetCodigoPedido(const Value: Integer);
    procedure SetSomaSelecionado(const Value: Real);
    procedure SetValor(const Value: Real);
    procedure SetPago(const Value: Real);
    { Private declarations }
    //
    property SomaSelecionado: Real read FSomaSelecionado
      write SetSomaSelecionado;
    function GerarCodigo: Integer;
    procedure SomarPagamento;

    procedure Concluir;
    procedure AdicionarPagamento;
  public
    { Public declarations }
    Executar: TCallback;
    Cancelar: TCallback;
    DescricaoMesa: String;
    property Valor: Real read FValor write SetValor;
    property CodigoPedido: Integer read FCodigoPedido write SetCodigoPedido;
    property Pago: Real read FPago write SetPago;

  end;

var
  frmFechamentoPedido: TfrmFechamentoPedido;

implementation

{$R *.fmx}

uses Funcoes, FMXTee.Canvas, uSimNao, uDM, ufrmPIXMP;

procedure TfrmFechamentoPedido.AdicionarPagamento;
begin
  try
    if edtValor.Text.ToDouble > 0 then
    begin
      if (DM.IntegracaoPIX) and (UpperCase(PAGAMENTO.FieldByName('descricao').AsString)='PIX') then
      begin
      PAG.DisableControls;
      PAG.Insert;
      PAG.FieldByName('ID').AsInteger := GerarCodigo;
      PAG.FieldByName('ID_TIPO_PAGAMENTO').AsInteger :=
        PAGAMENTO.FieldByName('codigo').AsInteger;
      PAG.FieldByName('DESCRICAO_TIPO_PAG').AsString :=
        PAGAMENTO.FieldByName('descricao').AsString;
      PAG.FieldByName('VALOR').AsFloat := PAG.FieldByName('VALOR').AsFloat +
        edtValor.Text.ToDouble;

      frmPIXMP := TfrmPIXMP.Create(self);


      frmPIXMP.Pedido := CodigoPedido;
      frmPIXMP.Valor := StrToFloat(edtValor.Text);
      frmPIXMP.PAGAMENTO := PAG;
      frmPIXMP.Load;
      frmPIXMP.ShowModal;
      PAG.EnableControls;


      end
      else
      begin
        if PAG.Locate('ID_TIPO_PAGAMENTO', PAGAMENTO.FieldByName('codigo')
          .AsInteger) then
        begin
          PAG.Edit;
        end
        else
        begin
          PAG.Insert;
        end;
      end;

      PAG.FieldByName('ID').AsInteger := GerarCodigo;
      PAG.FieldByName('ID_TIPO_PAGAMENTO').AsInteger :=
        PAGAMENTO.FieldByName('codigo').AsInteger;
      PAG.FieldByName('DESCRICAO_TIPO_PAG').AsString :=
        PAGAMENTO.FieldByName('descricao').AsString;
      PAG.FieldByName('VALOR').AsFloat := PAG.FieldByName('VALOR').AsFloat +
        edtValor.Text.ToDouble;
      PAG.Post;
      edtValor.Text := '0';
      edtValor.SetFocus;
      SomarPagamento;
      ShowMessageToast(self, 'Pagamento Adicionado!', 2);
    end
    else
    begin
      ShowMessageToast(self, 'Valor Incorreto!', 1);
    end;
  except
    ShowMessageToast(self, 'Valor Incorreto!', 1);
    edtValor.SetFocus;
  end;
end;

procedure TfrmFechamentoPedido.btnFinalizarClick(Sender: TObject);
begin

  if Trunc(Valor) > Trunc(Pago) then
  begin
    ShowMessageToast(self, 'Valor pago inferior ao valor!', 1);
    exit;
  end;

  frmSimNao.titulo := 'Finalizar';
  frmSimNao.descricao := 'Deseja finalizar?';
  frmSimNao.Sim := Concluir;
  frmSimNao.Show;

end;

procedure TfrmFechamentoPedido.btnSimClick(Sender: TObject);
begin

  AdicionarPagamento;
end;

procedure TfrmFechamentoPedido.Concluir;
begin

  Executar;
  Close;
end;

procedure TfrmFechamentoPedido.edtDividirExit(Sender: TObject);
begin
  try
    case StrToInt((Sender as TEdit).Text) of
      0:
        begin
          (Sender as TEdit).Text := '1';
        end;
    end;

    SomaSelecionado := SomaSelecionado;
  except
    (Sender as TEdit).SetFocus;
  end;
end;

procedure TfrmFechamentoPedido.edtValorKeyDown(Sender: TObject; var Key: Word;
  var KeyChar: Char; Shift: TShiftState);
begin
  if Key = vkReturn then
  begin
    AdicionarPagamento;

  end;
end;

procedure TfrmFechamentoPedido.FormCreate(Sender: TObject);
begin
  getsimples('v1/tipo/pagamento/', PAGAMENTO);
  SomaSelecionado := 0;
  FCodigo := 0;
  PAG.Open;

end;

procedure TfrmFechamentoPedido.FormShow(Sender: TObject);
begin
  btnSim.SetFocus;
end;

function TfrmFechamentoPedido.GerarCodigo: Integer;
begin
  Result := FCodigo + 1;
end;

procedure TfrmFechamentoPedido.iButton1Click(Sender: TObject);
begin
  if PAG.RecordCount = 0 then
    exit;

  PAG.Delete;
  SomarPagamento;
end;

procedure TfrmFechamentoPedido.Image1Click(Sender: TObject);
begin
  Cancelar;
end;

procedure TfrmFechamentoPedido.ListaCellDblClick(const Column: TColumn;
  const Row: Integer);
var
  Valor: Integer;
begin
  if SomaSelecionado = Valor then
    Valor := 0;

  if PRODUTOS.FieldByName(PRODUTOS.Fields[5].FieldName).IsNull then
  begin
    Valor := 1;
    SomaSelecionado := SomaSelecionado + PRODUTOS.FieldByName
      (PRODUTOS.Fields[3].FieldName).AsFloat;
  end
  else
  begin
    case PRODUTOS.FieldByName(PRODUTOS.Fields[5].FieldName).AsInteger of
      0:
        begin
          Valor := 1;
          SomaSelecionado := SomaSelecionado + PRODUTOS.FieldByName
            (PRODUTOS.Fields[3].FieldName).AsFloat;
        end
    else
      begin
        Valor := 0;
        SomaSelecionado := SomaSelecionado - PRODUTOS.FieldByName
          (PRODUTOS.Fields[3].FieldName).AsFloat;
      end;
    end;

  end;
  PRODUTOS.Edit;
  PRODUTOS.FieldByName(PRODUTOS.Fields[5].FieldName).AsInteger := Valor;
  PRODUTOS.Post;
end;

procedure TfrmFechamentoPedido.ListaDrawColumnCell(Sender: TObject;
  const Canvas: TCanvas; const Column: TColumn; const Bounds: TRectF;
  const Row: Integer; const Value: TValue; const State: TGridDrawStates);
var
  Cor: TColor;
begin
  case Column.Index of
    0:
      begin
        if Value.ToString = '1' then
        begin
          Cor := RGB(165, 218, 232);
        end
        else
        begin
          Cor := RGB(255, 255, 255);
        end;
        Canvas.Fill.Color := Cor;
        Canvas.Stroke.Color := Cor;
        Canvas.FillRect(Bounds, 0, 0, [], 1);
        Canvas.Fill.Color := Cor;
        Canvas.FillText(Bounds, Value.ToString, False, 1,
          [ { TFillTextFlag.RightToLef } ], TTextAlign.Center,
          TTextAlign.Center);
      end;
  end;
end;

procedure TfrmFechamentoPedido.SetCodigoPedido(const Value: Integer);
begin
  FCodigoPedido := Value;
  getsimples('/v1/pedido/produtos/' + CodigoPedido.ToString, PRODUTOS)
end;

procedure TfrmFechamentoPedido.SetPago(const Value: Real);
begin
  FPago := Value;
  EdtPago.Text := FormatFloat('R$ ###,###,##0.00', FPago);
  EdtDiferenca.Text := FormatFloat('R$ ###,###,##0.00', FValor - FPago);
end;

procedure TfrmFechamentoPedido.SetSomaSelecionado(const Value: Real);
Var
  ValorTotal: Real;
begin
  FSomaSelecionado := Value;
  ValorTotal := 0;
  if Value > 0 then
  begin

    if edtDividir.Text.ToInteger = 1 then
    begin
      ValorTotal := Trunc(Value / edtDividir.Text.ToInteger);
      lValorSelecionado.Text := 'Valor R$ ' + FormatFloat('#0.00', ValorTotal);
    end
    else
    begin
      ValorTotal := Trunc(Value / edtDividir.Text.ToInteger);
      lValorSelecionado.Text := 'Valor R$ ' + FormatFloat('#0.00', Value) +
        ' / Cada R$ ' + FormatFloat('#0.00', ValorTotal);
    end;
  end
  else
  begin
    if edtDividir.Text.ToInteger = 1 then
    begin
      ValorTotal := Trunc(Valor / edtDividir.Text.ToInteger);
      lValorSelecionado.Text := 'Valor R$ ' + FormatFloat('#0.00', ValorTotal);
    end
    else
    begin
      ValorTotal := Trunc(Valor / edtDividir.Text.ToInteger);
      lValorSelecionado.Text := 'Valor R$ ' + FormatFloat('#0.00', Valor) +
        ' / Cada R$ ' + FormatFloat('#0.00', ValorTotal);
    end;
  end;

  edtValor.Text := FloatToStr(ValorTotal);
end;

procedure TfrmFechamentoPedido.SetValor(const Value: Real);
begin
  FValor := Value;
  FValor := Trunc(FValor);
  edtTotal.Text := FormatFloat('R$ ###,###,##0.00', Value);
  edtValor.Text := FloatToStr(FValor);
end;

procedure TfrmFechamentoPedido.SomarPagamento;
var
  lValor: Real;
begin
  PAG.DisableControls;
  PAG.First;
  lValor := 0;
  while not PAG.Eof do
  begin
    lValor := lValor + PAG.FieldByName('VALOR').AsFloat;
    PAG.Next;
  end;
  PAG.Last;
  Pago := lValor;

  PAG.EnableControls;
end;

end.

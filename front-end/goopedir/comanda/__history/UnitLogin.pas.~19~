unit UnitLogin;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.Edit,
  FMX.Layouts, FMX.Controls.Presentation, FMX.StdCtrls, FMX.Objects,
  FMX.TabControl, System.IOUtils, Inifiles, FMX.CodeReader;

type
  TFrmLogin = class(TForm)
    Rectangle1: TRectangle;
    lbl_titulo: TLabel;
    TabControl: TTabControl;
    TabLogin: TTabItem;
    Layout1: TLayout;
    rect_login: TRectangle;
    Label3: TLabel;
    lbl_config: TLabel;
    rect_motoboy: TRectangle;
    Label7: TLabel;
    TabConfig: TTabItem;
    Layout2: TLayout;
    Label4: TLabel;
    edtHost: TEdit;
    rect_save_config: TRectangle;
    Label5: TLabel;
    edtUsuario: TEdit;
    Label1: TLabel;
    Label6: TLabel;
    edtSenha: TEdit;
    Label2: TLabel;
    edtCelular: TEdit;
    rect_update: TRectangle;
    Layout3: TLayout;
    Layout4: TLayout;
    Image4: TImage;
    img_seta: TImage;
    Label8: TLabel;
    lbl_texto: TLabel;
    lVersaoNova: TLabel;
    img_fecharupdate: TImage;
    Layout5: TLayout;
    rect_botao: TRectangle;
    btn_update: TSpeedButton;
    procedure rect_loginClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure lbl_configClick(Sender: TObject);
    procedure rect_save_configClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    function GetHost: String;
    function GetUsuario: String;
    function GetSenha: String;
    function GetCelular: String;

    procedure GravaIni(Secao, Indice, Valor: String);
    function LerIni(Secao, Indice, ValorPadrao: String): String;
    procedure rect_motoboyClick(Sender: TObject);
    procedure btn_updateClick(Sender: TObject);
  private
    FCelular: String;
    procedure SetHost(const Value: String);
    procedure SetSenha(const Value: String);
    procedure SetUsuario(const Value: String);
    procedure SetCelular(const Value: String); { Private declarations }
  public
    { Public declarations }
    property Host: String read GetHost write SetHost;
    property Usuario: String read GetUsuario write SetUsuario;
    property Senha: String read GetSenha write SetSenha;
    property Celular: String read FCelular write SetCelular;
    function TestaConexao: Boolean;
    procedure Validacao;

  var
    WIN: Boolean;
  end;

var
  FrmLogin: TFrmLogin;
  lArquivo: String;
    versaoApp, VersaoAtualizacao, VersaoMinima, VersaoServidor: String;

implementation

{$R *.fmx}

uses UnitPrincipal, uDM, uRequisicao, Funcoes, uLoginWindows,
  uPrincipalMotoboy, uOpenViewUrl;

procedure TFrmLogin.btn_updateClick(Sender: TObject);
var
  url: string;
begin
{$IFDEF ANDROID}
  url := 'http://seu-servidor.com.br/app.apk';
{$ELSE}
  url := 'https://apps.apple.com/br/app/whatsapp-messenger/id310633997';
{$ENDIF}
  url := 'http://iforth.net/app/version/' + StringReplace(VersaoAtualizacao,
    '.', '', [rfReplaceAll]) + '.apk';

  // url := 'https://play.google.com/store/apps/details?id=com.embarcadero.icep';

  OpenURL(url, false);
end;

procedure TFrmLogin.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := TCloseAction.caFree;
  FrmLogin := nil;
end;

procedure TFrmLogin.FormCreate(Sender: TObject);
begin

{$IFDEF Android}
{$ELSE}
  if not Assigned(DM) then
    DM := TDM.Create(self);
{$ENDIF}
  lArquivo := TPath.Combine(TPath.GetDocumentsPath, 'conf.ini');
  TabControl.ActiveTab := TabLogin;
  edtHost.Text := Host;
  DM.CONEXAO.BaseURL := Host;
  lbl_titulo.Text := Usuario;

end;

function TFrmLogin.GetCelular: String;
begin
  Result := LerIni('USER', 'CELL', '');
end;

function TFrmLogin.GetHost: String;
begin
  Result := LerIni('HOST', 'HOST', '');
end;

function TFrmLogin.GetSenha: String;
begin
  Result := LerIni('USER', 'PASS', '');
end;

function TFrmLogin.GetUsuario: String;
begin
  Result := LerIni('USER', 'USER', '');
end;

procedure TFrmLogin.GravaIni(Secao, Indice, Valor: String);
var
  ArquivoINI: TIniFile;
begin
  ArquivoINI := TIniFile.Create(lArquivo);
  ArquivoINI.WriteString(Secao, Indice, Valor);
  ArquivoINI.Free;
end;

procedure TFrmLogin.lbl_configClick(Sender: TObject);
begin
  TabControl.GotoVisibleTab(1, TTabTransition.Slide);
  lbl_titulo.Text := 'Configurações';
end;

function TFrmLogin.LerIni(Secao, Indice, ValorPadrao: String): String;
var
  ArquivoINI: TIniFile;
begin
  ArquivoINI := TIniFile.Create(lArquivo);
  Result := ArquivoINI.ReadString(Secao, Indice, ValorPadrao);
  ArquivoINI.Free;
end;

procedure TFrmLogin.rect_loginClick(Sender: TObject);
begin
  DM.CONEXAO.BaseURL := 'http://' + GetHost + ':2121/';
  if not TestaConexao then
  begin
    ShowMessageToast(self, 'Sem Conexão!', 1);
    exit;
  end;

  if (length(Usuario) = 0) or (length(Usuario) = 0) then
  begin
    ShowMessageToast(self, 'Usuário invalido!', 1);
    exit;
  end;

  DM.CONEXAO.URL := '/v1/usuario/' + Usuario + '/' + Senha;
  DM.CONEXAO.Metodo := mGet;
  DM.CONEXAO.MemTable2 := DM.Usuario;
  DM.CONEXAO.Execute;

  if DM.Usuario.RecordCount = 0 then
  begin
    ShowMessageToast(self, 'Usuário/Senha Invalido!', 1);
    exit;
  end;

  if DM.Usuario.FieldByName('app').AsInteger = 0 then
  begin
    ShowMessageToast(self, 'Usuário não tem permissão!', 1);
    exit;
  end;
  DM.CodigoCaixa;
  if NOT Assigned(FrmPrincipal) then
    Application.CreateForm(TFrmPrincipal, FrmPrincipal);

  FrmPrincipal.Show;
  Application.MainForm := FrmPrincipal;
  FrmLogin.Close;

end;

procedure TFrmLogin.rect_motoboyClick(Sender: TObject);
begin
  if NOT Assigned(frmPrincipalMotoboy) then
    Application.CreateForm(TfrmPrincipalMotoboy, frmPrincipalMotoboy);
  frmPrincipalMotoboy.Celular := DM.GetCelular;

  frmPrincipalMotoboy.Show;
  Application.MainForm := frmPrincipalMotoboy;
  FrmLogin.Close;
end;

procedure TFrmLogin.rect_save_configClick(Sender: TObject);
begin
  lbl_titulo.Text := Usuario;

  if length(edtHost.Text) = 0 then
  begin
    if length(edtCelular.Text) <> 0 then
    begin

      Celular := edtCelular.Text;
      Validacao;
      TabControl.GotoVisibleTab(0, TTabTransition.Slide);
    end;
    exit;
  end;

  DM.CONEXAO.BaseURL := 'http://' + edtHost.Text + ':2121/';
  if TestaConexao then
  begin
    ShowMessageToast(self, 'Conexão Estabelecida Com Sucesso!', 3);

    if WIN then
    begin
      Host := edtHost.Text;
      DM.Free;
      Close;
      exit;
    end;
    Celular := edtCelular.Text;
    Host := edtHost.Text;
    Senha := edtSenha.Text;
    Usuario := edtUsuario.Text;
    Validacao;
    TabControl.GotoVisibleTab(0, TTabTransition.Slide);
  end
  else
  begin
    ShowMessageToast(self, 'Sem Conexão Com O Servidor!', 1);
  end;

end;

procedure TFrmLogin.SetCelular(const Value: String);
begin
  GravaIni('USER', 'CELL', Value);
end;

procedure TFrmLogin.SetHost(const Value: String);
begin

  GravaIni('HOST', 'HOST', Value);
end;

procedure TFrmLogin.SetSenha(const Value: String);
begin
  GravaIni('USER', 'PASS', Value);
end;

procedure TFrmLogin.SetUsuario(const Value: String);
begin
  GravaIni('USER', 'USER', Value);
end;

function TFrmLogin.TestaConexao: Boolean;
begin

  DM.CONEXAO.URL := 'v1/test/';
  DM.CONEXAO.Metodo := mGet;
  try
    DM.CONEXAO.Execute;
  except
    Result := False;
  end;

  Result := DM.CONEXAO.Status = 200;

end;

procedure TFrmLogin.Validacao;
begin
  rect_motoboy.Visible := length(Celular) > 0;
  rect_login.Visible := length(Host) > 0;
end;

end.

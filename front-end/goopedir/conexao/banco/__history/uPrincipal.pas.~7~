unit uPrincipal;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes,
  System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs,
  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async,
  FireDAC.Phys, FireDAC.Phys.MySQL, FireDAC.Phys.MySQLDef, FireDAC.FMXUI.Wait,
  Data.DB, FireDAC.Comp.Client, FMX.StdCtrls, FMX.Controls.Presentation,
  FMX.Edit, FMX.ListBox, FMX.Effects, FMX.Objects, FMX.Layouts;

type
  TForm1 = class(TForm)
    FDConnection1: TFDConnection;
    Layout1: TLayout;
    Rectangle1: TRectangle;
    Label1: TLabel;
    ShadowEffect1: TShadowEffect;
    Rectangle2: TRectangle;
    edtHost: TEdit;
    edtporta: TEdit;
    Rectangle3: TRectangle;
    Label2: TLabel;
    cBanco: TComboBox;
    procedure Rectangle3Click(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  Form1: TForm1;

implementation

{$R *.fmx}

uses uTestaConexao;

procedure TForm1.Rectangle3Click(Sender: TObject);
var
  Conexao: TConexaoTest;
  I: Integer;
begin
  Conexao := TConexaoTest.create;
  Conexao.host := edtHost.Text;
  try
    Conexao.Porta := edtporta.Text.ToInteger;
  except
    ShowMessage('Porta invalida!');
    edtporta.SetFocus;
    exit;
  end;
  if Conexao.TestarConexao then
  begin
    ShowMessage('Conectado');
    cBanco.Items.Clear;
    for I := 0 to length(Conexao.Bancos) - 1 do
    begin
      cBanco.Items.Add(Conexao.Bancos[I]);
    end;

  end
  else
    ShowMessage('Desconectado')

end;

end.
